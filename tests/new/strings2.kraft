str s = "  Hello, World  "
show([{up("abc")}])
show([{low("ABC")}])
show([{title("hello WORLD")}])
show([{s.trim()}])
show([{s.triml()}])
show([{s.trimr()}])
show([{s.trim(" h")}])
show({s.find("World")})
show({s.find("кот") is NONE})
show({"a,b,c".part(",")})
show({"a,b,c".part(",", 1)})
show({"  a  b   c ".part()})
show({"a,,b".part(",")})
show({"banana".remove("na")})
show({"banana".remove("na", 1)})
show({"banana".remove("na", 0)})
