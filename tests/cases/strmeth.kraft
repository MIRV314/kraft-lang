str s = "  Привет, мир  "
show([{s.trim()}])
show([{s.triml()}])
show([{s.trimr()}])
show({s.contains("мир")})
show({s.contains("кот")})
show({s.preff("  Прив")})
show({s.suff("  ")})
show({s.find("мир")})
show({s.find("кот")})
show({s.find("кот") is NONE})
show({s.replace("мир", "Kraft")})
show({s.count("и")})
show({s.count("кот")})
show({s.part(2, 8)})
show([{s.part(9)}])
