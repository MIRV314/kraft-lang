list xs = [10, 20, 30]
show({xs})
show({xs[0]})
show({xs[-1]})
show({xs[1..]})
show({xs[..2]})
show({xs[0..3..2]})
show({xs[2..0..-1]})
xs.add(40)
show({xs})
xs.del(0)
show({xs})
xs.replace(0, 99)
show({xs})
show({xs.contains(30)})
show({xs.count(30)})
show({xs.index(30)})
show({xs.index(777) is NONE})
show({xs.join(", ")})
show({xs.remove(99)})
show({xs})
list ys = xs
ys.add(7)
show({xs})
show({xs is list})
show({xs is dict})
list nested = [[1, 2], [3, 4]]
show({nested[0][1]})
show({nested[1][0..2]})
