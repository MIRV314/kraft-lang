# std/fs — работа с файлами.

export func read(str path) -> str:
    return read_file(path)

export func write(str path, str data) -> bool:
    return write_file(path, data)

export func exists(str path) -> bool:
    return file_exists(path)

export func copy(str src, str dst) -> bool:
    return copy_file(src, dst)

export func remove(str path) -> bool:
    return remove_file(path)
