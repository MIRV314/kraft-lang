func double(flint x) -> flint:
    return x * 2

func is_big(flint x) -> bool:
    return x > 2

func plus(flint a, flint b) -> flint:
    return a + b

list xs = [1, 2, 3]
show({map(xs, double)})
show({filter(xs, is_big)})
show({reduce(xs, plus, 0)})
show({reduce(xs, plus, 10)})
show({map([], double)})
