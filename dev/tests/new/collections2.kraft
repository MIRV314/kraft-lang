list xs = [3, 1, 2]
xs.add(4)
xs.add(0, 9)
show({xs})
xs.del()
xs.del(0)
show({xs})

list dup = [1, 2, 1, 3, 1]
show({dup.remove(1)})
show({dup})
list dup2 = [1, 2, 1, 3, 1]
show({dup2.remove(1, 2)})
show({dup2})
show({dup2.replace_value(3, 30)})
show({dup2})

show({sum([1, 2, 3])})
show({sum([])})
show({avg([2, 4, 6])})
dict d = {a: 1, b: 2}
show({keys(d)})
show({values(d)})
show({upk(d)})
show({upk([1, "два", TRUE])})
list nums = [3, 1, 2]
list sorted = sort(nums)
show({nums})
show({sorted})
show({reverse(nums)})
show({nums})
list toclear = [1, 2]
clear(toclear)
show({toclear})
dict d2 = {a: 1}
clear(d2)
show({d2})
