{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kraft",
  "scopeName": "source.kraft",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#functions" },
    { "include": "#models" },
    { "include": "#error-categories" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.kraft",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kraft",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kraft",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.kraft",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "functions": {
      "match": "^\\s*(func|async)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.kraft" },
        "2": { "name": "entity.name.function.kraft" }
      }
    },
    "models": {
      "match": "^\\s*(model|method|construct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.kraft" },
        "2": { "name": "entity.name.type.kraft" }
      }
    },
    "error-categories": {
      "name": "support.constant.error.kraft",
      "match": "\\b(ANY_ERROR|ARGCOUNT_ERROR|ASSERT_ERROR|CONST_ERROR|EXPECT_ERROR|FILE_ERROR|NAME_ERROR|PANIC_ERROR|RUNTIME_ERROR|TYPE_MISMATCH_ERROR|TYPE_ERROR|VALUE_ERROR)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.kraft",
      "match": "\\b(show|show_err|input|len|type|str|flint|up|low|title|abs|round|floor|ceil|sqrt|factorial|fib|min|max|sum|avg|keys|values|upk|sort|reverse|clear|map|filter|reduce|read_file|write_file|file_exists|copy_file|remove_file|json_parse|json_stringify|raise|args|exit|time_ms|is_tty|timer|system|assert|expect)\\b"
    },
    "keywords": {
      "name": "keyword.control.kraft",
      "match": "\\b(func|async|model|method|construct|if|elif|else|for|in|while|break|continue|pass|return|is|AND|OR|NOT|glob|self|init|try|trigger|finally|panic|import_file|from_file|import_lib|from_lib|namespace)\\b"
    },
    "types": {
      "name": "storage.type.kraft",
      "match": "\\b(str|flint|bool|list|dict|froz)\\b"
    },
    "constants": {
      "name": "constant.language.kraft",
      "match": "\\b(TRUE|FALSE|NONE|Error|error)\\b"
    },
    "numbers": {
      "name": "constant.numeric.kraft",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.kraft",
      "match": "(=>|\\*\\*|//|\\+\\+|\\+=|-=|\\*=|/=|==|!=|<=|>=|\\.\\.\\.|\\.\\.|[-+*/%=<>!])"
    }
  }
}
