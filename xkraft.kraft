# xkraft — компилятор Kraft, написанный на Kraft.
# Лексер, парсер со статическими проверками, кодогенератор в Lua.
# Написан на замороженном v0.1 и компилирует сам себя.
#
# Запуск: ./kraft xkraft.kraft [--tokens] [-c] file.kraft

# ---------- утилиты ----------

func cat(list xs) -> str:
    return xs.join("")

func spaces(flint n) -> str:
    list parts = []
    flint i = 0
    while i < n:
        parts.add(" ")
        i += 1
    return parts.join("")

func char_at(str s, flint i) -> str:
    if i < 0 OR i >= len(s):
        return ""
    return s[i]

func split_lines(str s) -> list:
    list out = []
    flint start = 0
    flint i = 0
    flint n = len(s)
    while i < n:
        if s[i] == "\n":
            str line = s[start..i]
            if line.suff("\r"):
                line = line[..len(line) - 1]
            out.add(line)
            start = i + 1
        i += 1
    str last = s[start..n]
    if last.suff("\r"):
        last = last[..len(last) - 1]
    out.add(last)
    return out

func lua_str(str s) -> str:
    list out = []
    out.add("\"")
    flint i = 0
    flint n = len(s)
    while i < n:
        str c = s[i]
        if c == "\\":
            out.add("\\\\")
        elif c == "\"":
            out.add("\\\"")
        elif c == "\n":
            out.add("\\n")
        elif c == "\r":
            out.add("\\r")
        elif c == "\t":
            out.add("\\t")
        elif c == "\e":
            out.add("\\27")
        else:
            out.add(c)
        i += 1
    out.add("\"")
    return out.join("")

func pad5(flint n) -> str:
    str s = str(n)
    if len(s) >= 5:
        return s
    return cat([spaces(5 - len(s)), s])

func report_error(dict e, str src):
    list lines = split_lines(src)
    str ecat = "SYNTAX_ERROR"
    if e.contains("cat"):
        ecat = e[cat]
    flint line = 1
    if e.contains("line"):
        line = e[line]
    flint col = 1
    if e.contains("col"):
        col = e[col]
    str src_text = ""
    if line >= 1 AND line <= len(lines):
        src_text = lines[line - 1]

    str red = ""
    str yellow = ""
    str reset = ""
    if is_tty():
        red = "\e[31m"
        yellow = "\e[33m"
        reset = "\e[0m"

    str num = cat([pad5(line), " | "])
    list head = []
    head.add(red)
    head.add(ecat)
    head.add(reset)
    head.add(": ")
    head.add(e[path])
    head.add(":")
    head.add(str(line))
    show_err({head.join("")})
    show_err({cat([num, src_text])})
    str pad = spaces(len(num) + col - 1)
    if e.contains("expected"):
        list body = []
        body.add(pad)
        body.add("^ ")
        body.add(yellow)
        body.add("expected ")
        body.add(e[expected])
        body.add(reset)
        body.add(", ")
        body.add(red)
        body.add("found ")
        body.add(e[found])
        body.add(reset)
        show_err({body.join("")})
    else:
        str msg = ""
        if e.contains("msg"):
            msg = e[msg]
        show_err({cat([pad, "^ ", red, msg, reset])})

# ---------- лексические таблицы ----------

func is_digit(str c) -> bool:
    return c != "" AND "0123456789".contains(c)

func is_ascii_other(str c) -> bool:
    str set = " \t\r\n#\"'\{\}()[]+-*/%<>=,:.;!?@$&|^~`\\"
    return set.contains(c)

func is_name_char(str c) -> bool:
    if c == "":
        return FALSE
    if is_digit(c):
        return TRUE
    if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(c):
        return TRUE
    return NOT is_ascii_other(c)

func is_name_start(str c) -> bool:
    if c == "" OR is_digit(c):
        return FALSE
    return is_name_char(c)

func is_keyword(str w) -> bool:
    if w == "func" OR w == "model" OR w == "method" OR w == "construct":
        return TRUE
    if w == "if" OR w == "elif" OR w == "else" OR w == "for" OR w == "in":
        return TRUE
    if w == "while" OR w == "break" OR w == "continue" OR w == "return":
        return TRUE
    if w == "is" OR w == "AND" OR w == "OR" OR w == "NOT" OR w == "glob":
        return TRUE
    if w == "self" OR w == "try" OR w == "finally" OR w == "trigger" OR w == "panic":
        return TRUE
    if w == "init" OR w == "import_file" OR w == "from_file":
        return TRUE
    if w == "import_lib" OR w == "from_lib":
        return TRUE
    if w == "str" OR w == "flint" OR w == "bool" OR w == "list" OR w == "dict":
        return TRUE
    if w == "froz":
        return TRUE
    if w == "TRUE" OR w == "FALSE" OR w == "NONE":
        return TRUE
    return FALSE

func is_template_func(str w) -> bool:
    return w == "show" OR w == "show_err" OR w == "input"

func is_op1(str c) -> bool:
    return c != "" AND "+-*/%<>=()[]\{\},:.".contains(c)

func is_op2(str s) -> bool:
    if s == "**" OR s == "//" OR s == "==" OR s == "!=":
        return TRUE
    if s == "<=" OR s == ">=" OR s == ".." OR s == "->":
        return TRUE
    if s == "+=" OR s == "-=" OR s == "*=" OR s == "/=" OR s == "%=":
        return TRUE
    return FALSE

func is_op3(str s) -> bool:
    return s == "**=" OR s == "//="

func escape_of(str n) -> str:
    if n == "n":
        return "\n"
    if n == "t":
        return "\t"
    if n == "r":
        return "\r"
    if n == "e":
        return "\e"
    if n == "\\":
        return "\\"
    if n == "\{":
        return "\{"
    if n == "\}":
        return "\}"
    if n == "(":
        return "("
    if n == ")":
        return ")"
    if n == "\"":
        return "\""
    if n == "'":
        return "'"
    return NONE

# ---------- лексер ----------

# Сканирует строку или шаблон с позиции i.
# quoted=TRUE  -> закрывающая кавычка quote
# quoted=FALSE -> закрывающая скобка ")"
# Возвращает {parts, close, err}.
func scan_parts(str line, flint i, flint lineno, bool quoted, str quote) -> dict:
    list parts = []
    list buf = []
    flint n = len(line)

    while i < n:
        str c = line[i]
        if c == "\\":
            str nc = char_at(line, i + 1)
            str v = escape_of(nc)
            if v is NONE:
                return {parts: parts, close: i, err: {msg: cat(["unknown escape '\\", nc, "'"]), col: i + 1}}
            buf.add(v)
            i += 2
        elif c == "\{":
            if len(buf) > 0:
                parts.add({kind: "text", value: buf.join("")})
                buf = []
            flint start = i + 1
            flint depth = 0
            flint j = start
            while j < n:
                str d = line[j]
                if d == "\"" OR d == "'":
                    str q = d
                    j += 1
                    while j < n:
                        str e = line[j]
                        if e == "\\":
                            j += 2
                        elif e == q:
                            j += 1
                            break
                        else:
                            j += 1
                elif d == "\{":
                    depth += 1
                    j += 1
                elif d == "\}":
                    if depth == 0:
                        break
                    depth -= 1
                    j += 1
                else:
                    j += 1
            if j >= n:
                return {parts: parts, close: i, err: {msg: "unclosed '\{'", col: i + 1}}
            str inner = line[start..j]
            if inner.trim() == "":
                return {parts: parts, close: i, err: {msg: "empty substitution '\{\}'", col: i + 1}}
            parts.add({kind: "expr", src: inner, line: lineno, col: start + 1})
            i = j + 1
        elif c == "\}":
            return {parts: parts, close: i, err: {msg: "unexpected '\}': use '\\\}'", col: i + 1}}
        elif quoted AND c == quote:
            if len(buf) > 0:
                parts.add({kind: "text", value: buf.join("")})
            return {parts: parts, close: i, err: NONE}
        elif (NOT quoted) AND c == ")":
            if len(buf) > 0:
                parts.add({kind: "text", value: buf.join("")})
            return {parts: parts, close: i, err: NONE}
        else:
            buf.add(c)
            i += 1

    if len(buf) > 0:
        parts.add({kind: "text", value: buf.join("")})
    if quoted:
        return {parts: parts, close: i, err: {msg: "unclosed string", col: i + 1}}
    return {parts: parts, close: i, err: {msg: "unclosed show template: expected ')'", col: i + 1}}

# Разбирает одну строку (без отступа). Дописывает токены в tokens.
func scan_line(str line, flint i, flint lineno, list tokens) -> dict:
    flint n = len(line)
    while i < n:
        str c = line[i]

        if c == " " OR c == "\t":
            i += 1
        elif c == "#":
            return {err: NONE}
        elif c == "\"" OR c == "'":
            dict r = scan_parts(line, i + 1, lineno, TRUE, c)
            if r[err]:
                dict e = r[err]
                e.add("line", lineno)
                return {err: e}
            tokens.add({type: "string", parts: r[parts], line: lineno, col: i + 1})
            i = r[close] + 1
        elif is_digit(c):
            flint j = i
            while j < n AND is_digit(line[j]):
                j += 1
            if char_at(line, j) == "." AND char_at(line, j + 1) != ".":
                j += 1
                while j < n AND is_digit(line[j]):
                    j += 1
            str raw = line[i..j]
            tokens.add({type: "number", value: flint(raw), raw: raw, line: lineno, col: i + 1})
            i = j
        elif is_name_start(c):
            flint j2 = i + 1
            while j2 < n AND is_name_char(line[j2]):
                j2 += 1
            str word = line[i..j2]
            flint col = i + 1

            if is_template_func(word):
                flint k = j2
                while k < n AND (line[k] == " " OR line[k] == "\t"):
                    k += 1
                if char_at(line, k) == "(":
                    tokens.add({type: "name", value: word, line: lineno, col: col})
                    tokens.add({type: "op", value: "(", line: lineno, col: k + 1})
                    dict r2 = scan_parts(line, k + 1, lineno, FALSE, "")
                    if r2[err]:
                        dict e2 = r2[err]
                        e2.add("line", lineno)
                        return {err: e2}
                    tokens.add({type: "template", parts: r2[parts], line: lineno, col: k + 2})
                    tokens.add({type: "op", value: ")", line: lineno, col: r2[close] + 1})
                    i = r2[close] + 1
                else:
                    tokens.add({type: "name", value: word, line: lineno, col: col})
                    i = j2
            elif is_keyword(word):
                tokens.add({type: "kw", value: word, line: lineno, col: col})
                i = j2
            else:
                tokens.add({type: "name", value: word, line: lineno, col: col})
                i = j2
        else:
            str three = line[i..i + 3]
            str two = line[i..i + 2]
            if is_op3(three):
                tokens.add({type: "op", value: three, line: lineno, col: i + 1})
                i += 3
            elif is_op2(two):
                tokens.add({type: "op", value: two, line: lineno, col: i + 1})
                i += 2
            elif is_op1(c):
                tokens.add({type: "op", value: c, line: lineno, col: i + 1})
                i += 1
            else:
                return {err: {msg: cat(["unexpected character '", c, "'"]), line: lineno, col: i + 1}}
    return {err: NONE}

# Токенизирует весь файл. Возвращает {tokens, err}.
func lex(str src, str path) -> dict:
    list tokens = []
    list indent_stack = [""]
    flint lineno = 0
    bool in_block = FALSE
    list lines = split_lines(src)

    for raw_line in lines:
        str line = raw_line
        lineno += 1
        str trimmed = line.trim()

        bool skip = FALSE
        if in_block:
            if trimmed[..3] == "---":
                in_block = FALSE
            skip = TRUE
        elif trimmed[..3] == "---":
            in_block = TRUE
            skip = TRUE
        elif trimmed == "" OR trimmed[..1] == "#":
            skip = TRUE
        if NOT skip:
            flint k = 0
            flint ln = len(line)
            while k < ln AND (line[k] == " " OR line[k] == "\t"):
                k += 1
            str indent = line[..k]
            if indent.contains(" ") AND indent.contains("\t"):
                return {tokens: tokens, err: {msg: "mixed tabs and spaces in indentation", line: lineno, col: 1}}

            str top = indent_stack[len(indent_stack) - 1]
            if indent != top:
                if indent[..len(top)] == top:
                    indent_stack.add(indent)
                    tokens.add({type: "indent", line: lineno, col: 1})
                else:
                    while len(indent_stack) > 1 AND indent_stack[len(indent_stack) - 1] != indent:
                        indent_stack.del(len(indent_stack) - 1)
                        tokens.add({type: "dedent", line: lineno, col: 1})
                    if indent_stack[len(indent_stack) - 1] != indent:
                        return {tokens: tokens, err: {msg: "inconsistent indentation", line: lineno, col: 1}}

            dict r = scan_line(line, len(indent), lineno, tokens)
            if r[err]:
                return {tokens: tokens, err: r[err]}
            tokens.add({type: "newline", line: lineno, col: len(line) + 1})

    while len(indent_stack) > 1:
        indent_stack.del(len(indent_stack) - 1)
        tokens.add({type: "dedent", line: lineno, col: 1})
    tokens.add({type: "eof", line: lineno, col: 1})
    return {tokens: tokens, err: NONE}

# ---------- отладка: --tokens ----------

func describe_tok(dict t) -> str:
    list p = []
    p.add(t[type])
    p.add(" ")
    p.add(str(t[line]))
    p.add(":")
    p.add(str(t[col]))
    if t.contains("value"):
        p.add(" ")
        p.add(str(t[value]))
    if t.contains("raw"):
        p.add(" raw=")
        p.add(t[raw])
    if t.contains("parts"):
        p.add(" parts=")
        p.add(str(t[parts]))
    return p.join("")

func dump_tokens(list toks):
    for t in toks:
        show({describe_tok(t)})

# ---------- парсер: состояние и токены ----------

func token_at(dict st, flint i) -> dict:
    list ts = st[toks]
    if len(ts) == 0:
        return {type: "eof", line: 1, col: 1}
    if i < 0 OR i >= len(ts):
        return ts[len(ts) - 1]
    return ts[i]

func tk(dict st) -> dict:
    return token_at(st, st[pos])

func advance(dict st) -> dict:
    dict t = tk(st)
    st.add("pos", st[pos] + 1)
    return t

func tok_is(dict t, str ty, str val) -> bool:
    if t[type] != ty:
        return FALSE
    if val == "":
        return TRUE
    return t[value] == val

func peek_value(dict st) -> str:
    dict n = token_at(st, st[pos] + 1)
    if n[type] == "op":
        return n[value]
    return ""

func fail(dict st, dict t, str ecat, str expected, str found):
    if st[err]:
        return:
    dict e = {cat: ecat, line: 1, col: 1, expected: expected, found: found, path: st[path]}
    if len(t) > 0:
        e.add("line", t[line])
        e.add("col", t[col])
    st.add("err", e)

func expect_tok(dict st, str ty, str val, str what) -> dict:
    dict t = tk(st)
    if NOT tok_is(t, ty, val):
        fail(st, t, "SYNTAX_ERROR", what, describe_tok(t))
        return {type: "eof", value: "", line: 1, col: 1}
    advance(st)
    return t

# ---------- парсер: типы и имена ----------

func is_type_keyword(str w) -> bool:
    return w == "str" OR w == "flint" OR w == "bool" OR w == "list" OR w == "dict"

func is_numeric(str t) -> bool:
    return t == "flint" OR t == "NONE" OR t == "any"

func assignable(str from, str to) -> bool:
    return from == "NONE" OR from == "any" OR from == to

func is_compare(str op) -> bool:
    return op == "==" OR op == "!=" OR op == "<" OR op == "<=" OR op == ">" OR op == ">="

func is_compound(str op) -> bool:
    if op == "+=" OR op == "-=" OR op == "*=" OR op == "/=":
        return TRUE
    return op == "%=" OR op == "//=" OR op == "**="

func is_const_name(str n) -> bool:
    if len(n) == 0:
        return FALSE
    flint i = 0
    while i < len(n):
        str c = n[i]
        if NOT "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(c):
            return FALSE
        i += 1
    return TRUE

func builtin_arg_ok(str spec, str t) -> bool:
    if spec == "any":
        return TRUE
    if t == "NONE" OR t == "any":
        return TRUE
    if spec == "strlistdict":
        return t == "str" OR t == "list" OR t == "dict"
    if spec == "listdict":
        return t == "list" OR t == "dict"
    return t == spec

func builtin_arg_desc(str spec) -> str:
    if spec == "any":
        return "any value"
    if spec == "strlistdict":
        return "str, list, dict"
    if spec == "listdict":
        return "list, dict"
    return spec

func builtin_info(str name) -> dict:
    if name == "len":
        return {ok: TRUE, n: 1, ret: "flint", a1: "strlistdict"}
    if name == "type":
        return {ok: TRUE, n: 1, ret: "str", a1: "any"}
    if name == "str":
        return {ok: TRUE, n: 1, ret: "str", a1: "any"}
    if name == "flint":
        return {ok: TRUE, n: 1, ret: "flint", a1: "any"}
    if name == "up":
        return {ok: TRUE, n: 1, ret: "str", a1: "str"}
    if name == "low":
        return {ok: TRUE, n: 1, ret: "str", a1: "str"}
    if name == "title":
        return {ok: TRUE, n: 1, ret: "str", a1: "str"}
    if name == "abs":
        return {ok: TRUE, n: 1, ret: "flint", a1: "flint"}
    if name == "round":
        return {ok: TRUE, n: 1, ret: "flint", a1: "flint"}
    if name == "floor":
        return {ok: TRUE, n: 1, ret: "flint", a1: "flint"}
    if name == "ceil":
        return {ok: TRUE, n: 1, ret: "flint", a1: "flint"}
    if name == "sqrt":
        return {ok: TRUE, n: 1, ret: "flint", a1: "flint"}
    if name == "min":
        return {ok: TRUE, variadic: TRUE, min: 1, max: 9, ret: "flint", a1: "flint"}
    if name == "max":
        return {ok: TRUE, variadic: TRUE, min: 1, max: 9, ret: "flint", a1: "flint"}
    if name == "sum":
        return {ok: TRUE, n: 1, ret: "flint", a1: "list"}
    if name == "avg":
        return {ok: TRUE, n: 1, ret: "flint", a1: "list"}
    if name == "keys":
        return {ok: TRUE, n: 1, ret: "list", a1: "dict"}
    if name == "values":
        return {ok: TRUE, n: 1, ret: "list", a1: "dict"}
    if name == "upk":
        return {ok: TRUE, n: 1, ret: "str", a1: "listdict"}
    if name == "sort":
        return {ok: TRUE, n: 1, ret: "list", a1: "list"}
    if name == "reverse":
        return {ok: TRUE, n: 1, ret: "list", a1: "list"}
    if name == "clear":
        return {ok: TRUE, n: 1, ret: "NONE", a1: "listdict"}
    if name == "map":
        return {ok: TRUE, n: 2, ret: "list", a1: "list", a2: "func"}
    if name == "filter":
        return {ok: TRUE, n: 2, ret: "list", a1: "list", a2: "func"}
    if name == "reduce":
        return {ok: TRUE, n: 3, ret: "any", a1: "list", a2: "func", a3: "any"}
    if name == "system":
        return {ok: TRUE, n: 1, ret: "flint", a1: "str"}
    if name == "assert":
        return {ok: TRUE, n: 2, ret: "NONE", a1: "any", a2: "str"}
    if name == "expect":
        return {ok: TRUE, n: 1, ret: "expect", a1: "any"}
    if name == "read_file":
        return {ok: TRUE, n: 1, ret: "str", a1: "str"}
    if name == "write_file":
        return {ok: TRUE, n: 2, ret: "bool", a1: "str", a2: "str"}
    if name == "file_exists":
        return {ok: TRUE, n: 1, ret: "bool", a1: "str"}
    if name == "args":
        return {ok: TRUE, n: 0, ret: "list", a1: "any"}
    if name == "exit":
        return {ok: TRUE, n: 1, ret: "NONE", a1: "flint"}
    if name == "time_ms":
        return {ok: TRUE, n: 0, ret: "flint", a1: "any"}
    if name == "is_tty":
        return {ok: TRUE, n: 0, ret: "bool", a1: "any"}
    return {ok: FALSE}

func is_builtin(str name) -> bool:
    return builtin_info(name)[ok]

func method_info(str base, str name) -> dict:
    if base == "str":
        if name == "part":
            return {ok: TRUE, min: 0, max: 2, a1: "str", a2: "flint", rt: "str_part", ret: "list", nullable: FALSE}
        if name == "find":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "str_find", ret: "flint", nullable: TRUE}
        if name == "contains":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "str_contains", ret: "bool", nullable: FALSE}
        if name == "preff":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "str_preff", ret: "bool", nullable: FALSE}
        if name == "suff":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "str_suff", ret: "bool", nullable: FALSE}
        if name == "trim":
            return {ok: TRUE, min: 0, max: 1, a1: "str", a2: "any", rt: "str_trim", ret: "str", nullable: FALSE}
        if name == "triml":
            return {ok: TRUE, min: 0, max: 1, a1: "str", a2: "any", rt: "str_triml", ret: "str", nullable: FALSE}
        if name == "trimr":
            return {ok: TRUE, min: 0, max: 1, a1: "str", a2: "any", rt: "str_trimr", ret: "str", nullable: FALSE}
        if name == "remove":
            return {ok: TRUE, min: 1, max: 2, a1: "str", a2: "flint", rt: "str_remove", ret: "str", nullable: FALSE}
        if name == "replace":
            return {ok: TRUE, min: 2, max: 2, a1: "str", a2: "str", rt: "str_replace", ret: "str", nullable: FALSE}
        if name == "count":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "str_count", ret: "flint", nullable: FALSE}
    elif base == "list":
        if name == "add":
            return {ok: TRUE, min: 1, max: 2, a1: "any", a2: "any", rt: "list_add", ret: "NONE", nullable: FALSE}
        if name == "del":
            return {ok: TRUE, min: 0, max: 1, a1: "flint", a2: "any", rt: "list_del", ret: "NONE", nullable: FALSE}
        if name == "remove":
            return {ok: TRUE, min: 1, max: 2, a1: "any", a2: "flint", rt: "list_remove", ret: "bool", nullable: FALSE}
        if name == "replace":
            return {ok: TRUE, min: 2, max: 2, a1: "flint", a2: "any", rt: "list_replace", ret: "NONE", nullable: FALSE}
        if name == "replace_value":
            return {ok: TRUE, min: 2, max: 2, a1: "any", a2: "any", rt: "list_replace_value", ret: "bool", nullable: FALSE}
        if name == "contains":
            return {ok: TRUE, min: 1, max: 1, a1: "any", a2: "any", rt: "list_contains", ret: "bool", nullable: FALSE}
        if name == "count":
            return {ok: TRUE, min: 1, max: 1, a1: "any", a2: "any", rt: "list_count", ret: "flint", nullable: FALSE}
        if name == "index":
            return {ok: TRUE, min: 1, max: 1, a1: "any", a2: "any", rt: "list_index_of", ret: "flint", nullable: TRUE}
        if name == "join":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "list_join", ret: "str", nullable: FALSE}
    elif base == "dict":
        if name == "add":
            return {ok: TRUE, min: 2, max: 2, a1: "str", a2: "any", rt: "dict_add", ret: "NONE", nullable: FALSE}
        if name == "take":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "dict_take", ret: "any", nullable: TRUE}
        if name == "remove":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "dict_remove", ret: "bool", nullable: FALSE}
        if name == "contains":
            return {ok: TRUE, min: 1, max: 1, a1: "str", a2: "any", rt: "dict_contains", ret: "bool", nullable: FALSE}
        if name == "merge":
            return {ok: TRUE, min: 1, max: 1, a1: "dict", a2: "any", rt: "dict_merge", ret: "dict", nullable: FALSE}
    elif base == "expect":
        if name == "equals":
            return {ok: TRUE, min: 1, max: 1, a1: "any", a2: "any", rt: "expect_equals", ret: "NONE", nullable: FALSE}
        if name == "is_true":
            return {ok: TRUE, min: 0, max: 0, a1: "any", a2: "any", rt: "expect_true", ret: "NONE", nullable: FALSE}
        if name == "is_false":
            return {ok: TRUE, min: 0, max: 0, a1: "any", a2: "any", rt: "expect_false", ret: "NONE", nullable: FALSE}
        if name == "is_none":
            return {ok: TRUE, min: 0, max: 0, a1: "any", a2: "any", rt: "expect_none", ret: "NONE", nullable: FALSE}
        if name == "contains":
            return {ok: TRUE, min: 1, max: 1, a1: "any", a2: "any", rt: "expect_contains", ret: "NONE", nullable: FALSE}
    return {ok: FALSE}

func is_reserved(str name) -> bool:
    if is_builtin(name) OR name == "show" OR name == "show_err" OR name == "input" OR name == "Error":
        return TRUE
    # Методы типов — тоже занятые имена: `add`, `take`, `contains`, `text` и т.д.
    return method_info("str", name)[ok] OR method_info("list", name)[ok] OR method_info("dict", name)[ok] OR method_info("expect", name)[ok] OR name == "text"

# Встроенная модель Error: схема известна компилятору, объект создаёт рантайм.
func error_schema() -> dict:
    dict fields = {cat: "str", msg: "str", file: "str", line: "flint", col: "flint"}
    dict consts = {}
    consts.add("cat", TRUE)
    consts.add("msg", TRUE)
    consts.add("file", TRUE)
    consts.add("line", TRUE)
    consts.add("col", TRUE)
    dict meth = {}
    meth.add("text", {params: [], ret: "str", ret_nullable: FALSE, line: 1, col: 1})
    return {name: "Error", model_fields: {}, field_types: fields, consts: consts, init_fields: {}, params: [], param_types: {}, methods: meth, method_order: ["text"], ctor: NONE, order: [], field_order: []}

func is_scalar_type(str t) -> bool:
    return t == "str" OR t == "flint" OR t == "bool"

func is_model_type(dict st, str t) -> bool:
    dict ms = st[models]
    return ms.contains(t)

func model_schema(dict st, str t) -> dict:
    dict ms = st[models]
    return ms.take(t)

func check_field_name(dict st, dict tok, str nm):
    if is_reserved(nm):
        fail(st, tok, "NAME_ERROR", "free field name", cat(["reserved '", nm, "'"]))
        return:

# Регистрирует экземплярное поле в схеме. new=FALSE — поле уже было.
func add_model_field(dict st, dict m, dict tok, str nm, str fty, bool computed):
    dict mf = m[model_fields]
    dict ft = m[field_types]
    dict cs = m[consts]
    dict initf = m[init_fields]
    dict methods = m[methods]
    if mf.contains(nm) OR ft.contains(nm) OR methods.contains(nm):
        fail(st, tok, "REDECLARE_ERROR", "unique field/method name", cat(["name '", nm, "' is already declared"]))
        return:
    ft.add(nm, fty)
    list fo = m[field_order]
    fo.add(nm)
    if is_const_name(nm):
        cs.add(nm, TRUE)
    if computed AND NOT is_const_name(nm):
        initf.add(nm, TRUE)

func parse_type_name(dict st) -> str:
    dict t = tk(st)
    if t[type] == "kw":
        str v = t[value]
        if v == "str" OR v == "flint" OR v == "bool" OR v == "list" OR v == "dict" OR v == "NONE":
            advance(st)
            return v
    if t[type] == "name" AND is_model_type(st, t[value]):
        advance(st)
        return t[value]
    fail(st, t, "TYPE_ERROR", "type name", describe_tok(t))
    return ""

func mangle_var(dict st, str name) -> str:
    st.add("vcounter", st[vcounter] + 1)
    str lua = cat(["v_", str(st[vcounter])])
    dict names = st[names]
    names.add(name, lua)
    return lua

func mangle_func(dict st, str name) -> str:
    st.add("fcounter", st[fcounter] + 1)
    str lua = cat(["f_", str(st[fcounter])])
    dict fnames = st[fnames]
    fnames.add(name, lua)
    return lua

func e_nullable(dict e) -> bool:
    if e.contains("nullable"):
        return e[nullable]
    return FALSE

# ---------- парсер: выражения ----------

func shift_token_pos(dict t, flint dl, flint dc) -> bool:
    if NOT t.contains("line"):
        return TRUE
    flint old = t[line]
    t.add("line", old + dl)
    if old == 1:
        t.add("col", t[col] + dc)
    if t.contains("parts"):
        list ps = t[parts]
        flint pi = 0
        while pi < len(ps):
            shift_token_pos(ps[pi], dl, dc)
            pi += 1
    return TRUE

func template_state(dict st, dict p) -> dict:
    dict lx = lex(p[src], st[path])
    list ts = lx[tokens]
    dict e0 = NONE
    if lx[err]:
        dict le = lx[err]
        flint eline = p[line] + le[line] - 1
        flint ecol = le[col]
        if le[line] == 1:
            ecol = p[col] + le[col] - 1
        e0 = {cat: "SYNTAX_ERROR", line: eline, col: ecol, msg: le[msg], path: st[path]}
    flint i = 0
    while i < len(ts):
        dict t2 = ts[i]
        shift_token_pos(t2, p[line] - 1, p[col] - 1)
        i += 1
    return {toks: ts, pos: 0, path: st[path], const_top: st[const_top], vars: st[vars], nullable: st[nullable], maybe_unset: st[maybe_unset], gvars: st[gvars], gnullable: st[gnullable], gmaybe: st[gmaybe], for_names: st[for_names], funcs: st[funcs], in_func: st[in_func], func_ret: st[func_ret], func_returns: st[func_returns], block_depth: st[block_depth], loop_depth: st[loop_depth], err: e0, names: st[names], fnames: st[fnames], vcounter: st[vcounter], fcounter: st[fcounter], models: st[models], model_ctx: st[model_ctx]}

func parse_expr(dict st, flint min_bp) -> dict:
    if st[err]:
        return {}
    dict t = tk(st)
    str ty = t[type]
    dict e = {}
    dict ptok = NONE
    str pfn = ""

    if ty == "number":
        advance(st)
        e = {k: "num", value: t[value], t: "flint", line: t[line], col: t[col]}
    elif ty == "string":
        advance(st)
        ptok = t
    elif ty == "kw" AND t[value] == "TRUE":
        advance(st)
        e = {k: "bool", value: TRUE, t: "bool", line: t[line], col: t[col]}
    elif ty == "kw" AND t[value] == "FALSE":
        advance(st)
        e = {k: "bool", value: FALSE, t: "bool", line: t[line], col: t[col]}
    elif ty == "kw" AND t[value] == "NONE":
        advance(st)
        e = {k: "none", t: "NONE", line: t[line], col: t[col]}
    elif ty == "kw" AND t[value] == "self":
        dict mctx = st[model_ctx]
        if mctx is NONE:
            fail(st, t, "SCOPE_ERROR", "'self' inside a model", "'self' outside a model")
            return {}
        advance(st)
        if tok_is(tk(st), "op", "("):
            advance(st)
            list snames = []
            if NOT tok_is(tk(st), "op", ")"):
                while TRUE:
                    dict snt = expect_tok(st, "name", "", "parameter name in self(...)")
                    if st[err]:
                        return {}
                    snames.add(snt)
                    if tok_is(tk(st), "op", ","):
                        advance(st)
                    else:
                        break
            expect_tok(st, "op", ")", "')'")
            if st[err]:
                return {}
            e = {k: "self_init", names: snames, t: "NONE", line: t[line], col: t[col]}
        else:
            e = {k: "var", name: "self", lua: "self", t: mctx[model_name], line: t[line], col: t[col]}
    elif ty == "name" AND is_model_type(st, t[value]) AND peek_value(st) == "(":
        str cmn = t[value]
        dict cms = model_schema(st, cmn)
        dict ccons = cms[ctor]
        if ccons is NONE:
            fail(st, t, "NAME_ERROR", cat(["declared construct of '", cmn, "'"]), "model without construct")
            return {}
        advance(st)
        expect_tok(st, "op", "(", "'('")
        list cmargs = []
        if NOT tok_is(tk(st), "op", ")"):
            while TRUE:
                dict cma = parse_expr(st, 0)
                if st[err]:
                    return {}
                cmargs.add(cma)
                if tok_is(tk(st), "op", ","):
                    advance(st)
                else:
                    break
        expect_tok(st, "op", ")", "')'")
        if st[err]:
            return {}
        list cmparams = ccons[params]
        if len(cmargs) != len(cmparams):
            fail(st, t, "ARGCOUNT_ERROR", cat([str(len(cmparams)), " argument(s) to '", cmn, "'"]), cat([str(len(cmargs)), " argument(s)"]))
            return {}
        list cmpt = []
        flint cmi = 0
        while cmi < len(cmargs):
            dict cma2 = cmargs[cmi]
            dict cmp = cmparams[cmi]
            cmpt.add(cmp[type])
            if NOT assignable(cma2[t], cmp[type]):
                fail(st, {line: cma2[line], col: cma2[col]}, "TYPE_ERROR", cat(["argument ", str(cmi + 1), " of '", cmn, "' to be ", cmp[type]]), cma2[t])
                return {}
            cmi += 1
        e = {k: "model_new", mname: cmn, args: cmargs, ptypes: cmpt, t: cmn, line: t[line], col: t[col]}
    elif (ty == "kw" OR ty == "name") AND is_builtin(t[value]) AND peek_value(st) == "(":
        str bn = t[value]
        advance(st)
        expect_tok(st, "op", "(", "'('")
        list bargs = []
        if bn == "map" OR bn == "filter" OR bn == "reduce":
            dict hcoll = parse_expr(st, 0)
            if st[err]:
                return {}
            bargs.add(hcoll)
            expect_tok(st, "op", ",", "','")
            if st[err]:
                return {}
            dict hft = expect_tok(st, "name", "", "function name")
            if st[err]:
                return {}
            str hfn = hft[value]
            dict hfuncs = st[funcs]
            if NOT hfuncs.contains(hfn):
                fail(st, hft, "NAME_ERROR", "declared function", cat(["undeclared function '", hfn, "'"]))
                return {}
            dict hfi = hfuncs.take(hfn)
            flint hwant = 1
            if bn == "reduce":
                hwant = 2
            if len(hfi[params]) != hwant:
                fail(st, hft, "ARGCOUNT_ERROR", cat([str(hwant), " parameter(s) in '", hfn, "'"]), cat([str(len(hfi[params])), " parameter(s)"]))
                return {}
            dict hnames = st[fnames]
            bargs.add({k: "func_ref", name: hfn, lua: hnames.take(hfn), t: "func", line: hft[line], col: hft[col]})
            if bn == "reduce":
                expect_tok(st, "op", ",", "','")
                if st[err]:
                    return {}
                dict hstart = parse_expr(st, 0)
                if st[err]:
                    return {}
                bargs.add(hstart)
            expect_tok(st, "op", ")", "')'")
        else:
            if NOT tok_is(tk(st), "op", ")"):
                while TRUE:
                    dict ba1 = parse_expr(st, 0)
                    if st[err]:
                        return {}
                    bargs.add(ba1)
                    if tok_is(tk(st), "op", ","):
                        advance(st)
                    else:
                        break
            expect_tok(st, "op", ")", "')'")
        if st[err]:
            return {}
        dict bi = builtin_info(bn)
        bool bvari = FALSE
        if bi.contains("variadic"):
            bvari = bi[variadic]
        if bvari:
            if len(bargs) < bi[min] OR len(bargs) > bi[max]:
                fail(st, t, "ARGCOUNT_ERROR", cat([str(bi[min]), "..", str(bi[max]), " argument(s) to '", bn, "'"]), cat([str(len(bargs)), " argument(s)"]))
                return {}
        else:
            flint np = bi[n]
            if len(bargs) != np:
                fail(st, t, "ARGCOUNT_ERROR", cat([str(np), " argument(s) to '", bn, "'"]), cat([str(len(bargs)), " argument(s)"]))
                return {}
        flint bai = 0
        while bai < len(bargs):
            dict ba2 = bargs[bai]
            if bvari:
                if len(bargs) == 1 AND (ba2[t] == "list" OR ba2[t] == "any" OR ba2[t] == "NONE"):
                    bai += 1
                else:
                    if NOT builtin_arg_ok(bi[a1], ba2[t]):
                        fail(st, {line: ba2[line], col: ba2[col]}, "TYPE_ERROR", cat(["argument ", str(bai + 1), " of '", bn, "' to be flint"]), ba2[t])
                        return {}
                    bai += 1
            else:
                str bspec = bi[a1]
                if bai == 1:
                    bspec = bi[a2]
                elif bai == 2:
                    bspec = bi[a3]
                if NOT builtin_arg_ok(bspec, ba2[t]):
                    fail(st, {line: ba2[line], col: ba2[col]}, "TYPE_ERROR", cat(["argument ", str(bai + 1), " of '", bn, "' to be ", builtin_arg_desc(bspec)]), ba2[t])
                    return {}
                bai += 1
        if bn == "str" AND len(bargs) == 1:
            dict barg0 = bargs[0]
            if is_model_type(st, barg0[t]):
                fail(st, barg0, "TYPE_ERROR", "a field or method inside str(...), not a model instance", barg0[t])
                return {}
        e = {k: "builtin", name: bn, args: bargs, t: bi[ret], line: t[line], col: t[col]}
    elif ty == "name" AND is_template_func(t[value]):
        pfn = t[value]
        advance(st)
        expect_tok(st, "op", "(", "'('")
        dict tpl = expect_tok(st, "template", "", "template")
        expect_tok(st, "op", ")", "')'")
        if st[err]:
            return {}
        ptok = tpl
    elif ty == "name":
        str fn = t[value]
        if is_model_type(st, fn):
            fail(st, t, "TYPE_ERROR", "a value, not a model name", cat(["model '", fn, "'"]))
            return {}
        if peek_value(st) == "(":
            dict funcs = st[funcs]
            if NOT funcs.contains(fn):
                fail(st, t, "NAME_ERROR", "declared function", cat(["undeclared function '", fn, "'"]))
                return {}
            dict fi = funcs.take(fn)
            if fi[inferring] AND fi[ret] is NONE:
                fail(st, t, "TYPE_ERROR", "explicit '->' for recursion", cat(["'", fn, "' is called while its return type is inferred"]))
                return {}
            advance(st)
            expect_tok(st, "op", "(", "'('")
            list cargs = []
            if NOT tok_is(tk(st), "op", ")"):
                while TRUE:
                    dict ca1 = parse_expr(st, 0)
                    if st[err]:
                        return {}
                    cargs.add(ca1)
                    if tok_is(tk(st), "op", ","):
                        advance(st)
                    else:
                        break
            expect_tok(st, "op", ")", "')'")
            if st[err]:
                return {}
            list params = fi[params]
            if len(cargs) != len(params):
                fail(st, t, "ARGCOUNT_ERROR", cat([str(len(params)), " argument(s) to '", fn, "'"]), cat([str(len(cargs)), " argument(s)"]))
                return {}
            list ptypes = []
            flint cai = 0
            while cai < len(cargs):
                dict ca2 = cargs[cai]
                dict pp = params[cai]
                str pt = pp[type]
                ptypes.add(pt)
                if ca2[t] != "NONE" AND ca2[t] != "any" AND ca2[t] != pt:
                    fail(st, {line: ca2[line], col: ca2[col]}, "TYPE_ERROR", cat(["argument ", str(cai + 1), " of '", fn, "' to be ", pt]), ca2[t])
                    return {}
                cai += 1
            dict fnames = st[fnames]
            e = {k: "call_user", name: fn, lua: fnames.take(fn), args: cargs, ptypes: ptypes, t: fi[ret], nullable: fi[ret_nullable], line: t[line], col: t[col]}
        else:
            str vn = t[value]
            dict vars = st[vars]
            bool is_local = vars.contains(vn)
            dict gv = st[gvars]
            bool is_global = FALSE
            bool is_mfield = FALSE
            dict mctxv = st[model_ctx]
            if NOT is_local:
                if gv.contains(vn):
                    is_global = TRUE
                elif NOT (mctxv is NONE):
                    dict ms0 = mctxv[schema]
                    dict mf0 = ms0[model_fields]
                    if mf0.contains(vn):
                        is_mfield = TRUE
                    else:
                        fail(st, t, "NAME_ERROR", "declared name", cat(["undeclared '", vn, "'"]))
                        return {}
                else:
                    fail(st, t, "NAME_ERROR", "declared name", cat(["undeclared '", vn, "'"]))
                    return {}
            advance(st)
            dict names = st[names]
            bool nl = FALSE
            str vt = ""
            if is_mfield:
                dict ms1 = mctxv[schema]
                dict mf1 = ms1[model_fields]
                vt = mf1.take(vn)
                e = {k: "model_field", name: vn, mname: mctxv[model_name], t: vt, line: t[line], col: t[col]}
            else:
                if is_local:
                    vt = vars.take(vn)
                    dict nd = st[nullable]
                    if nd.contains(vn):
                        nl = nd.take(vn)
                    dict mu = st[maybe_unset]
                    if mu.contains(vn):
                        nl = TRUE
                else:
                    vt = gv.take(vn)
                    dict gnl = st[gnullable]
                    if gnl.contains(vn):
                        nl = gnl.take(vn)
                    dict gmu = st[gmaybe]
                    if gmu.contains(vn):
                        nl = TRUE
                e = {k: "var", name: vn, lua: names.take(vn), t: vt, nullable: nl, line: t[line], col: t[col]}
    elif ty == "op" AND t[value] == "(":
        advance(st)
        e = parse_expr(st, 0)
        if st[err]:
            return {}
        expect_tok(st, "op", ")", "')'")
        if st[err]:
            return {}
    elif ty == "op" AND t[value] == "[":
        advance(st)
        list items = []
        if NOT tok_is(tk(st), "op", "]"):
            while TRUE:
                dict it = parse_expr(st, 0)
                if st[err]:
                    return {}
                items.add(it)
                if tok_is(tk(st), "op", ","):
                    advance(st)
                else:
                    break
        expect_tok(st, "op", "]", "']'")
        if st[err]:
            return {}
        e = {k: "list", items: items, t: "list", line: t[line], col: t[col]}
    elif ty == "op" AND t[value] == "\{":
        advance(st)
        list pairs = []
        if NOT tok_is(tk(st), "op", "\}"):
            while TRUE:
                dict dkt = tk(st)
                str dkey = ""
                if dkt[type] == "name":
                    advance(st)
                    dkey = dkt[value]
                elif dkt[type] == "string":
                    advance(st)
                    list drawk = dkt[parts]
                    list dbuf = []
                    for dp0 in drawk:
                        dict dpd = dp0
                        if dpd[kind] != "text":
                            fail(st, dkt, "TYPE_ERROR", "plain string dkey", "interpolated string")
                            return {}
                        dbuf.add(dpd[value])
                    dkey = dbuf.join("")
                else:
                    fail(st, dkt, "TYPE_ERROR", "dict dkey as bare name or string literal", describe_tok(dkt))
                    return {}
                expect_tok(st, "op", ":", "':'")
                dict dval = parse_expr(st, 0)
                if st[err]:
                    return {}
                pairs.add({key: dkey, value: dval})
                if tok_is(tk(st), "op", ","):
                    advance(st)
                else:
                    break
        expect_tok(st, "op", "\}", "'\}'")
        if st[err]:
            return {}
        e = {k: "dict", pairs: pairs, t: "dict", line: t[line], col: t[col]}
    elif ty == "op" AND t[value] == "-":
        advance(st)
        dict ua = parse_expr(st, 60)
        if st[err]:
            return {}
        if NOT is_numeric(ua[t]):
            fail(st, t, "TYPE_ERROR", "operand of unary '-' to be flint", ua[t])
            return {}
        e = {k: "un", op: "-", a: ua, t: "flint", line: t[line], col: t[col]}
    elif ty == "kw" AND t[value] == "NOT":
        advance(st)
        dict na = parse_expr(st, 25)
        if st[err]:
            return {}
        e = {k: "un", op: "NOT", a: na, t: "bool", line: t[line], col: t[col]}
    else:
        fail(st, t, "SYNTAX_ERROR", "expression", describe_tok(t))
        return {}

    if NOT (ptok is NONE):
        list parts = []
        list raw = ptok[parts]
        flint pi = 0
        while pi < len(raw):
            dict p = raw[pi]
            if p[kind] == "text":
                parts.add({kind: "text", value: p[value]})
            else:
                dict sub = template_state(st, p)
                dict ex = parse_expr(sub, 0)
                if sub[err]:
                    st.add("err", sub[err])
                    return {}
                if st[err]:
                    return {}
                dict rest = tk(sub)
                if rest[type] != "newline" AND rest[type] != "eof":
                    fail(sub, rest, "SYNTAX_ERROR", "end of expression", describe_tok(rest))
                    st.add("err", sub[err])
                    return {}
                if is_model_type(st, ex[t]):
                    fail(st, {line: ex[line], col: ex[col]}, "TYPE_ERROR", "a field or method inside interpolation, not a model instance", ex[t])
                    return {}
                parts.add({kind: "expr", expr: ex})
            pi += 1
        if pfn == "":
            e = {k: "str", parts: parts, t: "str", line: t[line], col: t[col]}
        else:
            str tt = "NONE"
            if pfn == "input":
                tt = "str"
            e = {k: "call", fn: pfn, parts: parts, t: tt, line: t[line], col: t[col]}

    # постфиксы: индексы, срезы, методы
    bool more = TRUE
    while more:
        dict nt = tk(st)
        if nt[type] == "op" AND nt[value] == "[":
            advance(st)
            str bt = e[t]
            if bt == "dict":
                dict pkt = tk(st)
                str pkey = ""
                if pkt[type] == "name":
                    advance(st)
                    pkey = pkt[value]
                elif pkt[type] == "string":
                    advance(st)
                    list prawk = pkt[parts]
                    list pbuf = []
                    for pp0 in prawk:
                        dict ppd = pp0
                        if ppd[kind] != "text":
                            fail(st, pkt, "TYPE_ERROR", "plain string pkey", "interpolated string")
                            return {}
                        pbuf.add(ppd[value])
                    pkey = pbuf.join("")
                else:
                    fail(st, pkt, "TYPE_ERROR", "dict pkey as bare name or string literal", describe_tok(pkt))
                    return {}
                expect_tok(st, "op", "]", "']'")
                if st[err]:
                    return {}
                e = {k: "dget", base: e, key: pkey, t: "any", nullable: TRUE, line: nt[line], col: nt[col]}
            else:
                if bt != "str" AND bt != "list" AND bt != "NONE" AND bt != "any":
                    fail(st, nt, "TYPE_ERROR", "str, list or dict receiver of an index", bt)
                    return {}
                dict from = {}
                bool has_from = FALSE
                if NOT tok_is(tk(st), "op", ".."):
                    from = parse_expr(st, 0)
                    if st[err]:
                        return {}
                    has_from = TRUE
                if tok_is(tk(st), "op", ".."):
                    advance(st)
                    dict to = {}
                    bool has_to = FALSE
                    if NOT tok_is(tk(st), "op", "]"):
                        to = parse_expr(st, 0)
                        if st[err]:
                            return {}
                        has_to = TRUE
                    dict step = {}
                    bool has_step = FALSE
                    if tok_is(tk(st), "op", ".."):
                        advance(st)
                        step = parse_expr(st, 0)
                        if st[err]:
                            return {}
                        has_step = TRUE
                    expect_tok(st, "op", "]", "']'")
                    if st[err]:
                        return {}
                    list bounds = []
                    if has_from:
                        bounds.add(from)
                    if has_to:
                        bounds.add(to)
                    if has_step:
                        bounds.add(step)
                    for b0 in bounds:
                        dict sb = b0
                        if sb[t] != "flint" AND sb[t] != "NONE" AND sb[t] != "any":
                            fail(st, {line: sb[line], col: sb[col]}, "TYPE_ERROR", "slice bound to be flint", sb[t])
                            return {}
                    str stype = "any"
                    if bt == "list":
                        stype = "list"
                    elif bt == "str":
                        stype = "str"
                    dict node = {k: "slice", base: e, t: stype, line: nt[line], col: nt[col]}
                    if has_from:
                        node.add("from", from)
                    else:
                        node.add("from", NONE)
                    if has_to:
                        node.add("to", to)
                    else:
                        node.add("to", NONE)
                    if has_step:
                        node.add("step", step)
                    else:
                        node.add("step", NONE)
                    e = node
                else:
                    expect_tok(st, "op", "]", "']'")
                    if st[err]:
                        return {}
                    if from[t] != "flint" AND from[t] != "NONE" AND from[t] != "any":
                        fail(st, {line: from[line], col: from[col]}, "TYPE_ERROR", "index to be flint", from[t])
                        return {}
                    str itype = "any"
                    if bt == "str":
                        itype = "str"
                    e = {k: "index", base: e, index: from, t: itype, line: nt[line], col: nt[col]}
        elif nt[type] == "op" AND nt[value] == ".":
            advance(st)
            dict mt = tk(st)
            str mname = ""
            if mt[type] == "name":
                advance(st)
                mname = mt[value]
            else:
                fail(st, mt, "SYNTAX_ERROR", "field or method name", describe_tok(mt))
                return {}
            str mbt = e[t]
            if is_model_type(st, mbt):
                dict ms = model_schema(st, mbt)
                dict mms = ms[methods]
                if tok_is(tk(st), "op", "("):
                    if NOT mms.contains(mname):
                        fail(st, mt, "NAME_ERROR", cat([mbt, " method"]), cat(["unknown method '", mname, "'"]))
                        return {}
                    dict mm = mms.take(mname)
                    advance(st)
                    list margs = []
                    if NOT tok_is(tk(st), "op", ")"):
                        while TRUE:
                            dict ma = parse_expr(st, 0)
                            if st[err]:
                                return {}
                            margs.add(ma)
                            if tok_is(tk(st), "op", ","):
                                advance(st)
                            else:
                                break
                    expect_tok(st, "op", ")", "')'")
                    if st[err]:
                        return {}
                    list mparams = mm[params]
                    if len(margs) != len(mparams):
                        fail(st, mt, "ARGCOUNT_ERROR", cat([str(len(mparams)), " argument(s) to '", mname, "'"]), cat([str(len(margs)), " argument(s)"]))
                        return {}
                    list mpt = []
                    flint mai = 0
                    while mai < len(margs):
                        dict mma = margs[mai]
                        dict mmp = mparams[mai]
                        mpt.add(mmp[type])
                        if NOT assignable(mma[t], mmp[type]):
                            fail(st, {line: mma[line], col: mma[col]}, "TYPE_ERROR", cat(["argument ", str(mai + 1), " of '", mname, "' to be ", mmp[type]]), mma[t])
                            return {}
                        mai += 1
                    e = {k: "model_method", base: e, mname: mbt, name: mname, args: margs, ptypes: mpt, t: mm[ret], nullable: mm[ret_nullable], line: mt[line], col: mt[col]}
                else:
                    dict mfs = ms[model_fields]
                    dict fts = ms[field_types]
                    if mfs.contains(mname):
                        e = {k: "field", base: e, name: mname, mname: mbt, model_field: TRUE, is_const: TRUE, t: mfs.take(mname), line: mt[line], col: mt[col]}
                    elif fts.contains(mname):
                        dict mcs = ms[consts]
                        bool fconst = mcs.contains(mname)
                        e = {k: "field", base: e, name: mname, mname: mbt, model_field: FALSE, is_const: fconst, t: fts.take(mname), line: mt[line], col: mt[col]}
                    else:
                        dict mctxf = st[model_ctx]
                        bool self_new = FALSE
                        if NOT (mctxf is NONE):
                            if mctxf[in_construct] AND st[block_depth] == mctxf[level] AND mctxf[self_done] AND e[k] == "var" AND e[name] == "self" AND tok_is(tk(st), "op", "="):
                                self_new = TRUE
                        if self_new:
                            e = {k: "field", base: e, name: mname, mname: mbt, model_field: FALSE, is_const: FALSE, new_field: TRUE, t: "NONE", line: mt[line], col: mt[col]}
                        else:
                            fail(st, mt, "NAME_ERROR", cat([mbt, " field or method"]), cat(["unknown field '", mname, "'"]))
                            return {}
            else:
                expect_tok(st, "op", "(", "'('")
                list bmargs = []
                if NOT tok_is(tk(st), "op", ")"):
                    while TRUE:
                        dict ma2 = parse_expr(st, 0)
                        if st[err]:
                            return {}
                        bmargs.add(ma2)
                        if tok_is(tk(st), "op", ","):
                            advance(st)
                        else:
                            break
                expect_tok(st, "op", ")", "')'")
                if st[err]:
                    return {}
                if mbt == "any":
                    fail(st, mt, "TYPE_ERROR", cat(["typed receiver of method '", mname, "' (bind the value to a type first)"]), "any")
                    return {}
                dict mi = method_info(mbt, mname)
                if NOT mi[ok]:
                    if mbt == "str" OR mbt == "list" OR mbt == "dict" OR mbt == "expect":
                        fail(st, mt, "NAME_ERROR", cat([mbt, " method"]), cat(["unknown method '", mname, "'"]))
                    else:
                        fail(st, mt, "TYPE_ERROR", cat(["str, list or dict receiver of '", mname, "'"]), mbt)
                    return {}
                flint mn = mi[min]
                flint mx = mi[max]
                if len(bmargs) < mn OR len(bmargs) > mx:
                    str want = str(mn)
                    if mn != mx:
                        want = cat([str(mn), "..", str(mx)])
                    fail(st, mt, "ARGCOUNT_ERROR", cat([want, " argument(s) to '", mname, "'"]), cat([str(len(bmargs)), " argument(s)"]))
                    return {}
                flint ai2 = 0
                while ai2 < len(bmargs):
                    dict mma2 = bmargs[ai2]
                    str mspec = mi[a1]
                    if ai2 == 1:
                        mspec = mi[a2]
                    if mspec != "any" AND mma2[t] != "NONE" AND mma2[t] != "any" AND mma2[t] != mspec:
                        fail(st, {line: mma2[line], col: mma2[col]}, "TYPE_ERROR", cat(["argument ", str(ai2 + 1), " of '", mname, "' to be ", mspec]), mma2[t])
                        return {}
                    ai2 += 1
                e = {k: "method", base: e, name: mname, rt: mi[rt], args: bmargs, a1: mi[a1], a2: mi[a2], t: mi[ret], nullable: mi[nullable], line: mt[line], col: mt[col]}
        else:
            more = FALSE

    # инфиксные операторы
    more = TRUE
    while more:
        if st[err]:
            return {}
        dict it2 = tk(st)
        str nty = it2[type]
        if nty == "op":
            str op = it2[value]
            if is_compare(op):
                if 30 <= min_bp:
                    more = FALSE
                else:
                    list ops = []
                    list operands = [e]
                    bool go = TRUE
                    while go:
                        dict ot = tk(st)
                        if ot[type] == "op" AND is_compare(ot[value]):
                            advance(st)
                            dict rhs = parse_expr(st, 31)
                            if st[err]:
                                return {}
                            ops.add({op: ot[value], line: ot[line], col: ot[col]})
                            operands.add(rhs)
                        else:
                            go = FALSE
                    flint ci = 0
                    while ci < len(ops):
                        dict o = ops[ci]
                        dict oa = operands[ci]
                        dict ob = operands[ci + 1]
                        if o[op] != "==" AND o[op] != "!=":
                            str at = oa[t]
                            str btv = ob[t]
                            bool ok = (at == btv) AND (at == "flint" OR at == "str")
                            if NOT ok AND at != "NONE" AND btv != "NONE" AND at != "any" AND btv != "any":
                                fail(st, o, "TYPE_ERROR", cat(["comparable operands of '", o[op], "'"]), cat([at, " and ", btv]))
                                return {}
                        ci += 1
                    if len(ops) == 1:
                        dict o0 = ops[0]
                        e = {k: "bin", op: o0[op], a: operands[0], b: operands[1], t: "bool", line: o0[line], col: o0[col]}
                    else:
                        e = {k: "chain", ops: ops, operands: operands, t: "bool", line: e[line], col: e[col]}
            elif op == "OR" OR op == "AND":
                flint obp = 10
                if op == "AND":
                    obp = 20
                if obp <= min_bp:
                    more = FALSE
                else:
                    advance(st)
                    dict orhs = parse_expr(st, obp)
                    if st[err]:
                        return {}
                    e = {k: "bin", op: op, a: e, b: orhs, t: "bool", line: it2[line], col: it2[col]}
            elif op == "+" OR op == "-" OR op == "*" OR op == "/" OR op == "//" OR op == "%":
                flint abp = 40
                if op == "*" OR op == "/" OR op == "//" OR op == "%":
                    abp = 50
                if abp <= min_bp:
                    more = FALSE
                else:
                    advance(st)
                    dict arhs = parse_expr(st, abp)
                    if st[err]:
                        return {}
                    if op == "+" AND (e[t] == "str" OR arhs[t] == "str"):
                        fail(st, it2, "CONCATENATE_NOT_SUPPORT", "numeric operands of '+'", "str")
                        return {}
                    if NOT (is_numeric(e[t]) AND is_numeric(arhs[t])):
                        fail(st, it2, "TYPE_ERROR", cat(["operands of '", op, "' to be flint"]), cat([e[t], " and ", arhs[t]]))
                        return {}
                    e = {k: "bin", op: op, a: e, b: arhs, t: "flint", line: it2[line], col: it2[col]}
            elif op == "**":
                if 70 <= min_bp:
                    more = FALSE
                else:
                    advance(st)
                    dict prhs = parse_expr(st, 69)
                    if st[err]:
                        return {}
                    if NOT (is_numeric(e[t]) AND is_numeric(prhs[t])):
                        fail(st, it2, "TYPE_ERROR", "operands of '**' to be flint", cat([e[t], " and ", prhs[t]]))
                        return {}
                    e = {k: "bin", op: "**", a: e, b: prhs, t: "flint", line: it2[line], col: it2[col]}
            else:
                more = FALSE
        elif nty == "kw" AND (it2[value] == "OR" OR it2[value] == "AND"):
            str lop = it2[value]
            flint lbp = 10
            if lop == "AND":
                lbp = 20
            if lbp <= min_bp:
                more = FALSE
            else:
                advance(st)
                dict lrhs = parse_expr(st, lbp)
                if st[err]:
                    return {}
                e = {k: "bin", op: lop, a: e, b: lrhs, t: "bool", line: it2[line], col: it2[col]}
        elif nty == "kw" AND it2[value] == "is":
            if 30 <= min_bp:
                more = FALSE
            else:
                advance(st)
                str tn = parse_type_name(st)
                if st[err]:
                    return {}
                e = {k: "is", a: e, typename: tn, t: "bool", line: it2[line], col: it2[col]}
        else:
            more = FALSE

    return e
# ---------- парсер: операторы ----------

func stmt_is_decl(dict st) -> bool:
    dict t = tk(st)
    dict nx = token_at(st, st[pos] + 1)
    if t[type] == "name" AND is_model_type(st, t[value]):
        return nx[type] == "name"
    if t[type] != "kw":
        return FALSE
    str v = t[value]
    if NOT is_type_keyword(v):
        return FALSE
    if nx[type] == "op" AND nx[value] == "(" AND (v == "str" OR v == "flint"):
        return FALSE
    return TRUE

# Блок типов: `str:`, `flint:` и т.д. Отличается от обычного объявления
# двоеточием сразу после типа.
func stmt_is_decl_block(dict st) -> bool:
    dict t = tk(st)
    if t[type] != "kw":
        return FALSE
    if NOT is_type_keyword(t[value]):
        return FALSE
    dict nx = token_at(st, st[pos] + 1)
    return nx[type] == "op" AND nx[value] == ":"

# Куда пишет присваивание: в локальную (или верхнеуровневую) или в глобальную.
# В режиме # const-top верхний уровень — только объявления.
func resolve_write(dict st, dict tok, str n) -> dict:
    dict vars = st[vars]
    dict gv = st[gvars]
    if vars.contains(n):
        if is_const_name(n):
            fail(st, tok, "CONST_ERROR", "variable", cat(["constant '", n, "'"]))
            return {}
        if st[const_top] AND st[block_depth] == 0 AND gv.contains(n):
            fail(st, tok, "TOPLEVEL_ERROR", "assignment inside a nested block", cat(["assignment to top-level variable '", n, "'"]))
            return {}
        dict nm = st[names]
        return {kind: "local", type: vars.take(n), lua: nm.take(n)}
    if gv.contains(n):
        if is_const_name(n):
            fail(st, tok, "CONST_ERROR", "variable", cat(["constant '", n, "'"]))
            return {}
        dict nm2 = st[names]
        return {kind: "global", type: gv.take(n), lua: nm2.take(n)}
    fail(st, tok, "NAME_ERROR", "declared variable", cat(["name '", n, "' is not declared"]))
    return {}

# Объявление `имя = выражение` с заданным типом. Общее для обычного
# объявления и для строки внутри блока типов.
func parse_typed_decl(dict st, str dty, dict dname_tok) -> dict:
    str dname = dname_tok[value]
    if is_reserved(dname):
        fail(st, dname_tok, "NAME_ERROR", "free name", cat(["reserved '", dname, "'"]))
        return {}
    dict dvars = st[vars]
    dict dfuncs = st[funcs]
    if dvars.contains(dname) OR dfuncs.contains(dname):
        fail(st, dname_tok, "REDECLARE_ERROR", "unique name", cat(["name '", dname, "' is already declared"]))
        return {}
    if st[in_func]:
        dict dg = st[gvars]
        if dg.contains(dname):
            fail(st, dname_tok, "REDECLARE_ERROR", "local name", cat(["global '", dname, "' is already declared"]))
            return {}
    dict dctx = st[model_ctx]
    if NOT (dctx is NONE):
        dict dms = dctx[schema]
        dict dft = dms[field_types]
        dict dmeth = dms[methods]
        if dft.contains(dname) OR dmeth.contains(dname):
            fail(st, dname_tok, "REDECLARE_ERROR", "local name", cat(["model member '", dname, "'"]))
            return {}
    expect_tok(st, "op", "=", "'='")
    if st[err]:
        return {}
    dict dexpr = {}
    if is_model_type(st, dty) AND tok_is(tk(st), "kw", "init"):
        dict inittok = advance(st)
        expect_tok(st, "op", "(", "'('")
        dict ms = model_schema(st, dty)
        dict cons = ms[ctor]
        if cons is NONE:
            fail(st, inittok, "NAME_ERROR", cat(["declared construct of '", dty, "'"]), "model without construct")
            return {}
        list iparams = cons[params]
        dict iparm = {}
        flint ii = 0
        while ii < len(iparams):
            dict ipp = iparams[ii]
            iparm.add(ipp[name], TRUE)
            ii += 1
        list iargs = []
        dict iseen = {}
        if NOT tok_is(tk(st), "op", ")"):
            while TRUE:
                dict iat = expect_tok(st, "name", "", "init argument name")
                if st[err]:
                    return {}
                str ian = iat[value]
                if iseen.contains(ian):
                    fail(st, iat, "REDECLARE_ERROR", "unique init argument", cat(["duplicate '", ian, "'"]))
                    return {}
                iseen.add(ian, TRUE)
                expect_tok(st, "op", ":", "':'")
                dict iav = parse_expr(st, 0)
                if st[err]:
                    return {}
                bool iok = FALSE
                str iwant = "any"
                if iparm.contains(ian):
                    flint ij = 0
                    while ij < len(iparams):
                        dict ipj = iparams[ij]
                        if ipj[name] == ian:
                            iwant = ipj[type]
                            iok = TRUE
                        ij += 1
                else:
                    dict iinit = ms[init_fields]
                    dict ift = ms[field_types]
                    dict imf = ms[model_fields]
                    dict icons = ms[consts]
                    if iinit.contains(ian):
                        iwant = ift.take(ian)
                        iok = TRUE
                    elif imf.contains(ian) OR icons.contains(ian):
                        fail(st, iat, "CONST_ERROR", "init argument for a mutable field", cat(["read-only '", ian, "'"]))
                        return {}
                    elif ift.contains(ian):
                        fail(st, iat, "CONST_ERROR", "init argument for a computed field", cat(["field '", ian, "' is set from construct parameters"]))
                        return {}
                    else:
                        fail(st, iat, "NAME_ERROR", cat(["field or construct parameter of '", dty, "'"]), cat(["unknown '", ian, "'"]))
                        return {}
                if NOT assignable(iav[t], iwant):
                    fail(st, {line: iav[line], col: iav[col]}, "TYPE_ERROR", cat(["init argument '", ian, "': type ", iwant]), iav[t])
                    return {}
                iargs.add({name: ian, expr: iav, type: iwant})
                if tok_is(tk(st), "op", ","):
                    advance(st)
                else:
                    break
        expect_tok(st, "op", ")", "')'")
        if st[err]:
            return {}
        flint mi2 = 0
        while mi2 < len(iparams):
            dict ipm = iparams[mi2]
            str need = ipm[name]
            if NOT iseen.contains(need):
                fail(st, inittok, "ARGCOUNT_ERROR", cat(["argument '", need, "' in init"]), "missing")
                return {}
            mi2 += 1
        dexpr = {k: "model_init", mname: dty, args: iargs, t: dty, line: inittok[line], col: inittok[col]}
    else:
        dexpr = parse_expr(st, 0)
        if st[err]:
            return {}
        if NOT assignable(dexpr[t], dty):
            fail(st, {line: dexpr[line], col: dexpr[col]}, "TYPE_ERROR", cat(["declaration of '", dname, "': type ", dty]), dexpr[t])
            return {}
    str dlua = mangle_var(st, dname)
    dvars.add(dname, dty)
    # В # const-top любое объявление вне функции — глобальная («верх файла»).
    # Писать в неё можно только внутри вложенного блока (отступа).
    if st[const_top] AND NOT st[in_func]:
        dict dtg = st[gvars]
        dtg.add(dname, dty)
    dict dnl = st[nullable]
    if dexpr[t] == "NONE" OR e_nullable(dexpr):
        dnl.add(dname, TRUE)
    else:
        dnl.remove(dname)
    if st[block_depth] > 0:
        dict dmu = st[maybe_unset]
        dmu.add(dname, TRUE)
    return {k: "decl", type: dty, name: dname, lua: dlua, expr: dexpr, line: dname_tok[line], col: dname_tok[col]}

func snapshot_parser(dict st) -> dict:
    return {vars: st[vars], nullable: st[nullable], maybe_unset: st[maybe_unset], for_names: st[for_names], gvars: st[gvars], gnullable: st[gnullable], gmaybe: st[gmaybe], loop_depth: st[loop_depth], in_func: st[in_func], func_ret: st[func_ret], func_returns: st[func_returns], model_ctx: st[model_ctx]}

func restore_parser(dict st, dict sv):
    st.add("vars", sv[vars])
    st.add("nullable", sv[nullable])
    st.add("maybe_unset", sv[maybe_unset])
    st.add("for_names", sv[for_names])
    st.add("gvars", sv[gvars])
    st.add("gnullable", sv[gnullable])
    st.add("gmaybe", sv[gmaybe])
    st.add("loop_depth", sv[loop_depth])
    st.add("in_func", sv[in_func])
    st.add("func_ret", sv[func_ret])
    st.add("func_returns", sv[func_returns])
    st.add("model_ctx", sv[model_ctx])

# Заголовок модели: поле до construct. Тело не разбирает.
func parse_model_field_decl(dict st, dict m) -> dict:
    str mfty = advance(st)[value]
    dict mfnt = expect_tok(st, "name", "", "field name")
    if st[err]:
        return {}
    str mfname = mfnt[value]
    check_field_name(st, mfnt, mfname)
    if st[err]:
        return {}
    dict mf = m[model_fields]
    dict ft = m[field_types]
    dict meth = m[methods]
    if mf.contains(mfname) OR ft.contains(mfname) OR meth.contains(mfname):
        fail(st, mfnt, "REDECLARE_ERROR", "unique field name", cat(["name '", mfname, "' is already declared"]))
        return {}
    expect_tok(st, "op", "=", "'='")
    dict sv = st[model_ctx]
    st.add("model_ctx", NONE)
    dict mfexpr = parse_expr(st, 0)
    st.add("model_ctx", sv)
    if st[err]:
        return {}
    if NOT assignable(mfexpr[t], mfty):
        fail(st, {line: mfexpr[line], col: mfexpr[col]}, "TYPE_ERROR", cat(["field '", mfname, "': type ", mfty]), mfexpr[t])
        return {}
    mf.add(mfname, mfty)
    ft.add(mfname, mfty)
    list mo = m[order]
    mo.add(mfname)
    list fo = m[field_order]
    fo.add(mfname)
    return {name: mfname, type: mfty, expr: mfexpr, line: mfnt[line], col: mfnt[col]}

# Параметры construct (construct=TRUE) или метода. Скобки уже открыты.
func parse_model_params(dict st, dict m, bool is_cons) -> list:
    list out = []
    if NOT tok_is(tk(st), "op", ")"):
        while TRUE:
            dict pty_tok = tk(st)
            str pty = parse_type_name(st)
            if st[err]:
                return out
            if pty == "NONE":
                fail(st, pty_tok, "TYPE_ERROR", "parameter type", "NONE")
                return out
            dict pnt = expect_tok(st, "name", "", "parameter name")
            if st[err]:
                return out
            str pnm = pnt[value]
            if is_reserved(pnm) OR is_const_name(pnm):
                fail(st, pnt, "NAME_ERROR", "free parameter name", cat(["reserved '", pnm, "'"]))
                return out
            dict mf = m[model_fields]
            dict ft = m[field_types]
            dict meth = m[methods]
            if mf.contains(pnm) OR meth.contains(pnm) OR (NOT is_cons AND ft.contains(pnm)):
                fail(st, pnt, "REDECLARE_ERROR", "parameter name", cat(["model member '", pnm, "'"]))
                return out
            flint pi = 0
            while pi < len(out):
                dict po = out[pi]
                if po[name] == pnm:
                    fail(st, pnt, "REDECLARE_ERROR", "unique parameter name", cat(["duplicate '", pnm, "'"]))
                    return out
                pi += 1
            out.add({name: pnm, type: pty, line: pnt[line], col: pnt[col]})
            if tok_is(tk(st), "op", ","):
                advance(st)
            else:
                break
    expect_tok(st, "op", ")", "')'")
    return out

func parse_construct_header(dict st, dict m) -> dict:
    advance(st)
    expect_tok(st, "op", "(", "'('")
    list params = parse_model_params(st, m, TRUE)
    if st[err]:
        return {}
    expect_tok(st, "op", ":", "':'")
    if st[err]:
        return {}
    m.add("ctor", {params: params, body: []})
    list mparams = m[params]
    dict mptypes = m[param_types]
    for p0 in params:
        dict p = p0
        mparams.add(p[name])
        mptypes.add(p[name], p[type])
    dict mctx = {model_name: m[name], schema: m, in_construct: TRUE, level: st[block_depth] + 1, self_seen: FALSE, self_done: FALSE, param_set: {}}
    dict ps = mctx[param_set]
    for p1 in params:
        dict p1d = p1
        ps.add(p1d[name], TRUE)
    return {params: params, mctx: mctx}

func parse_method_header(dict st, dict m) -> dict:
    advance(st)
    dict mtok = expect_tok(st, "name", "", "method name")
    if st[err]:
        return {}
    str mn = mtok[value]
    if is_reserved(mn) OR is_const_name(mn):
        fail(st, mtok, "NAME_ERROR", "free method name", cat(["reserved '", mn, "'"]))
        return {}
    dict mf = m[model_fields]
    dict ft = m[field_types]
    dict meth = m[methods]
    if ft.contains(mn) OR mf.contains(mn) OR meth.contains(mn):
        fail(st, mtok, "REDECLARE_ERROR", "unique method name", cat(["name '", mn, "' is already declared"]))
        return {}
    expect_tok(st, "op", "(", "'('")
    list params = parse_model_params(st, m, FALSE)
    if st[err]:
        return {}
    str mret = "NONE"
    bool mhas = FALSE
    if tok_is(tk(st), "op", "->"):
        advance(st)
        dict mrt = tk(st)
        mret = parse_type_name(st)
        if st[err]:
            return {}
        if mret == "NONE":
            fail(st, mrt, "SYNTAX_ERROR", "return type (omit '->' for NONE)", "NONE")
            return {}
        mhas = TRUE
    expect_tok(st, "op", ":", "':'")
    if st[err]:
        return {}
    dict info = {params: params, ret: NONE, ret_nullable: FALSE, inferring: TRUE}
    if mhas:
        info.add("ret", mret)
    meth.add(mn, info)
    list mo = m[method_order]
    mo.add(mn)
    return {name: mn, info: info, params: params, ret: mret, has_ret: mhas, line: mtok[line], col: mtok[col]}

func finish_method(dict st, dict info, list body, str declared, bool has_ret, list rets):
    bool fall = TRUE
    if len(body) > 0:
        dict last = body[len(body) - 1]
        if last[k] == "return":
            fall = FALSE
    bool nullable = fall
    str seen = ""
    flint ri = 0
    while ri < len(rets):
        dict rr = rets[ri]
        if rr[empty] OR rr[type] == "NONE" OR e_nullable(rr):
            nullable = TRUE
        elif has_ret:
            if rr[type] != declared AND rr[type] != "any":
                fail(st, rr, "TYPE_ERROR", cat(["return type ", declared]), rr[type])
                return:
        else:
            if seen != "" AND seen != rr[type]:
                fail(st, rr, "TYPE_ERROR", "all returns of a method to have one type", cat([seen, " and ", rr[type]]))
                return:
            seen = rr[type]
        ri += 1
    str final = declared
    if NOT has_ret:
        final = seen
        if final == "":
            final = "NONE"
    info.add("ret", final)
    info.add("ret_nullable", nullable)
    info.add("inferring", FALSE)
    info.add("body", body)

# Разбирает блок. top=TRUE — весь файл до eof; top=FALSE — после ':'.
# Рекурсивна: тела if/while/for/func разбираются ею же.
func parse_block(dict st, bool top) -> list:
    list stmts = []
    if NOT top:
        expect_tok(st, "newline", "", "end of line after ':'")
        expect_tok(st, "indent", "", "indented block")
        st.add("block_depth", st[block_depth] + 1)
    bool going = TRUE
    while going:
        dict t = tk(st)
        if st[err]:
            return stmts
        bool skip = FALSE
        if top:
            if t[type] == "eof":
                going = FALSE
                skip = TRUE
            elif t[type] == "newline" OR t[type] == "dedent":
                advance(st)
                skip = TRUE
            elif t[type] == "indent":
                fail(st, t, "SYNTAX_ERROR", "statement", "unexpected indent")
                return stmts
        else:
            if t[type] == "dedent" OR t[type] == "eof":
                going = FALSE
                skip = TRUE
            elif t[type] == "newline":
                advance(st)
                skip = TRUE
        if going AND NOT skip:
            dict node = {}
            bool block_stmt = FALSE
            bool decl_block = FALSE
            if stmt_is_decl_block(st):
                dict dbtok = advance(st)
                str dbty = dbtok[value]
                advance(st)
                expect_tok(st, "newline", "", "end of line after ':'")
                expect_tok(st, "indent", "", "indented block")
                if st[err]:
                    return stmts
                flint dcount = 0
                bool dbgoing = TRUE
                while dbgoing:
                    dict dbt = tk(st)
                    if st[err]:
                        return stmts
                    if dbt[type] == "dedent" OR dbt[type] == "eof":
                        dbgoing = FALSE
                    elif dbt[type] == "newline":
                        advance(st)
                    else:
                        dict dbnt = expect_tok(st, "name", "", "variable name")
                        if st[err]:
                            return stmts
                        dict dbdecl = parse_typed_decl(st, dbty, dbnt)
                        if st[err]:
                            return stmts
                        stmts.add(dbdecl)
                        dcount += 1
                        dict dbnxt = tk(st)
                        if dbnxt[type] == "newline":
                            advance(st)
                        elif dbnxt[type] != "dedent":
                            fail(st, dbnxt, "SYNTAX_ERROR", "end of line", describe_tok(dbnxt))
                            return stmts
                if tk(st)[type] == "dedent":
                    advance(st)
                if dcount == 0:
                    fail(st, dbtok, "SYNTAX_ERROR", "declaration inside type block", "empty block")
                    return stmts
                decl_block = TRUE
            elif stmt_is_decl(st):
                str dty = advance(st)[value]
                dict dname_tok = expect_tok(st, "name", "", "variable name")
                if st[err]:
                    return stmts
                node = parse_typed_decl(st, dty, dname_tok)
                if st[err]:
                    return stmts
            elif t[type] == "kw" AND t[value] == "if":
                dict iftok = advance(st)
                list branches = []
                dict cond = parse_expr(st, 0)
                expect_tok(st, "op", ":", "':'")
                list ibody = parse_block(st, FALSE)
                branches.add({cond: cond, body: ibody})
                while tok_is(tk(st), "kw", "elif"):
                    advance(st)
                    dict c2 = parse_expr(st, 0)
                    expect_tok(st, "op", ":", "':'")
                    list b2 = parse_block(st, FALSE)
                    branches.add({cond: c2, body: b2})
                node = {k: "if", branches: branches, block_stmt: TRUE, line: iftok[line], col: iftok[col]}
                if tok_is(tk(st), "kw", "else"):
                    advance(st)
                    expect_tok(st, "op", ":", "':'")
                    list eb = parse_block(st, FALSE)
                    node.add("else_body", eb)
                block_stmt = TRUE
            elif t[type] == "kw" AND t[value] == "while":
                dict wtok = advance(st)
                dict wcond = parse_expr(st, 0)
                expect_tok(st, "op", ":", "':'")
                st.add("loop_depth", st[loop_depth] + 1)
                list wbody = parse_block(st, FALSE)
                st.add("loop_depth", st[loop_depth] - 1)
                node = {k: "while", cond: wcond, body: wbody, block_stmt: TRUE, line: wtok[line], col: wtok[col]}
                block_stmt = TRUE
            elif t[type] == "kw" AND t[value] == "for":
                dict ftok = advance(st)
                list nts = []
                dict nt1 = expect_tok(st, "name", "", "loop variable")
                nts.add(nt1)
                if tok_is(tk(st), "op", ","):
                    advance(st)
                    dict nt2 = expect_tok(st, "name", "", "loop variable")
                    nts.add(nt2)
                if tok_is(tk(st), "kw", "in"):
                    advance(st)
                    dict coll = parse_expr(st, 0)
                    if st[err]:
                        return stmts
                    list ftypes = []
                    str cty = coll[t]
                    if cty == "list":
                        if len(nts) != 1:
                            fail(st, nts[1], "TYPE_ERROR", "one loop variable for a list", "two variables")
                            return stmts
                        ftypes.add("any")
                    elif cty == "dict":
                        if len(nts) != 2:
                            fail(st, nts[0], "TYPE_ERROR", "two loop variables for a dict (key, value)", "one variable")
                            return stmts
                        ftypes.add("str")
                        ftypes.add("any")
                    elif cty == "any":
                        if len(nts) == 1:
                            ftypes.add("any")
                        else:
                            ftypes.add("str")
                            ftypes.add("any")
                    else:
                        fail(st, ftok, "TYPE_ERROR", "list or dict after 'in'", cty)
                        return stmts
                    list fnames_k = []
                    list fnames_l = []
                    flint ni = 0
                    while ni < len(nts):
                        dict ntx = nts[ni]
                        str nm = ntx[value]
                        if is_const_name(nm):
                            fail(st, ntx, "CONST_ERROR", "variable", cat(["constant '", nm, "'"]))
                            return stmts
                        if is_reserved(nm):
                            fail(st, ntx, "NAME_ERROR", "free name", cat(["reserved '", nm, "'"]))
                            return stmts
                        dict fvars = st[vars]
                        dict ffor = st[for_names]
                        dict fgv = st[gvars]
                        if fvars.contains(nm) OR ffor.contains(nm) OR fgv.contains(nm):
                            fail(st, ntx, "REDECLARE_ERROR", "unique loop variable", cat(["name '", nm, "' is already declared"]))
                            return stmts
                        fvars.add(nm, ftypes[ni])
                        ffor.add(nm, TRUE)
                        fnames_k.add(nm)
                        fnames_l.add(mangle_var(st, nm))
                        ni += 1
                    expect_tok(st, "op", ":", "':'")
                    st.add("loop_depth", st[loop_depth] + 1)
                    list fibody = parse_block(st, FALSE)
                    st.add("loop_depth", st[loop_depth] - 1)
                    flint rj = 0
                    while rj < len(fnames_k):
                        dict fvars2 = st[vars]
                        fvars2.remove(fnames_k[rj])
                        rj += 1
                    node = {k: "for_in", names: fnames_k, lnames: fnames_l, coll: coll, body: fibody, block_stmt: TRUE, line: ftok[line], col: ftok[col]}
                    block_stmt = TRUE
                else:
                    if len(nts) != 1:
                        fail(st, nts[1], "SYNTAX_ERROR", "one loop variable for a numeric range", "two variables")
                        return stmts
                    dict rnt = nts[0]
                    str rname = rnt[value]
                    if is_const_name(rname):
                        fail(st, rnt, "CONST_ERROR", "variable", cat(["constant '", rname, "'"]))
                        return stmts
                    if is_reserved(rname):
                        fail(st, rnt, "NAME_ERROR", "free name", cat(["reserved '", rname, "'"]))
                        return stmts
                    dict rvars = st[vars]
                    dict rfor = st[for_names]
                    dict rgv = st[gvars]
                    if rvars.contains(rname) OR rfor.contains(rname) OR rgv.contains(rname):
                        fail(st, rnt, "REDECLARE_ERROR", "unique loop variable", cat(["name '", rname, "' is already declared"]))
                        return stmts
                    rvars.add(rname, "flint")
                    rfor.add(rname, TRUE)
                    str rlua = mangle_var(st, rname)
                    dict first = parse_expr(st, 0)
                    if st[err]:
                        return stmts
                    if NOT is_numeric(first[t]):
                        fail(st, first, "TYPE_ERROR", "loop bound to be flint", first[t])
                        return stmts
                    dict ftnode = {k: "for", name: rname, lua: rlua, line: ftok[line], col: ftok[col]}
                    if tok_is(tk(st), "op", ".."):
                        advance(st)
                        dict last = parse_expr(st, 0)
                        if st[err]:
                            return stmts
                        if NOT is_numeric(last[t]):
                            fail(st, last, "TYPE_ERROR", "loop bound to be flint", last[t])
                            return stmts
                        ftnode.add("form", "range")
                        ftnode.add("from", first)
                        ftnode.add("to", last)
                        if tok_is(tk(st), "op", ".."):
                            advance(st)
                            dict step = parse_expr(st, 0)
                            if st[err]:
                                return stmts
                            if NOT is_numeric(step[t]):
                                fail(st, step, "TYPE_ERROR", "loop step to be flint", step[t])
                                return stmts
                            ftnode.add("step", step)
                    else:
                        ftnode.add("form", "upto")
                        ftnode.add("to", first)
                    expect_tok(st, "op", ":", "':'")
                    st.add("loop_depth", st[loop_depth] + 1)
                    list rbody = parse_block(st, FALSE)
                    st.add("loop_depth", st[loop_depth] - 1)
                    dict rvars2 = st[vars]
                    rvars2.remove(rname)
                    ftnode.add("body", rbody)
                    ftnode.add("block_stmt", TRUE)
                    node = ftnode
                    block_stmt = TRUE
            elif t[type] == "kw" AND t[value] == "func":
                dict funtok = advance(st)
                if st[in_func] OR st[block_depth] > 0:
                    fail(st, funtok, "SYNTAX_ERROR", "function at top level", "nested function")
                    return stmts
                dict fntok = expect_tok(st, "name", "", "function name")
                str fn_name = fntok[value]
                if is_reserved(fn_name):
                    fail(st, fntok, "NAME_ERROR", "free name", cat(["reserved '", fn_name, "'"]))
                    return stmts
                if is_const_name(fn_name):
                    fail(st, fntok, "CONST_ERROR", "function name", cat(["constant '", fn_name, "'"]))
                    return stmts
                dict gvars = st[vars]
                dict gfuncs = st[funcs]
                if gfuncs.contains(fn_name) OR gvars.contains(fn_name):
                    fail(st, fntok, "REDECLARE_ERROR", "unique name", cat(["name '", fn_name, "' is already declared"]))
                    return stmts
                expect_tok(st, "op", "(", "'('")
                list params = []
                if NOT tok_is(tk(st), "op", ")"):
                    while TRUE:
                        dict pty_tok = tk(st)
                        str pty = parse_type_name(st)
                        if st[err]:
                            return stmts
                        if pty == "NONE":
                            fail(st, pty_tok, "TYPE_ERROR", "parameter type", "NONE")
                            return stmts
                        dict pn = expect_tok(st, "name", "", "parameter name")
                        str pnm = pn[value]
                        if is_reserved(pnm):
                            fail(st, pn, "NAME_ERROR", "free name", cat(["reserved '", pnm, "'"]))
                            return stmts
                        dict pgv = st[vars]
                        if pgv.contains(pnm):
                            fail(st, pn, "REDECLARE_ERROR", "parameter name", cat(["global '", pnm, "' is already declared"]))
                            return stmts
                        flint di = 0
                        while di < len(params):
                            dict pp0 = params[di]
                            if pp0[name] == pnm:
                                fail(st, pn, "REDECLARE_ERROR", "unique parameter name", cat(["duplicate '", pnm, "'"]))
                                return stmts
                            di += 1
                        params.add({name: pnm, type: pty, line: pn[line], col: pn[col]})
                        if tok_is(tk(st), "op", ","):
                            advance(st)
                        else:
                            break
                expect_tok(st, "op", ")", "')'")
                str fret = "NONE"
                bool fhas_ret = FALSE
                if tok_is(tk(st), "op", "->"):
                    advance(st)
                    dict rtok = tk(st)
                    fret = parse_type_name(st)
                    if st[err]:
                        return stmts
                    if fret == "NONE":
                        fail(st, rtok, "SYNTAX_ERROR", "return type (omit '->' for NONE)", "NONE")
                        return stmts
                    fhas_ret = TRUE
                expect_tok(st, "op", ":", "':'")
                dict fninfo = {params: params, ret: NONE, ret_nullable: FALSE, inferring: TRUE}
                if fhas_ret:
                    fninfo.add("ret", fret)
                gfuncs.add(fn_name, fninfo)
                str flua = mangle_func(st, fn_name)
                dict sv_vars = st[vars]
                dict sv_nullable = st[nullable]
                dict sv_maybe = st[maybe_unset]
                dict sv_for = st[for_names]
                dict sv_gvars = st[gvars]
                dict sv_gnullable = st[gnullable]
                dict sv_gmaybe = st[gmaybe]
                flint sv_loop = st[loop_depth]
                bool sv_in = st[in_func]
                str sv_ret = st[func_ret]
                list sv_returns = st[func_returns]
                st.add("gvars", st[vars])
                st.add("gnullable", st[nullable])
                st.add("gmaybe", st[maybe_unset])
                st.add("vars", {})
                st.add("nullable", {})
                st.add("maybe_unset", {})
                st.add("for_names", {})
                st.add("loop_depth", 0)
                st.add("in_func", TRUE)
                st.add("func_ret", fret)
                st.add("func_returns", [])
                flint pj = 0
                while pj < len(params):
                    dict pj_p = params[pj]
                    pj_p.add("lua", mangle_var(st, pj_p[name]))
                    dict nv = st[vars]
                    nv.add(pj_p[name], pj_p[type])
                    pj += 1
                list fnbody = parse_block(st, FALSE)
                list frets = st[func_returns]
                st.add("vars", sv_vars)
                st.add("nullable", sv_nullable)
                st.add("maybe_unset", sv_maybe)
                st.add("for_names", sv_for)
                st.add("gvars", sv_gvars)
                st.add("gnullable", sv_gnullable)
                st.add("gmaybe", sv_gmaybe)
                st.add("loop_depth", sv_loop)
                st.add("in_func", sv_in)
                st.add("func_ret", sv_ret)
                st.add("func_returns", sv_returns)
                bool fallthrough = TRUE
                if len(fnbody) > 0:
                    dict last_stmt = fnbody[len(fnbody) - 1]
                    if last_stmt[k] == "return":
                        fallthrough = FALSE
                bool fnullable = fallthrough
                str seen = ""
                flint ri = 0
                while ri < len(frets):
                    dict rr = frets[ri]
                    if rr[empty] OR rr[type] == "NONE" OR e_nullable(rr):
                        fnullable = TRUE
                    elif fhas_ret:
                        if rr[type] != fret AND rr[type] != "any":
                            fail(st, rr, "TYPE_ERROR", cat(["return type ", fret]), rr[type])
                            return stmts
                    else:
                        if seen != "" AND seen != rr[type]:
                            fail(st, rr, "TYPE_ERROR", cat(["all returns of '", fn_name, "' to have one type"]), cat([seen, " and ", rr[type]]))
                            return stmts
                        seen = rr[type]
                    ri += 1
                str final_ret = fret
                if NOT fhas_ret:
                    final_ret = seen
                    if final_ret == "":
                        final_ret = "NONE"
                fninfo.add("ret", final_ret)
                fninfo.add("ret_nullable", fnullable)
                fninfo.add("inferring", FALSE)
                node = {k: "func", name: fn_name, lua: flua, params: params, ret: final_ret, body: fnbody, block_stmt: TRUE, line: funtok[line], col: funtok[col]}
                block_stmt = TRUE
            elif t[type] == "kw" AND t[value] == "model":
                dict mtok = advance(st)
                if st[in_func] OR st[block_depth] > 0:
                    fail(st, mtok, "SCOPE_ERROR", "model at top level", "nested model")
                    return stmts
                dict mnt = expect_tok(st, "name", "", "model name")
                if st[err]:
                    return stmts
                str mname = mnt[value]
                if is_reserved(mname) OR is_const_name(mname):
                    fail(st, mnt, "NAME_ERROR", "free model name", cat(["reserved '", mname, "'"]))
                    return stmts
                dict mall = st[models]
                dict mgv = st[vars]
                dict mfnc = st[funcs]
                if mall.contains(mname) OR mgv.contains(mname) OR mfnc.contains(mname):
                    fail(st, mnt, "REDECLARE_ERROR", "unique model name", cat(["name '", mname, "' is already declared"]))
                    return stmts
                dict mschema = {name: mname, model_fields: {}, field_types: {}, consts: {}, init_fields: {}, params: [], param_types: {}, methods: {}, method_order: [], ctor: NONE, order: [], field_order: []}
                mall.add(mname, mschema)
                expect_tok(st, "op", ":", "':'")
                expect_tok(st, "newline", "", "end of line after ':'")
                expect_tok(st, "indent", "", "indented block")
                if st[err]:
                    return stmts
                list mfield_nodes = []
                bool mseen_construct = FALSE
                bool mseen_method = FALSE
                bool mgoing = TRUE
                while mgoing:
                    dict mbt = tk(st)
                    if st[err]:
                        return stmts
                    if mbt[type] == "dedent" OR mbt[type] == "eof":
                        mgoing = FALSE
                    elif mbt[type] == "newline":
                        advance(st)
                    elif mbt[type] == "kw" AND mbt[value] == "construct":
                        if mseen_construct:
                            fail(st, mbt, "REDECLARE_ERROR", "one construct per model", "second construct")
                            return stmts
                        if mseen_method:
                            fail(st, mbt, "SYNTAX_ERROR", "construct before methods", "construct after method")
                            return stmts
                        dict mch = parse_construct_header(st, mschema)
                        if st[err]:
                            return stmts
                        list mparams = mch[params]
                        dict mctx = mch[mctx]
                        dict sv = snapshot_parser(st)
                        st.add("gvars", st[vars])
                        st.add("gnullable", st[nullable])
                        st.add("gmaybe", st[maybe_unset])
                        st.add("vars", {})
                        st.add("nullable", {})
                        st.add("maybe_unset", {})
                        st.add("for_names", {})
                        st.add("loop_depth", 0)
                        st.add("in_func", TRUE)
                        st.add("func_ret", "NONE")
                        st.add("func_returns", [])
                        st.add("model_ctx", mctx)
                        for p0 in mparams:
                            dict p = p0
                            p.add("lua", mangle_var(st, p[name]))
                            dict pv = st[vars]
                            pv.add(p[name], p[type])
                        list mbody = parse_block(st, FALSE)
                        restore_parser(st, sv)
                        if st[err]:
                            return stmts
                        if NOT mctx[self_seen]:
                            fail(st, mtok, "SYNTAX_ERROR", "self(...) as the first statement of construct", "missing self(...)")
                            return stmts
                        dict mcons = mschema[ctor]
                        mcons.add("body", mbody)
                        mseen_construct = TRUE
                    elif mbt[type] == "kw" AND mbt[value] == "method":
                        if NOT mseen_construct:
                            fail(st, mbt, "SYNTAX_ERROR", "construct before methods", "method before construct")
                            return stmts
                        dict mmh = parse_method_header(st, mschema)
                        if st[err]:
                            return stmts
                        dict mctx2 = {model_name: mname, schema: mschema, in_construct: FALSE, level: 0, self_seen: TRUE, self_done: TRUE, param_set: {}}
                        dict sv2 = snapshot_parser(st)
                        st.add("gvars", st[vars])
                        st.add("gnullable", st[nullable])
                        st.add("gmaybe", st[maybe_unset])
                        st.add("vars", {})
                        st.add("nullable", {})
                        st.add("maybe_unset", {})
                        st.add("for_names", {})
                        st.add("loop_depth", 0)
                        st.add("in_func", TRUE)
                        st.add("func_ret", mmh[ret])
                        st.add("func_returns", [])
                        st.add("model_ctx", mctx2)
                        list mparams2 = mmh[params]
                        for p3 in mparams2:
                            dict p3d = p3
                            p3d.add("lua", mangle_var(st, p3d[name]))
                            dict pv2 = st[vars]
                            pv2.add(p3d[name], p3d[type])
                        list mbody2 = parse_block(st, FALSE)
                        list mrets = st[func_returns]
                        restore_parser(st, sv2)
                        if st[err]:
                            return stmts
                        finish_method(st, mmh[info], mbody2, mmh[ret], mmh[has_ret], mrets)
                        if st[err]:
                            return stmts
                        mseen_method = TRUE
                    elif mbt[type] == "kw" AND is_scalar_type(mbt[value]):
                        if mseen_construct OR mseen_method:
                            fail(st, mbt, "SYNTAX_ERROR", "model fields before construct", "field after construct")
                            return stmts
                        dict mfnode = parse_model_field_decl(st, mschema)
                        if st[err]:
                            return stmts
                        mfield_nodes.add(mfnode)
                        dict mfnx = tk(st)
                        if mfnx[type] == "newline":
                            advance(st)
                        elif mfnx[type] != "dedent":
                            fail(st, mfnx, "SYNTAX_ERROR", "end of line", describe_tok(mfnx))
                            return stmts
                    else:
                        fail(st, mbt, "SYNTAX_ERROR", "model field, construct or method", describe_tok(mbt))
                        return stmts
                if tk(st)[type] == "dedent":
                    advance(st)
                if NOT mseen_construct:
                    fail(st, mtok, "SYNTAX_ERROR", "construct in model", "missing construct")
                    return stmts
                node = {k: "model", name: mname, schema: mschema, fields: mfield_nodes, line: mtok[line], col: mtok[col]}
                block_stmt = TRUE
            elif t[type] == "kw" AND t[value] == "return":
                dict rtok2 = advance(st)
                if NOT st[in_func]:
                    fail(st, rtok2, "SCOPE_ERROR", "'return' inside a function", "'return' at top level")
                    return stmts
                dict rexpr = {}
                bool has_expr = FALSE
                if tok_is(tk(st), "op", ":"):
                    advance(st)
                else:
                    rexpr = parse_expr(st, 0)
                    if st[err]:
                        return stmts
                    has_expr = TRUE
                list cur_rets = st[func_returns]
                if has_expr:
                    cur_rets.add({empty: FALSE, type: rexpr[t], nullable: e_nullable(rexpr), line: rtok2[line], col: rtok2[col]})
                    node = {k: "return", expr: rexpr, line: rtok2[line], col: rtok2[col]}
                else:
                    cur_rets.add({empty: TRUE, type: "NONE", nullable: FALSE, line: rtok2[line], col: rtok2[col]})
                    node = {k: "return", line: rtok2[line], col: rtok2[col]}
            elif t[type] == "kw" AND (t[value] == "break" OR t[value] == "continue"):
                dict btok = advance(st)
                if st[loop_depth] == 0:
                    fail(st, btok, "SCOPE_ERROR", "'break' or 'continue' inside a loop", cat(["'", btok[value], "' outside a loop"]))
                    return stmts
                node = {k: btok[value], line: btok[line], col: btok[col]}
            elif t[type] == "name" AND NOT is_template_func(t[value]) AND peek_value(st) == "=":
                dict atok = advance(st)
                str aname = atok[value]
                dict aw = resolve_write(st, atok, aname)
                if st[err]:
                    return stmts
                advance(st)
                dict aexpr = parse_expr(st, 0)
                if st[err]:
                    return stmts
                str avt = aw[type]
                if NOT assignable(aexpr[t], avt):
                    fail(st, {line: aexpr[line], col: aexpr[col]}, "TYPE_ERROR", cat(["assignment to '", aname, "': type ", avt]), aexpr[t])
                    return stmts
                dict anl = st[nullable]
                if aw[kind] == "global":
                    anl = st[gnullable]
                if aexpr[t] == "NONE" OR e_nullable(aexpr):
                    anl.add(aname, TRUE)
                else:
                    anl.remove(aname)
                node = {k: "assign", name: aname, lua: aw[lua], expr: aexpr, type: avt, line: atok[line], col: atok[col]}
            elif t[type] == "name" AND NOT is_template_func(t[value]) AND is_compound(peek_value(st)):
                dict ctok = advance(st)
                str cname = ctok[value]
                dict cw = resolve_write(st, ctok, cname)
                if st[err]:
                    return stmts
                dict cop_tok = advance(st)
                str cop_full = cop_tok[value]
                str cop = cop_full[..len(cop_full) - 1]
                dict cexpr = parse_expr(st, 0)
                if st[err]:
                    return stmts
                str cvt = cw[type]
                if cvt != "flint" OR NOT is_numeric(cexpr[t]):
                    fail(st, cop_tok, "TYPE_ERROR", cat(["numeric operands of '", cop_full, "'"]), cexpr[t])
                    return stmts
                bool cmaybe = FALSE
                if cw[kind] == "global":
                    dict cgnl = st[gnullable]
                    dict cgmu = st[gmaybe]
                    if cgnl.contains(cname):
                        cmaybe = TRUE
                    if cgmu.contains(cname):
                        cmaybe = TRUE
                    cgnl.remove(cname)
                else:
                    dict cnl = st[nullable]
                    dict cmu = st[maybe_unset]
                    if cnl.contains(cname):
                        cmaybe = TRUE
                    if cmu.contains(cname):
                        cmaybe = TRUE
                    cnl.remove(cname)
                node = {k: "compound", name: cname, lua: cw[lua], op: cop, expr: cexpr, nullable: cmaybe, line: ctok[line], col: ctok[col]}
            else:
                dict e = parse_expr(st, 0)
                if st[err]:
                    return stmts
                if e[k] == "self_init":
                    dict sctx = st[model_ctx]
                    if sctx is NONE OR NOT sctx[in_construct]:
                        fail(st, e, "SCOPE_ERROR", "self(...) in construct", "self(...) outside construct")
                        return stmts
                    if st[block_depth] != sctx[level] OR len(stmts) != 0:
                        fail(st, e, "SYNTAX_ERROR", "self(...) as the first statement of construct", "nested or later self(...)")
                        return stmts
                    if sctx[self_seen]:
                        fail(st, e, "REDECLARE_ERROR", "one self(...) per construct", "second self(...)")
                        return stmts
                    list sargs = e[names]
                    dict ssch = sctx[schema]
                    dict scons = ssch[ctor]
                    list sps = []
                    if NOT (scons is NONE):
                        sps = scons[params]
                    flint slast = -1
                    list sfields = []
                    flint si = 0
                    while si < len(sargs):
                        dict sat = sargs[si]
                        str san = sat[value]
                        flint sfound = -1
                        flint sj = 0
                        while sj < len(sps):
                            dict ssp = sps[sj]
                            if ssp[name] == san:
                                sfound = sj
                            sj += 1
                        if sfound < 0:
                            fail(st, sat, "NAME_ERROR", "construct parameter in self(...)", cat(["unknown '", san, "'"]))
                            return stmts
                        if sfound <= slast:
                            fail(st, sat, "SYNTAX_ERROR", "construct parameters in declaration order", cat(["out of order '", san, "'"]))
                            return stmts
                        slast = sfound
                        dict sp = sps[sfound]
                        add_model_field(st, sctx[schema], sat, san, sp[type], FALSE)
                        if st[err]:
                            return stmts
                        sfields.add({name: san, type: sp[type], lua: sp[lua], line: sat[line], col: sat[col]})
                        si += 1
                    sctx.add("self_seen", TRUE)
                    sctx.add("self_done", TRUE)
                    node = {k: "self_init", fields: sfields, line: e[line], col: e[col]}
                elif tok_is(tk(st), "op", "="):
                    str ek = e[k]
                    if ek == "field":
                        dict fb = e[base]
                        dict fschema = model_schema(st, e[mname])
                        str fld = e[name]
                        dict mctx6 = st[model_ctx]
                        bool in_con = FALSE
                        if NOT (mctx6 is NONE) AND mctx6[in_construct] AND fb[k] == "var" AND fb[name] == "self":
                            if st[block_depth] == mctx6[level]:
                                in_con = TRUE
                        if e[model_field]:
                            fail(st, e, "CONST_ERROR", "mutable field", cat(["model field '", fld, "' is read-only"]))
                            return stmts
                        if e[is_const]:
                            fail(st, e, "CONST_ERROR", "mutable field", cat(["constant '", fld, "' is read-only"]))
                            return stmts
                        dict ftypes6 = fschema[field_types]
                        if NOT ftypes6.contains(fld):
                            if NOT in_con OR NOT mctx6[self_done]:
                                fail(st, e, "NAME_ERROR", cat(["declared field of '", e[mname], "'"]), cat(["unknown '", fld, "'"]))
                                return stmts
                            dict mctx6ps = mctx6[param_set]
                            if mctx6ps.contains(fld):
                                fail(st, e, "REDECLARE_ERROR", "new field name", cat(["construct parameter '", fld, "'"]))
                                return stmts
                            dict mcvar = st[vars]
                            if mcvar.contains(fld):
                                fail(st, e, "REDECLARE_ERROR", "new field name", cat(["local '", fld, "'"]))
                                return stmts
                        dict eq = advance(st)
                        dict fexpr = parse_expr(st, 0)
                        if st[err]:
                            return stmts
                        str fexpty = fexpr[t]
                        if ftypes6.contains(fld):
                            if NOT assignable(fexpty, ftypes6.take(fld)):
                                fail(st, {line: fexpr[line], col: fexpr[col]}, "TYPE_ERROR", cat(["field '", fld, "': type ", ftypes6.take(fld)]), fexpty)
                                return stmts
                            node = {k: "field_assign", base: fb, mname: e[mname], name: fld, expr: fexpr, type: ftypes6.take(fld), line: eq[line], col: eq[col]}
                        else:
                            if NOT is_scalar_type(fexpty):
                                fail(st, {line: fexpr[line], col: fexpr[col]}, "TYPE_ERROR", "scalar instance field (str, flint, bool)", fexpty)
                                return stmts
                            add_model_field(st, fschema, e, fld, fexpty, TRUE)
                            if st[err]:
                                return stmts
                            node = {k: "field_create", base: fb, mname: e[mname], name: fld, expr: fexpr, type: fexpty, line: eq[line], col: eq[col]}
                    else:
                        if ek != "index" AND ek != "dget":
                            fail(st, {line: e[line], col: e[col]}, "TYPE_ERROR", "variable, field or index as assignment target", ek)
                            return stmts
                        if ek == "index":
                            dict seb = e[base]
                            if seb[t] == "str":
                                fail(st, {line: e[line], col: e[col]}, "TYPE_ERROR", "mutable index target", "str is immutable")
                                return stmts
                        dict eq2 = advance(st)
                        dict eval2 = parse_expr(st, 0)
                        if st[err]:
                            return stmts
                        node = {k: "setindex", target: e, expr: eval2, line: eq2[line], col: eq2[col]}
                else:
                    node = {k: "exprstmt", expr: e, line: e[line], col: e[col]}
            if NOT decl_block:
                stmts.add(node)
                if NOT block_stmt:
                    dict nx2 = tk(st)
                    if top:
                        if nx2[type] == "newline":
                            advance(st)
                        elif nx2[type] != "eof":
                            fail(st, nx2, "SYNTAX_ERROR", "end of line", describe_tok(nx2))
                            return stmts
                    else:
                        if nx2[type] == "newline":
                            advance(st)
                        elif nx2[type] != "dedent":
                            fail(st, nx2, "SYNTAX_ERROR", "end of line", describe_tok(nx2))
                            return stmts
    if NOT top:
        if tk(st)[type] == "dedent":
            advance(st)
        st.add("block_depth", st[block_depth] - 1)
    return stmts

# ---------- кодогенератор ----------

func wrap_flint(str x, str ty, bool nullable) -> str:
    if ty == "NONE" OR ty == "any" OR nullable:
        return cat(["krt.as_flint(", x, ")"])
    return x

func wrap_str(str x, str ty, bool nullable) -> str:
    if ty == "NONE" OR ty == "any" OR nullable:
        return cat(["krt.as_str(", x, ")"])
    return x

func wrap_list(str x, str ty, bool nullable) -> str:
    if ty == "NONE" OR ty == "any" OR nullable:
        return cat(["krt.as_list(", x, ")"])
    return x

func wrap_dict(str x, str ty, bool nullable) -> str:
    if ty == "NONE" OR ty == "any" OR nullable:
        return cat(["krt.as_dict(", x, ")"])
    return x

func wrap_bool(str x, str ty, bool nullable) -> str:
    if ty == "NONE" OR ty == "any" OR nullable:
        return cat(["krt.as_bool(", x, ")"])
    return x

func checked(str x, str ety, bool nullable, str target) -> str:
    if ety == "any" AND NOT nullable:
        if target == "flint":
            return cat(["krt.as_flint(", x, ")"])
        if target == "str":
            return cat(["krt.as_str(", x, ")"])
        if target == "bool":
            return cat(["krt.as_bool(", x, ")"])
        if target == "list":
            return cat(["krt.as_list(", x, ")"])
        if target == "dict":
            return cat(["krt.as_dict(", x, ")"])
        return cat(["krt.as_model(", x, lua_str(target), ")"])
    return x

func wrap_to(str x, str ety, bool nullable, str target) -> str:
    if ety == "NONE" OR ety == "any" OR nullable:
        if target == "flint":
            return cat(["krt.as_flint(", x, ")"])
        if target == "str":
            return cat(["krt.as_str(", x, ")"])
        if target == "bool":
            return cat(["krt.as_bool(", x, ")"])
        if target == "list":
            return cat(["krt.as_list(", x, ")"])
        if target == "dict":
            return cat(["krt.as_dict(", x, ")"])
        return cat(["krt.as_model(", x, lua_str(target), ")"])
    return x

func ordered_x(str x, dict e, dict other) -> str:
    if e[t] == "NONE" OR e_nullable(e):
        str ty = e[t]
        if ty == "NONE":
            ty = other[t]
        if ty == "str":
            return cat(["krt.as_str(", x, ")"])
        return cat(["krt.as_flint(", x, ")"])
    return x

func emit_line(dict st, str s):
    if NOT (st[cur_pos] is NONE):
        dict cp = st[cur_pos]
        if len(cp) > 0:
            list lm = st[line_map]
            lm.add({gen: len(st[out]) + 1, line: cp[line], col: cp[col]})
    list o = st[out]
    o.add(cat([spaces(st[indent] * 4), s]))

func stmt_pos(dict s) -> dict:
    str sk = s[k]
    if sk == "decl" OR sk == "assign" OR sk == "compound" OR sk == "exprstmt" OR sk == "return":
        if s.contains("expr"):
            dict e = s[expr]
            return {line: e[line], col: e[col]}
    if sk == "if":
        list brs = s[branches]
        dict b0 = brs[0]
        dict c0 = b0[cond]
        return {line: c0[line], col: c0[col]}
    if sk == "while":
        dict wc = s[cond]
        return {line: wc[line], col: wc[col]}
    if sk == "for":
        if s.contains("from"):
            dict fe = s[from]
            return {line: fe[line], col: fe[col]}
        dict te = s[to]
        return {line: te[line], col: te[col]}
    if sk == "for_in":
        dict cc = s[coll]
        return {line: cc[line], col: cc[col]}
    return {line: s[line], col: s[col]}

# Выражение -> текст Lua. Рекурсивна только сама в себя.
func emit_expr(dict st, dict e) -> str:
    str k = e[k]

    if k == "num":
        return cat(["(", str(e[value]), ")"])
    if k == "bool":
        if e[value]:
            return "true"
        return "false"
    if k == "none":
        return "krt.NONE"
    if k == "var":
        return e[lua]

    if k == "model_field":
        return cat(["krt.model_get(self, ", lua_str(e[name]), ")"])
    if k == "field":
        return cat(["krt.model_get(", emit_expr(st, e[base]), ", ", lua_str(e[name]), ")"])
    if k == "model_new":
        list mna = e[args]
        list mnp = [lua_str(e[mname])]
        flint mni = 0
        while mni < len(mna):
            dict mnarg = mna[mni]
            mnp.add(emit_expr(st, mnarg))
            mni += 1
        return cat(["krt.model_new(", mnp.join(", "), ")"])
    if k == "model_init":
        list mia = e[args]
        list mip = []
        for mia0 in mia:
            dict mian = mia0
            mip.add(cat(["[", lua_str(mian[name]), "] = ", emit_expr(st, mian[expr])]))
        return cat(["krt.model_init(", lua_str(e[mname]), ", \{", mip.join(", "), "\})"])
    if k == "model_method":
        list mma2 = e[args]
        list mmp2 = [emit_expr(st, e[base]), lua_str(e[name])]
        list mmpt2 = e[ptypes]
        flint mmi2 = 0
        while mmi2 < len(mma2):
            dict mmarg = mma2[mmi2]
            str mmtgt = mmpt2[mmi2]
            mmp2.add(wrap_to(emit_expr(st, mmarg), mmarg[t], e_nullable(mmarg), mmtgt))
            mmi2 += 1
        return cat(["krt.model_call(", mmp2.join(", "), ")"])
    if k == "self_init":
        return "krt.NONE"

    if k == "func_ref":
        return e[lua]

    if k == "str" OR k == "call":
        list parts = e[parts]
        list pieces = []
        for p0 in parts:
            dict p = p0
            if p[kind] == "text":
                pieces.add(lua_str(p[value]))
            else:
                dict pe = p[expr]
                pieces.add(cat(["krt.tostr(", emit_expr(st, pe), ")"]))
        str body = "\"\""
        if len(pieces) == 1:
            body = pieces[0]
        elif len(pieces) > 1:
            body = cat(["(", pieces.join(" .. "), ")"])
        if k == "str":
            return body
        str f = e[fn]
        if f == "show":
            return cat(["krt.show(", body, ")"])
        if f == "show_err":
            return cat(["krt.show_err(", body, ")"])
        return cat(["krt.input(", body, ")"])

    if k == "builtin":
        str bn = e[name]
        list ba = e[args]
        if bn == "args":
            return "krt.args()"
        if bn == "time_ms":
            return "krt.time_ms()"
        if bn == "is_tty":
            return "krt.is_tty()"
        dict a0 = ba[0]
        if bn == "len":
            return cat(["krt.len(", emit_expr(st, a0), ")"])
        if bn == "type":
            return cat(["krt.typeof(", emit_expr(st, a0), ")"])
        if bn == "str":
            return cat(["krt.tostr(", emit_expr(st, a0), ")"])
        if bn == "flint":
            return cat(["krt.to_flint(", emit_expr(st, a0), ")"])
        if bn == "up":
            return cat(["krt.str_up(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "low":
            return cat(["krt.str_low(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "title":
            return cat(["krt.str_title(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "abs":
            return cat(["krt.num_abs(", wrap_flint(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "round":
            return cat(["krt.num_round(", wrap_flint(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "floor":
            return cat(["krt.num_floor(", wrap_flint(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "ceil":
            return cat(["krt.num_ceil(", wrap_flint(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "sqrt":
            return cat(["krt.num_sqrt(", wrap_flint(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "min" OR bn == "max":
            list mvals = []
            for mn0 in ba:
                dict mnode = mn0
                if mnode[t] == "list":
                    mvals.add(wrap_list(emit_expr(st, mnode), mnode[t], e_nullable(mnode)))
                else:
                    mvals.add(wrap_flint(emit_expr(st, mnode), mnode[t], e_nullable(mnode)))
            return cat(["krt.num_", bn, "(", mvals.join(", "), ")"])
        if bn == "sum":
            return cat(["krt.coll_sum(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "avg":
            return cat(["krt.coll_avg(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "keys":
            return cat(["krt.coll_keys(", wrap_dict(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "values":
            return cat(["krt.coll_values(", wrap_dict(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "upk":
            if a0[t] == "dict":
                return cat(["krt.coll_upk(", wrap_dict(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
            return cat(["krt.coll_upk(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "sort":
            return cat(["krt.coll_sort(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "reverse":
            return cat(["krt.coll_reverse(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "clear":
            if a0[t] == "dict":
                return cat(["krt.coll_clear(", wrap_dict(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
            return cat(["krt.coll_clear(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "map" OR bn == "filter":
            dict hf = ba[1]
            return cat(["krt.coll_", bn, "(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ", ", emit_expr(st, hf), ")"])
        if bn == "reduce":
            dict rf = ba[1]
            dict rs = ba[2]
            return cat(["krt.coll_reduce(", wrap_list(emit_expr(st, a0), a0[t], e_nullable(a0)), ", ", emit_expr(st, rf), ", ", emit_expr(st, rs), ")"])
        if bn == "system":
            return cat(["krt.system(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "assert":
            dict amsg = ba[1]
            return cat(["krt.do_assert(", emit_expr(st, a0), ", ", wrap_str(emit_expr(st, amsg), amsg[t], e_nullable(amsg)), ")"])
        if bn == "expect":
            return cat(["krt.expect_new(", emit_expr(st, a0), ")"])
        if bn == "read_file":
            return cat(["krt.read_file(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "write_file":
            dict a1 = ba[1]
            return cat(["krt.write_file(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ", ", wrap_str(emit_expr(st, a1), a1[t], e_nullable(a1)), ")"])
        if bn == "file_exists":
            return cat(["krt.file_exists(", wrap_str(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        if bn == "exit":
            return cat(["krt.exit(", wrap_flint(emit_expr(st, a0), a0[t], e_nullable(a0)), ")"])
        return "krt.NONE"

    if k == "call_user":
        list car = e[args]
        list cp = []
        list cpt = e[ptypes]
        flint ci = 0
        while ci < len(car):
            dict cnode = car[ci]
            str ctgt = cpt[ci]
            str cx = emit_expr(st, cnode)
            cp.add(wrap_to(cx, cnode[t], e_nullable(cnode), ctgt))
            ci += 1
        return cat([e[lua], "(", cp.join(", "), ")"])

    if k == "list":
        list its = e[items]
        list ip = []
        for it0 in its:
            dict itn = it0
            ip.add(emit_expr(st, itn))
        return cat(["krt.list(\{", ip.join(", "), "\})"])

    if k == "dict":
        list prs = e[pairs]
        str dx = "krt.dict()"
        for pd0 in prs:
            dict pd = pd0
            dict pv = pd[value]
            dx = cat(["krt.dict_set(", dx, ", ", lua_str(pd[key]), ", ", emit_expr(st, pv), ")"])
        return dx

    if k == "dget":
        dict db = e[base]
        return cat(["krt.dict_get(", wrap_dict(emit_expr(st, db), db[t], e_nullable(db)), ", ", lua_str(e[key]), ")"])

    if k == "index":
        dict ib = e[base]
        dict ii = e[index]
        str ix = wrap_flint(emit_expr(st, ii), ii[t], e_nullable(ii))
        if ib[t] == "list":
            return cat(["krt.list_index(", wrap_list(emit_expr(st, ib), ib[t], e_nullable(ib)), ", ", ix, ")"])
        if ib[t] == "any":
            return cat(["krt.index(", emit_expr(st, ib), ", ", ix, ")"])
        return cat(["krt.str_index(", wrap_str(emit_expr(st, ib), ib[t], e_nullable(ib)), ", ", ix, ")"])

    if k == "slice":
        dict sb = e[base]
        str sx = emit_expr(st, sb)
        str sfn = "str_slice"
        str recv = wrap_str(sx, sb[t], e_nullable(sb))
        if sb[t] == "list":
            sfn = "list_slice"
            recv = wrap_list(sx, sb[t], e_nullable(sb))
        elif sb[t] == "any":
            sfn = "slice"
            recv = sx
        list sp = [recv]
        if e[from] is NONE:
            sp.add("nil")
        else:
            dict fr = e[from]
            sp.add(wrap_flint(emit_expr(st, fr), fr[t], e_nullable(fr)))
        if e[to] is NONE:
            sp.add("nil")
        else:
            dict tto = e[to]
            sp.add(wrap_flint(emit_expr(st, tto), tto[t], e_nullable(tto)))
        if NOT (e[step] is NONE):
            dict stp = e[step]
            sp.add(wrap_flint(emit_expr(st, stp), stp[t], e_nullable(stp)))
        return cat(["krt.", sfn, "(", sp.join(", "), ")"])

    if k == "method":
        dict mb = e[base]
        str mx = emit_expr(st, mb)
        str mrecv = wrap_str(mx, mb[t], e_nullable(mb))
        if mb[t] == "list":
            mrecv = wrap_list(mx, mb[t], e_nullable(mb))
        elif mb[t] == "dict":
            mrecv = wrap_dict(mx, mb[t], e_nullable(mb))
        list mar = e[args]
        list mp = [mrecv]
        flint mi = 0
        while mi < len(mar):
            dict ma = mar[mi]
            str mspec = e[a1]
            if mi == 1:
                mspec = e[a2]
            str mxx = emit_expr(st, ma)
            if mspec == "str":
                mxx = wrap_str(mxx, ma[t], e_nullable(ma))
            elif mspec == "flint":
                mxx = wrap_flint(mxx, ma[t], e_nullable(ma))
            elif mspec == "dict":
                mxx = wrap_dict(mxx, ma[t], e_nullable(ma))
            mp.add(mxx)
            mi += 1
        return cat(["krt.", e[rt], "(", mp.join(", "), ")"])

    if k == "un":
        dict ua = e[a]
        if e[op] == "-":
            return cat(["(-(", wrap_flint(emit_expr(st, ua), ua[t], e_nullable(ua)), "))"])
        return cat(["(not krt.truthy(", emit_expr(st, ua), "))"])

    if k == "is":
        dict ia = e[a]
        str ix2 = emit_expr(st, ia)
        str ty2 = e[typename]
        if ty2 == "flint":
            return cat(["(type(", ix2, ") == \"number\")"])
        if ty2 == "str":
            return cat(["(type(", ix2, ") == \"string\")"])
        if ty2 == "bool":
            return cat(["(type(", ix2, ") == \"boolean\")"])
        if ty2 == "list":
            return cat(["krt.is_list(", ix2, ")"])
        if ty2 == "dict":
            return cat(["krt.is_dict(", ix2, ")"])
        if is_model_type(st, ty2):
            return cat(["krt.is_model(", ix2, ", ", lua_str(ty2), ")"])
        return cat(["(", ix2, " == krt.NONE or ", ix2, " == nil)"])

    if k == "bin":
        str op = e[op]
        dict bna = e[a]
        dict bnb = e[b]
        str xa = emit_expr(st, bna)
        str xb = emit_expr(st, bnb)
        if op == "+":
            return cat(["(", wrap_flint(xa, bna[t], e_nullable(bna)), " + ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "-":
            return cat(["(", wrap_flint(xa, bna[t], e_nullable(bna)), " - ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "*":
            return cat(["(", wrap_flint(xa, bna[t], e_nullable(bna)), " * ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "/":
            return cat(["krt.div(", wrap_flint(xa, bna[t], e_nullable(bna)), ", ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "//":
            return cat(["krt.idiv(", wrap_flint(xa, bna[t], e_nullable(bna)), ", ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "%":
            return cat(["krt.mod(", wrap_flint(xa, bna[t], e_nullable(bna)), ", ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "**":
            return cat(["krt.pow(", wrap_flint(xa, bna[t], e_nullable(bna)), ", ", wrap_flint(xb, bnb[t], e_nullable(bnb)), ")"])
        if op == "==":
            return cat(["(", xa, " == ", xb, ")"])
        if op == "!=":
            return cat(["(", xa, " ~= ", xb, ")"])
        if op == "<" OR op == "<=" OR op == ">" OR op == ">=":
            if bna[t] == "any" OR bnb[t] == "any":
                str cfn = "lt"
                if op == "<=":
                    cfn = "le"
                elif op == ">":
                    cfn = "gt"
                elif op == ">=":
                    cfn = "ge"
                return cat(["krt.", cfn, "(", xa, ", ", xb, ")"])
            return cat(["(", ordered_x(xa, bna, bnb), " ", op, " ", ordered_x(xb, bnb, bna), ")"])
        if op == "AND":
            return cat(["(krt.truthy(", xa, ") and krt.truthy(", xb, "))"])
        if op == "OR":
            return cat(["(krt.truthy(", xa, ") or krt.truthy(", xb, "))"])
        return "krt.NONE"

    if k == "chain":
        list cops = e[ops]
        list coper = e[operands]
        list clines = []
        list cconds = []
        dict cprev_node = coper[0]
        str cprev = emit_expr(st, cprev_node)
        flint cj = 0
        while cj < len(cops):
            dict co = cops[cj]
            dict crhs_node = coper[cj + 1]
            str crhs = ""
            if cj < len(cops) - 1:
                crhs = cat(["__t", str(cj + 1)])
                clines.add(cat(["local ", crhs, " = ", emit_expr(st, crhs_node)]))
            else:
                crhs = emit_expr(st, crhs_node)
            str cl = cprev
            str cr = crhs
            str cop2 = co[op]
            if cop2 == "==":
                cconds.add(cat(["(", cl, " == ", cr, ")"]))
            elif cop2 == "!=":
                cconds.add(cat(["(", cl, " ~= ", cr, ")"]))
            elif cprev_node[t] == "any" OR crhs_node[t] == "any":
                str cfn2 = "lt"
                if cop2 == "<=":
                    cfn2 = "le"
                elif cop2 == ">":
                    cfn2 = "gt"
                elif cop2 == ">=":
                    cfn2 = "ge"
                cconds.add(cat(["krt.", cfn2, "(", cl, ", ", cr, ")"]))
            else:
                if cprev_node[t] == "NONE" OR e_nullable(cprev_node):
                    if cprev_node[t] == "str":
                        cl = cat(["krt.as_str(", cl, ")"])
                    else:
                        cl = cat(["krt.as_flint(", cl, ")"])
                if crhs_node[t] == "NONE" OR e_nullable(crhs_node):
                    if crhs_node[t] == "str":
                        cr = cat(["krt.as_str(", cr, ")"])
                    else:
                        cr = cat(["krt.as_flint(", cr, ")"])
                cconds.add(cat(["(", cl, " ", cop2, " ", cr, ")"]))
            cprev = crhs
            cprev_node = crhs_node
            cj += 1
        str cpre = ""
        if len(clines) > 0:
            cpre = cat([clines.join("; "), "; "])
        return cat(["(function() ", cpre, "return ", cconds.join(" and "), " end)()"])

    return "krt.NONE"

# Объявления поднимаются в начало своей функции (D11, D43).
func collect_walk(list stmts, list out) -> list:
    for s0 in stmts:
        dict s = s0
        str sk = s[k]
        if sk == "decl":
            out.add(s[lua])
        elif sk == "if":
            list brs = s[branches]
            for b0 in brs:
                dict b = b0
                collect_walk(b[body], out)
            if s.contains("else_body"):
                collect_walk(s[else_body], out)
        elif sk == "while" OR sk == "for" OR sk == "for_in":
            collect_walk(s[body], out)
    return out

func collect_scope(list stmts) -> list:
    list out = []
    collect_walk(stmts, out)
    return out

func emit_hoist(dict st, list names):
    if len(names) == 0:
        return:
    list lua = []
    list nones = []
    for n0 in names:
        str n = n0
        lua.add(n)
        nones.add("krt.NONE")
    emit_line(st, cat(["local ", lua.join(", "), " = ", nones.join(", ")]))

func lua_str_map_keys(dict d, list ks) -> str:
    list parts = []
    for k in ks:
        if d.contains(k):
            parts.add(cat(["[", lua_str(k), "] = ", lua_str(d.take(k))]))
    if len(parts) == 0:
        return "\{\}"
    return cat(["\{", parts.join(", "), "\}"])

func lua_true_map_keys(dict d, list ks) -> str:
    list parts = []
    for k in ks:
        if d.contains(k):
            parts.add(cat(["[", lua_str(k), "] = true"]))
    if len(parts) == 0:
        return "\{\}"
    return cat(["\{", parts.join(", "), "\}"])

func cat_lists(list a, list b) -> list:
    list out = []
    for x in a:
        out.add(x)
    for y in b:
        out.add(y)
    return out

func lua_str_list(list xs) -> str:
    list parts = []
    for x in xs:
        parts.add(lua_str(x))
    return cat(["\{", parts.join(", "), "\}"])

# Стейтменты -> строки Lua. Рекурсивна только сама в себя.
func emit_stmts(dict st, list stmts) -> str:
    flint i = 0
    while i < len(stmts):
        dict s = stmts[i]
        dict saved = st[cur_pos]
        st.add("cur_pos", stmt_pos(s))
        str sk = s[k]
        bool wrap_ret = FALSE
        if sk == "return" AND i < len(stmts) - 1:
            wrap_ret = TRUE
            emit_line(st, "do")
            st.add("indent", st[indent] + 1)
        if sk == "model":
            dict msc = s[schema]
            str mn2 = s[name]
            dict msc_mf = msc[model_fields]
            dict msc_ft = msc[field_types]
            dict msc_cs = msc[consts]
            dict msc_if = msc[init_fields]
            dict msc_pt = msc[param_types]
            list msc_ord = msc[order]
            list msc_fo = msc[field_order]
            list msc_pl = msc[params]
            list msc_all = msc_fo
            emit_line(st, cat(["krt.model_define(", lua_str(mn2), ", ", lua_str_map_keys(msc_mf, msc_ord), ", ", lua_str_map_keys(msc_ft, msc_all), ", ", lua_true_map_keys(msc_cs, msc_all), ", ", lua_true_map_keys(msc_if, msc_fo), ", ", lua_str_list(msc_pl), ", ", lua_str_map_keys(msc_pt, msc_pl), ")"]))
            list mflds = s[fields]
            for mf0 in mflds:
                dict mfn2 = mf0
                emit_line(st, cat(["krt.model_set_value(", lua_str(mn2), ", ", lua_str(mfn2[name]), ", ", emit_expr(st, mfn2[expr]), ")"]))
            dict mcons2 = msc[ctor]
            list mcps = mcons2[params]
            list mcpl = ["self"]
            for mcp0 in mcps:
                dict mcp = mcp0
                mcpl.add(mcp[lua])
            emit_line(st, cat(["krt.model_construct(", lua_str(mn2), ", function(", mcpl.join(", "), ")"]))
            st.add("indent", st[indent] + 1)
            str msv = st[current_ret]
            st.add("current_ret", "NONE")
            list mcbody = mcons2[body]
            emit_hoist(st, collect_scope(mcbody))
            emit_stmts(st, mcbody)
            st.add("current_ret", msv)
            st.add("indent", st[indent] - 1)
            emit_line(st, "end)")
            list mmorder = msc[method_order]
            for mmn2 in mmorder:
                dict msmeth6 = msc[methods]
                dict mmi2 = msmeth6.take(mmn2)
                list mmps = [ "self" ]
                list mmpl = mmi2[params]
                for mmp0 in mmpl:
                    dict mmp = mmp0
                    mmps.add(mmp[lua])
                emit_line(st, cat(["krt.model_method(", lua_str(mn2), ", ", lua_str(mmn2), ", function(", mmps.join(", "), ")"]))
                st.add("indent", st[indent] + 1)
                str msv2 = st[current_ret]
                st.add("current_ret", mmi2[ret])
                list mmbody = mmi2[body]
                emit_hoist(st, collect_scope(mmbody))
                emit_stmts(st, mmbody)
                st.add("current_ret", msv2)
                bool mmend = FALSE
                if len(mmbody) > 0:
                    dict mmlast = mmbody[len(mmbody) - 1]
                    if mmlast[k] == "return":
                        mmend = TRUE
                if NOT mmend:
                    emit_line(st, "return krt.NONE")
                st.add("indent", st[indent] - 1)
                emit_line(st, "end)")
        elif sk == "self_init":
            list sfl = s[fields]
            for sf0 in sfl:
                dict sf = sf0
                emit_line(st, cat(["krt.model_create_field(self, ", lua_str(sf[name]), ", ", sf[lua], ", ", "false", ", ", lua_str(sf[type]), ")"]))
        elif sk == "field_create":
            dict fce = s[expr]
            str fcx = checked(emit_expr(st, fce), fce[t], e_nullable(fce), s[type])
            str fcb = emit_expr(st, s[base])
            str fcc = "false"
            if is_const_name(s[name]):
                fcc = "true"
            emit_line(st, cat(["krt.model_create_field(", fcb, ", ", lua_str(s[name]), ", ", fcx, ", ", fcc, ", ", lua_str(s[type]), ")"]))
        elif sk == "field_assign":
            dict fae = s[expr]
            str fax = checked(emit_expr(st, fae), fae[t], e_nullable(fae), s[type])
            emit_line(st, cat(["krt.model_set(", emit_expr(st, s[base]), ", ", lua_str(s[name]), ", ", fax, ")"]))
        elif sk == "decl":
            dict de = s[expr]
            str dx = checked(emit_expr(st, de), de[t], e_nullable(de), s[type])
            emit_line(st, cat([s[lua], " = ", dx]))
        elif sk == "assign":
            dict ae = s[expr]
            str ax = checked(emit_expr(st, ae), ae[t], e_nullable(ae), s[type])
            emit_line(st, cat([s[lua], " = ", ax]))
        elif sk == "compound":
            dict ce = s[expr]
            str lhs = wrap_flint(s[lua], "flint", s[nullable])
            str rhs = wrap_flint(emit_expr(st, ce), ce[t], e_nullable(ce))
            str cop = s[op]
            str ex = ""
            if cop == "+":
                ex = cat(["(", lhs, " + ", rhs, ")"])
            elif cop == "-":
                ex = cat(["(", lhs, " - ", rhs, ")"])
            elif cop == "*":
                ex = cat(["(", lhs, " * ", rhs, ")"])
            elif cop == "/":
                ex = cat(["krt.div(", lhs, ", ", rhs, ")"])
            elif cop == "//":
                ex = cat(["krt.idiv(", lhs, ", ", rhs, ")"])
            elif cop == "%":
                ex = cat(["krt.mod(", lhs, ", ", rhs, ")"])
            else:
                ex = cat(["krt.pow(", lhs, ", ", rhs, ")"])
            emit_line(st, cat([s[lua], " = ", ex]))
        elif sk == "setindex":
            dict tg = s[target]
            dict tv = s[expr]
            str tvx = emit_expr(st, tv)
            if tg[k] == "dget":
                dict tb = tg[base]
                str tdx = wrap_dict(emit_expr(st, tb), tb[t], e_nullable(tb))
                emit_line(st, cat(["krt.dict_set(", tdx, ", ", lua_str(tg[key]), ", ", tvx, ")"]))
            else:
                dict tib = tg[base]
                dict tii = tg[index]
                str tbx = emit_expr(st, tib)
                str tix = wrap_flint(emit_expr(st, tii), tii[t], e_nullable(tii))
                if tib[t] == "list":
                    emit_line(st, cat(["krt.list_replace(", wrap_list(tbx, tib[t], e_nullable(tib)), ", ", tix, ", ", tvx, ")"]))
                else:
                    emit_line(st, cat(["krt.index_set(", tbx, ", ", tix, ", ", tvx, ")"]))
        elif sk == "exprstmt":
            emit_line(st, emit_expr(st, s[expr]))
        elif sk == "if":
            list brs = s[branches]
            flint bi = 0
            while bi < len(brs):
                dict br = brs[bi]
                dict bc = br[cond]
                str kw = "elseif"
                if bi == 0:
                    kw = "if"
                emit_line(st, cat([kw, " krt.truthy(", emit_expr(st, bc), ") then"]))
                st.add("indent", st[indent] + 1)
                emit_stmts(st, br[body])
                st.add("indent", st[indent] - 1)
                bi += 1
            if s.contains("else_body"):
                emit_line(st, "else")
                st.add("indent", st[indent] + 1)
                emit_stmts(st, s[else_body])
                st.add("indent", st[indent] - 1)
            emit_line(st, "end")
        elif sk == "while":
            st.add("loop_id", st[loop_id] + 1)
            str lid = str(st[loop_id])
            str cont = cat(["__continue_", lid])
            str brk = cat(["__break_", lid])
            dict wc2 = s[cond]
            emit_line(st, cat(["while krt.truthy(", emit_expr(st, wc2), ") do"]))
            st.add("indent", st[indent] + 1)
            list ls = st[loop_stack]
            ls.add({cont: cont, brk: brk})
            emit_stmts(st, s[body])
            emit_line(st, cat(["::", cont, "::"]))
            ls.del(len(ls) - 1)
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
            emit_line(st, cat(["::", brk, "::"]))
        elif sk == "break":
            list lsb = st[loop_stack]
            dict topb = lsb[len(lsb) - 1]
            emit_line(st, cat(["goto ", topb[brk]]))
        elif sk == "continue":
            list lsc = st[loop_stack]
            dict topc = lsc[len(lsc) - 1]
            emit_line(st, cat(["goto ", topc[cont]]))
        elif sk == "for":
            st.add("loop_id", st[loop_id] + 1)
            str fid = str(st[loop_id])
            str fcont = cat(["__continue_", fid])
            str fbrk = cat(["__break_", fid])
            str fv = s[lua]
            str fto = cat(["__to_", fid])
            emit_line(st, "do")
            st.add("indent", st[indent] + 1)
            str form = s[form]
            if form == "upto":
                emit_line(st, cat(["local ", fv, " = 0"]))
                dict fte = s[to]
                emit_line(st, cat(["local ", fto, " = ", wrap_flint(emit_expr(st, fte), fte[t], e_nullable(fte))]))
                emit_line(st, cat(["while ", fv, " < ", fto, " do"]))
            else:
                dict ffe = s[from]
                dict ftte = s[to]
                str fstep = cat(["__step_", fid])
                emit_line(st, cat(["local ", fv, " = ", wrap_flint(emit_expr(st, ffe), ffe[t], e_nullable(ffe))]))
                emit_line(st, cat(["local ", fto, " = ", wrap_flint(emit_expr(st, ftte), ftte[t], e_nullable(ftte))]))
                str sx = "1"
                if s.contains("step"):
                    dict fse = s[step]
                    sx = wrap_flint(emit_expr(st, fse), fse[t], e_nullable(fse))
                emit_line(st, cat(["local ", fstep, " = ", sx]))
                emit_line(st, cat(["while ((", fstep, " > 0) and (", fv, " < ", fto, ")) or ((", fstep, " < 0) and (", fv, " > ", fto, ")) do"]))
            st.add("indent", st[indent] + 1)
            list fls = st[loop_stack]
            fls.add({cont: fcont, brk: fbrk})
            emit_stmts(st, s[body])
            emit_line(st, cat(["::", fcont, "::"]))
            if form == "upto":
                emit_line(st, cat([fv, " = ", fv, " + 1"]))
            else:
                emit_line(st, cat([fv, " = ", fv, " + __step_", fid]))
            fls.del(len(fls) - 1)
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
            emit_line(st, cat(["::", fbrk, "::"]))
        elif sk == "for_in":
            st.add("loop_id", st[loop_id] + 1)
            str iid = str(st[loop_id])
            str icont = cat(["__continue_", iid])
            str ibrk = cat(["__break_", iid])
            str icoll = cat(["__coll_", iid])
            str iidx = cat(["__i_", iid])
            dict ice = s[coll]
            list inames = s[names]
            list ilnames = s[lnames]
            emit_line(st, "do")
            st.add("indent", st[indent] + 1)
            bool list_mode = FALSE
            if ice[t] == "list":
                list_mode = TRUE
            elif ice[t] == "any" AND len(inames) == 1:
                list_mode = TRUE
            if list_mode:
                emit_line(st, cat(["local ", icoll, " = ", wrap_list(emit_expr(st, ice), ice[t], e_nullable(ice))]))
                emit_line(st, cat(["local ", iidx, " = 0"]))
                emit_line(st, cat(["while ", iidx, " < #", icoll, " do"]))
                st.add("indent", st[indent] + 1)
                str iv = ilnames[0]
                emit_line(st, cat(["local ", iv, " = ", icoll, "[", iidx, " + 1]"]))
            else:
                emit_line(st, cat(["local ", icoll, " = ", wrap_dict(emit_expr(st, ice), ice[t], e_nullable(ice))]))
                emit_line(st, cat(["local ", iidx, " = 0"]))
                emit_line(st, cat(["while ", iidx, " < #", icoll, ".keys do"]))
                st.add("indent", st[indent] + 1)
                str ivk = ilnames[0]
                str ivv = ilnames[1]
                emit_line(st, cat(["local ", ivk, " = ", icoll, ".keys[", iidx, " + 1]"]))
                emit_line(st, cat(["local ", ivv, " = ", icoll, ".vals[", iidx, " + 1]"]))
            list ils = st[loop_stack]
            ils.add({cont: icont, brk: ibrk})
            emit_stmts(st, s[body])
            emit_line(st, cat(["::", icont, "::"]))
            emit_line(st, cat([iidx, " = ", iidx, " + 1"]))
            ils.del(len(ils) - 1)
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
            emit_line(st, cat(["::", ibrk, "::"]))
        elif sk == "return":
            if s.contains("expr"):
                dict re = s[expr]
                str rv = emit_expr(st, re)
                if re[t] == "any" AND st[current_ret] != "any":
                    rv = checked(rv, re[t], e_nullable(re), st[current_ret])
                st.add("ret_id", st[ret_id] + 1)
                str tmp = cat(["__ret_", str(st[ret_id])])
                emit_line(st, cat(["do local ", tmp, " = ", rv, "; return ", tmp, " end"]))
            else:
                emit_line(st, "return krt.NONE")
        elif sk == "func":
            list fparams = s[params]
            list fpl = []
            for fp0 in fparams:
                dict fp = fp0
                fpl.add(fp[lua])
            emit_line(st, cat(["local function ", s[lua], "(", fpl.join(", "), ")"]))
            st.add("indent", st[indent] + 1)
            str saved_ret = st[current_ret]
            st.add("current_ret", s[ret])
            list fbody = s[body]
            emit_hoist(st, collect_scope(fbody))
            emit_stmts(st, fbody)
            st.add("current_ret", saved_ret)
            bool ends_ret = FALSE
            if len(fbody) > 0:
                dict flast = fbody[len(fbody) - 1]
                if flast[k] == "return":
                    ends_ret = TRUE
            if NOT ends_ret:
                emit_line(st, "return krt.NONE")
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
        if wrap_ret:
            st.add("indent", st[indent] - 1)
            emit_line(st, "end")
        st.add("cur_pos", saved)
        i += 1
    return ""

# ---------- сборка Lua ----------

func generate(dict ast, dict opts) -> str:
    dict st = {out: [], indent: 0, line_map: [], cur_pos: {}, loop_stack: [], loop_id: 0, ret_id: 0, current_ret: "NONE", models: opts[models]}
    emit_line(st, "#!/usr/bin/env luajit")
    emit_line(st, "-- generated by kraft")
    emit_line(st, cat(["local __KRAFT_SOURCE = ", lua_str(opts[path])]))
    emit_line(st, "local krt = (function()")
    list krt_lines = split_lines(opts[krt])
    for kl in krt_lines:
        emit_line(st, kl)
    emit_line(st, "end)()")

    list src_lines = split_lines(opts[source])
    list quoted = []
    for sl in src_lines:
        quoted.add(lua_str(sl))
    emit_line(st, cat(["krt.SOURCE_PATH = ", lua_str(opts[path])]))
    emit_line(st, cat(["krt.SOURCE_LINES = \{", quoted.join(", "), "\}"]))

    list stdin_lines = opts[stdin]
    list quoted_stdin = []
    for stl in stdin_lines:
        quoted_stdin.add(lua_str(stl))
    emit_line(st, cat(["krt.STDIN = \{", quoted_stdin.join(", "), "\}"]))

    flint map_index = len(st[out]) + 1
    emit_line(st, "krt.LINE_MAP = \{\}")

    emit_line(st, "krt.run(function()")
    st.add("indent", 1)
    emit_hoist(st, collect_scope(ast[stmts]))
    emit_stmts(st, ast[stmts])
    st.add("indent", 0)
    emit_line(st, "end)")

    list map_parts = []
    list lm = st[line_map]
    for m0 in lm:
        dict m = m0
        map_parts.add(cat(["[", str(m[gen]), "]=\{", str(m[line]), ",", str(m[col]), "\}"]))
    list o = st[out]
    o.replace(map_index - 1, cat(["krt.LINE_MAP = \{", map_parts.join(","), "\}"]))
    return cat([o.join("\n"), "\n"])

func extract_stdin(str src) -> list:
    list out = []
    list lines = split_lines(src)
    for l0 in lines:
        str line = l0
        flint i = 0
        flint n = len(line)
        while i < n AND (line[i] == " " OR line[i] == "\t"):
            i += 1
        if i < n AND line[i] == "#":
            i += 1
            while i < n AND (line[i] == " " OR line[i] == "\t"):
                i += 1
            if line[i..i + 6] == "stdin:":
                i += 6
                while i < n AND (line[i] == " " OR line[i] == "\t"):
                    i += 1
                out.add(line[i..n])
    return out

# `# const-top` — директива режима: верхний уровень файла только объявляет.
func has_const_top(str src) -> bool:
    for l0 in split_lines(src):
        str line = l0
        flint i = 0
        flint n = len(line)
        while i < n AND (line[i] == " " OR line[i] == "\t"):
            i += 1
        if i >= n OR line[i] != "#":
            continue
        i += 1
        while i < n AND (line[i] == " " OR line[i] == "\t"):
            i += 1
        if line[i..i + 9] == "const-top":
            flint j = i + 9
            while j < n AND (line[j] == " " OR line[j] == "\t" OR line[j] == "\r"):
                j += 1
            if j == n:
                return TRUE
    return FALSE

func dirname(str p) -> str:
    flint i = len(p) - 1
    while i >= 0:
        if p[i] == "/":
            if i == 0:
                return "/"
            return p[..i]
        i -= 1
    return "."

# ---------- CLI ----------

list argv = args()
if len(argv) < 2:
    show_err(usage: xkraft [--tokens] [-c] file.kraft)
    exit(1)

str mode = "run"
flint ai = 1
bool scanning = TRUE
while scanning AND ai < len(argv):
    str av = argv[ai]
    if av == "--tokens":
        mode = "tokens"
        ai += 1
    elif av == "-c":
        mode = "compile"
        ai += 1
    elif av == "--emit-lua":
        mode = "run"
        ai += 1
    else:
        scanning = FALSE
if ai >= len(argv):
    show_err(usage: xkraft [--tokens] [-c] file.kraft)
    exit(1)

str path = argv[ai]
str src = read_file(path)
dict lx = lex(src, path)
if lx[err]:
    dict e = lx[err]
    e.add("path", path)
    report_error(e, src)
    exit(1)
if mode == "tokens":
    dump_tokens(lx[tokens])
    exit(0)

dict st = {toks: lx[tokens], pos: 0, path: path, const_top: has_const_top(src), vars: {}, nullable: {}, maybe_unset: {}, gvars: {}, gnullable: {}, gmaybe: {}, for_names: {}, funcs: {}, in_func: FALSE, func_ret: "NONE", func_returns: [], block_depth: 0, loop_depth: 0, err: NONE, names: {}, fnames: {}, vcounter: 0, fcounter: 0, models: {Error: error_schema()}, model_ctx: NONE, try_id: 0, try_depth: 0, try_loop_base: 0}
list prog = parse_block(st, TRUE)
if st[err]:
    dict e2 = st[err]
    report_error(e2, src)
    exit(1)
dict ast = {k: "program", stmts: prog}

str self_path = argv[0]
str krt_path = cat([dirname(self_path), "/src/krt.lua"])
if NOT file_exists(krt_path):
    show_err(cannot read runtime: {krt_path})
    exit(1)
str krt_src = read_file(krt_path)

str out_lua = generate(ast, {path: path, krt: krt_src, source: src, stdin: extract_stdin(src), models: st[models]})
if mode == "compile":
    str base = path
    if path.suff(".kraft"):
        base = path[..len(path) - 6]
    write_file(cat([base, ".lua"]), out_lua)
    exit(0)

show({out_lua[..len(out_lua) - 1]})
exit(0)
