ed block\", cat([\"assignment to top-level variable '\", n, \"'\"]))", "            return {}", "        dict nm2 = st[names]", "        return {kind: \"global\", type: gv.take(n), lua: nm2.take(n)}", "    fail(st, tok, \"NAME_ERROR\", \"declared variable\", cat([\"name '\", n, \"' is not declared\"]))", "    return {}", "", "# Объявление `имя = выражение` с заданным типом. Общее для обычного", "# объявления и для строки внутри блока типов.", "func parse_typed_decl(dict st, str dty, dict dname_tok) -> dict:", "    str dname = dname_tok[value]", "    str dkey = decl_key(st, dname)", "    if is_reserved(dname):", "        fail(st, dname_tok, \"NAME_ERROR\", \"free name\", cat([\"reserved '\", dname, \"'\"]))", "        return {}", "    dict dvars = st[vars]", "    dict dfuncs = st[funcs]", "    if dvars.contains(dkey) OR dfuncs.contains(dkey):", "        fail(st, dname_tok, \"REDECLARE_ERROR\", \"unique name\", cat([\"name '\", dname, \"' is already declared\"]))", "        return {}", "    if st[in_func]:", "        dict dg = st[gvars]", "        if dg.contains(dkey):", "            fail(st, dname_tok, \"REDECLARE_ERROR\", \"local name\", cat([\"global '\", dname, \"' is already declared\"]))", "            return {}", "    dict dctx = st[model_ctx]", "    if NOT (dctx is NONE):", "        dict dms = dctx[schema]", "        dict dft = dms[field_types]", "        dict dmeth = dms[methods]", "        if dft.contains(dname) OR dmeth.contains(dname):", "            fail(st, dname_tok, \"REDECLARE_ERROR\", \"local name\", cat([\"model member '\", dname, \"'\"]))", "            return {}", "    expect_tok(st, \"op\", \"=\", \"'='\")", "    if NOT (st[err] is NONE):", "        return {}", "    dict dexpr = {}", "    if is_model_type(st, dty) AND tok_is(tk(st), \"kw\", \"init\"):", "        dict inittok = advance(st)", "        expect_tok(st, \"op\", \"(\", \"'('\")", "        dict ms = model_schema(st, dty)", "        dict cons = ms[ctor]", "        if cons is NONE:", "            fail(st, inittok, \"NAME_ERROR\", cat([\"declared construct of '\", dty, \"'\"]), \"model without construct\")", "            return {}", "        list iparams = cons[params]", "        dict iparm = {}", "        flint ii = 0", "        while ii < len(iparams):", "            dict ipp = iparams[ii]", "            iparm.add(ipp[name], TRUE)", "            ii += 1", "        list iargs = []", "        dict iseen = {}", "        if NOT tok_is(tk(st), \"op\", \")\"):", "            while TRUE:", "                dict iat = expect_tok(st, \"name\", \"\", \"init argument name\")", "                if NOT (st[err] is NONE):", "                    return {}", "                str ian = iat[value]", "                if iseen.contains(ian):", "                    fail(st, iat, \"REDECLARE_ERROR\", \"unique init argument\", cat([\"duplicate '\", ian, \"'\"]))", "                    return {}", "                iseen.add(ian, TRUE)", "                expect_tok(st, \"op\", \":\", \"':'\")", "                dict iav = parse_expr(st, 0)", "                if NOT (st[err] is NONE):", "                    return {}", "                bool iok = FALSE", "                str iwant = \"any\"", "                if iparm.contains(ian):", "                    flint ij = 0", "                    while ij < len(iparams):", "                        dict ipj = iparams[ij]", "                        if ipj[name] == ian:", "                            iwant = ipj[type]", "                            iok = TRUE", "                        ij += 1", "                else:", "                    dict iinit = ms[init_fields]", "                    dict ift = ms[field_types]", "                    dict imf = ms[model_fields]", "                    dict icons = ms[consts]", "                    if iinit.contains(ian):", "                        iwant = ift.take(ian)", "                        iok = TRUE", "                    elif imf.contains(ian) OR icons.contains(ian):", "                        fail(st, iat, \"CONST_ERROR\", \"init argument for a mutable field\", cat([\"read-only '\", ian, \"'\"]))", "                        return {}", "                    elif ift.contains(ian):", "                        fail(st, iat, \"CONST_ERROR\", \"init argument for a computed field\", cat([\"field '\", ian, \"' is set from construct parameters\"]))", "                        return {}", "                    else:", "                        fail(st, iat, \"NAME_ERROR\", cat([\"field or construct parameter of '\", dty, \"'\"]), cat([\"unknown '\", ian, \"'\"]))", "                        return {}", "                if NOT coercion_ok(iav, iwant):", "                    fail(st, {line: iav[line], col: iav[col]}, \"TYPE_ERROR\", cat([\"init argument '\", ian, \"': type \", iwant]), iav[t])", "                    return {}", "                iargs.add({name: ian, expr: iav, type: iwant})", "                if tok_is(tk(st), \"op\", \",\"):", "                    advance(st)", "                else:", "                    break", "        expect_tok(st, \"op\", \")\", \"')'\")", "        if NOT (st[err] is NONE):", "            return {}", "        flint mi2 = 0", "        while mi2 < len(iparams):", "            dict ipm = iparams[mi2]", "            str need = ipm[name]", "            if NOT iseen.contains(need):", "                fail(st, inittok, \"ARGCOUNT_ERROR\", cat([\"argument '\", need, \"' in init\"]), \"missing\")", "                return {}", "            mi2 += 1", "        dexpr = {k: \"model_init\", mname: dty, args: iargs, t: dty, line: inittok[line], col: inittok[col]}", "    else:", "        dexpr = parse_expr(st, 0)", "        if NOT (st[err] is NONE):", "            return {}", "        if NOT coercion_ok(dexpr, dty):", "            bool litok = FALSE", "            if is_typed_spec(dty) AND dexpr[t] != \"NONE\":", "                litok = literal_ok(st, dexpr, dty)", "            if NOT litok:", "                fail(st, {line: dexpr[line], col: dexpr[col]}, \"TYPE_ERROR\", cat([\"declaration of '\", dname, \"': type \", dty]), dexpr[t])", "                return {}", "    str dlua = mangle_var(st, dkey)", "    dvars.add(dkey, dty)", "    # Любое объявление вне функции — глобальная («верх файла»).", "    # Переприсвоить её можно только в функции или цикле, не в условии.", "    if NOT st[in_func]:", "        dict dtg = st[gvars]", "        dtg.add(dkey, dty)", "    dict dnl = st[nullable]", "    if dexpr[t] == \"NONE\" OR e_nullable(dexpr):", "        dnl.add(dkey, TRUE)", "    else:", "        dnl.remove(dkey)", "    if st[block_depth] > 0:", "        dict dmu = st[maybe_unset]", "        dmu.add(dkey, TRUE)", "    return {k: \"decl\", type: dty, name: dkey, short_name: dname, lua: dlua, expr: dexpr, line: dname_tok[line], col: dname_tok[col]}", "", "func snapshot_parser(dict st) -> dict:", "    return {vars: st[vars], nullable: st[nullable], maybe_unset: st[maybe_unset], for_names: st[for_names], gvars: st[gvars], gnullable: st[gnullable], gmaybe: st[gmaybe], loop_depth: st[loop_depth], cond_depth: st[cond_depth], try_depth: st[try_depth], try_loop_base: st[try_loop_base], in_func: st[in_func], func_ret: st[func_ret], func_returns: st[func_returns], model_ctx: st[model_ctx]}", "", "func restore_parser(dict st, dict sv):", "    st.add(\"vars\", sv[vars])", "    st.add(\"nullable\", sv[nullable])", "    st.add(\"maybe_unset\", sv[maybe_unset])", "    st.add(\"for_names\", sv[for_names])", "    st.add(\"gvars\", sv[gvars])", "    st.add(\"gnullable\", sv[gnullable])", "    st.add(\"gmaybe\", sv[gmaybe])", "    st.add(\"loop_depth\", sv[loop_depth])", "    st.add(\"cond_depth\", sv[cond_depth])", "    st.add(\"try_depth\", sv[try_depth])", "    st.add(\"try_loop_base\", sv[try_loop_base])", "    st.add(\"in_func\", sv[in_func])", "    st.add(\"func_ret\", sv[func_ret])", "    st.add(\"func_returns\", sv[func_returns])", "    st.add(\"model_ctx\", sv[model_ctx])", "", "# Заголовок модели: поле до construct. Тело не разбирает.", "func parse_model_field_decl(dict st, dict m) -> dict:", "    str mfty = advance(st)[value]", "    dict mfnt = expect_tok(st, \"name\", \"\", \"field name\")", "    if NOT (st[err] is NONE):", "        return {}", "    str mfname = mfnt[value]", "    check_field_name(st, mfnt, mfname)", "    if NOT (st[err] is NONE):", "        return {}", "    dict mf = m[model_fields]", "    dict ft = m[field_types]", "    dict meth = m[methods]", "    if mf.contains(mfname) OR ft.contains(mfname) OR meth.contains(mfname):", "        fail(st, mfnt, \"REDECLARE_ERROR\", \"unique field name\", cat([\"name '\", mfname, \"' is already declared\"]))", "        return {}", "    expect_tok(st, \"op\", \"=\", \"'='\")", "    dict sv = st[model_ctx]", "    st.add(\"model_ctx\", NONE)", "    dict mfexpr = parse_expr(st, 0)", "    st.add(\"model_ctx\", sv)", "    if NOT (st[err] is NONE):", "        return {}", "    if NOT coercion_ok(mfexpr, mfty):", "        fail(st, {line: mfexpr[line], col: mfexpr[col]}, \"TYPE_ERROR\", cat([\"field '\", mfname, \"': type \", mfty]), mfexpr[t])", "        return {}", "    mf.add(mfname, mfty)", "    ft.add(mfname, mfty)", "    list mo = m[order]", "    mo.add(mfname)", "    list fo = m[field_order]", "    fo.add(mfname)", "    return {name: mfname, type: mfty, expr: mfexpr, line: mfnt[line], col: mfnt[col]}", "", "# Параметры construct (construct=TRUE) или метода. Скобки уже открыты.", "func parse_model_params(dict st, dict m, bool is_cons) -> list:", "    list out = []", "    if NOT tok_is(tk(st), \"op\", \")\"):", "        while TRUE:", "            dict pty_tok = tk(st)", "            str pty = parse_type_name(st)", "            if NOT (st[err] is NONE):", "                return out", "            if pty == \"NONE\":", "                fail(st, pty_tok, \"TYPE_ERROR\", \"parameter type\", \"NONE\")", "                return out", "            dict pnt = expect_tok(st, \"name\", \"\", \"parameter name\")", "            if NOT (st[err] is NONE):", "                return out", "            str pnm = pnt[value]", "            if is_reserved(pnm) OR is_const_name(pnm):", "                fail(st, pnt, \"NAME_ERROR\", \"free parameter name\", cat([\"reserved '\", pnm, \"'\"]))", "                return out", "            dict mf = m[model_fields]", "            dict ft = m[field_types]", "            dict meth = m[methods]", "            if mf.contains(pnm) OR meth.contains(pnm) OR (NOT is_cons AND ft.contains(pnm)):", "                fail(st, pnt, \"REDECLARE_ERROR\", \"parameter name\", cat([\"model member '\", pnm, \"'\"]))", "                return out", "            flint pi = 0", "            while pi < len(out):", "                dict po = out[pi]", "                if po[name] == pnm:", "                    fail(st, pnt, \"REDECLARE_ERROR\", \"unique parameter name\", cat([\"duplicate '\", pnm, \"'\"]))", "                    return out", "                pi += 1", "            out.add({name: pnm, type: pty, line: pnt[line], col: pnt[col]})", "            if tok_is(tk(st), \"op\", \",\"):", "                advance(st)", "            else:", "                break", "    expect_tok(st, \"op\", \")\", \"')'\")", "    return out", "", "func parse_construct_header(dict st, dict m) -> dict:", "    advance(st)", "    expect_tok(st, \"op\", \"(\", \"'('\")", "    list params = parse_model_params(st, m, TRUE)", "    if NOT (st[err] is NONE):", "        return {}", "    expect_tok(st, \"op\", \":\", \"':'\")", "    if NOT (st[err] is NONE):", "        return {}", "    m.add(\"ctor\", {params: params, body: []})", "    list mparams = m[params]", "    dict mptypes = m[param_types]", "    for p0 in params:", "        dict p = p0", "        mparams.add(p[name])", "        mptypes.add(p[name], p[type])", "    dict mctx = {model_name: m[name], schema: m, in_construct: TRUE, level: st[block_depth] + 1, self_seen: FALSE, self_done: FALSE, param_set: {}}", "    dict ps = mctx[param_set]", "    for p1 in params:", "        dict p1d = p1", "        ps.add(p1d[name], TRUE)", "    return {params: params, mctx: mctx}", "", "func parse_method_header(dict st, dict m) -> dict:", "    advance(st)", "    dict mtok = expect_tok(st, \"name\", \"\", \"method name\")", "    if NOT (st[err] is NONE):", "        return {}", "    str mn = mtok[value]", "    if is_reserved(mn) OR is_const_name(mn):", "        fail(st, mtok, \"NAME_ERROR\", \"free method name\", cat([\"reserved '\", mn, \"'\"]))", "        return {}", "    dict mf = m[model_fields]", "    dict ft = m[field_types]", "    dict meth = m[methods]", "    if ft.contains(mn) OR mf.contains(mn) OR meth.contains(mn):", "        fail(st, mtok, \"REDECLARE_ERROR\", \"unique method name\", cat([\"name '\", mn, \"' is already declared\"]))", "        return {}", "    expect_tok(st, \"op\", \"(\", \"'('\")", "    list params = parse_model_params(st, m, FALSE)", "    if NOT (st[err] is NONE):", "        return {}", "    str mret = \"NONE\"", "    bool mhas = FALSE", "    if tok_is(tk(st), \"op\", \"->\"):", "        advance(st)", "        dict mrt = tk(st)", "        mret = parse_type_name(st)", "        if NOT (st[err] is NONE):", "            return {}", "        if mret == \"NONE\":", "            fail(st, mrt, \"SYNTAX_ERROR\", \"return type (omit '->' for NONE)\", \"NONE\")", "            return {}", "        mhas = TRUE", "    expect_tok(st, \"op\", \":\", \"':'\")", "    if NOT (st[err] is NONE):", "        return {}", "    dict info = {params: params, ret: NONE, ret_nullable: FALSE, inferring: TRUE}", "    if mhas:", "        info.add(\"ret\", mret)", "    meth.add(mn, info)", "    list mo = m[method_order]", "    mo.add(mn)", "    return {name: mn, info: info, params: params, ret: mret, has_ret: mhas, line: mtok[line], col: mtok[col]}", "", "func finish_method(dict st, dict info, list body, str declared, bool has_ret, list rets):", "    bool fall = TRUE", "    if len(body) > 0:", "        dict last = body[len(body) - 1]", "        if last[k] == \"return\":", "            fall = FALSE", "    bool nullable = fall", "    str seen = \"\"", "    flint ri = 0", "    while ri < len(rets):", "        dict rr = rets[ri]", "        if rr[empty] OR rr[type] == \"NONE\" OR e_nullable(rr):", "            nullable = TRUE", "        elif has_ret:", "            if NOT rr[empty] AND rr[type] != \"NONE\" AND NOT coercion_ok(rr[expr], declared):", "                fail(st, rr, \"TYPE_ERROR\", cat([\"return type \", declared]), rr[type])", "                return:", "        else:", "            if seen != \"\" AND seen != rr[type]:", "                fail(st, rr, \"TYPE_ERROR\", \"all returns of a method to have one type\", cat([seen, \" and \", rr[type]]))", "                return:", "            seen = rr[type]", "        ri += 1", "    str final = declared", "    if NOT has_ret:", "        final = seen", "        if final == \"\":", "            final = \"NONE\"", "    info.add(\"ret\", final)", "    info.add(\"ret_nullable\", nullable)", "    info.add(\"inferring\", FALSE)", "    info.add(\"body\", body)", "", "# Разбирает блок. top=TRUE — весь файл до eof; top=FALSE — после ':'.", "# Рекурсивна: тела if/while/for/func разбираются ею же.", "func enter_try_zone(dict st, flint old_base):", "    st.add(\"try_depth\", st[try_depth] + 1)", "    flint base = old_base", "    if st[loop_depth] > base:", "        base = st[loop_depth]", "    st.add(\"try_loop_base\", base)", "", "func leave_try_zone(dict st, flint old_base):", "    st.add(\"try_depth\", st[try_depth] - 1)", "    st.add(\"try_loop_base\", old_base)", "", "func try_crosses_loop(dict st) -> bool:", "    return st[try_depth] > 0 AND st[loop_depth] <= st[try_loop_base]", "", "func add_handler_error(dict st) -> dict:", "    dict old_names = st[names]", "    dict old_vars = st[vars]", "    dict old_null = st[nullable]", "    dict old_maybe = st[maybe_unset]", "    bool had_name = old_names.contains(\"error\")", "    bool had_var = old_vars.contains(\"error\")", "    bool had_null = old_null.contains(\"error\")", "    bool had_maybe = old_maybe.contains(\"error\")", "    str prev_name = \"\"", "    str prev_var = \"\"", "    bool prev_null = FALSE", "    bool prev_maybe = FALSE", "    if had_name:", "        prev_name = old_names.take(\"error\")", "    if had_var:", "        prev_var = old_vars.take(\"error\")", "    if had_null:", "        prev_null = old_null.take(\"error\")", "    if had_maybe:", "        prev_maybe = old_maybe.take(\"error\")", "    old_names.add(\"error\", \"error\")", "    old_vars.add(\"error\", \"Error\")", "    return {name: had_name, var: had_var, null: had_null, maybe: had_maybe, prev_name: prev_name, prev_var: prev_var, prev_null: prev_null, prev_maybe: prev_maybe}", "", "func remove_handler_error(dict st, dict sv):", "    dict cur_names = st[names]", "    dict cur_vars = st[vars]", "    dict cur_null = st[nullable]", "    dict cur_maybe = st[maybe_unset]", "    cur_names.remove(\"error\")", "    cur_vars.remove(\"error\")", "    cur_null.remove(\"error\")", "    cur_maybe.remove(\"error\")", "    if sv[name]:", "        cur_names.add(\"error\", sv[prev_name])", "    if sv[var]:", "        cur_vars.add(\"error\", sv[prev_var])", "    if sv[null]:", "        cur_null.add(\"error\", sv[prev_null])", "    if sv[maybe]:", "        cur_maybe.add(\"error\", sv[prev_maybe])", "", "# Категории одного trigger через запятую делят один обработчик.", "# ANY_ERROR не объединяется с другими и не повторяется.", "func parse_trigger_cats(dict st, dict zcats, bool zhas_any) -> dict:", "    list zcatnames = []", "    list zcattoks = []", "    dict zfirsttok = expect_tok(st, \"name\", \"\", \"error category\")", "    if NOT (st[err] is NONE):", "        return {}", "    zcatnames.add(zfirsttok[value])", "    zcattoks.add(zfirsttok)", "    while tok_is(tk(st), \"op\", \",\"):", "        advance(st)", "        dict znexttok = expect_tok(st, \"name\", \"\", \"error category\")", "        if NOT (st[err] is NONE):", "            return {}", "        zcatnames.add(znexttok[value])", "        zcattoks.add(znexttok)", "    flint zci = 0", "    while zci < len(zcatnames):", "        str zcname = zcatnames[zci]", "        dict zctok = zcattoks[zci]", "        if NOT is_error_category(zcname):", "            fail(st, zctok, \"NAME_ERROR\", \"known error category\", zcname)", "            return {}", "        if zhas_any:", "            fail(st, zctok, \"SYNTAX_ERROR\", \"trigger after ANY_ERROR\", cat([\"'\", zcname, \"'\"]))", "            return {}", "        if zcname == \"ANY_ERROR\":", "            if len(zcatnames) != 1:", "                fail(st, zctok, \"SYNTAX_ERROR\", \"ANY_ERROR in a group of triggers\", zcname)", "                return {}", "        else:", "            if zcats.contains(zcname):", "                fail(st, zctok, \"REDECLARE_ERROR\", \"unique trigger category\", cat([\"'\", zcname, \"'\"]))", "                return {}", "            zcats.add(zcname, TRUE)", "        zci += 1", "    dict hinfo = {cats: zcatnames, cat: zfirsttok[value], any: FALSE}", "    if zfirsttok[value] == \"ANY_ERROR\":", "        hinfo.add(\"any\", TRUE)", "    return hinfo", "", "# Разбор func разбит на хелперы: parse_block вплотную подошёл к лимиту", "# LuaJIT в 200 локальных переменных. Ни один хелпер не вызывает parse_block,", "# поэтому mutual recursion не возникает.", "func parse_func_head(dict st) -> dict:", "    dict funtok = advance(st)", "    if st[in_func] OR st[block_depth] > 0:", "        fail(st, funtok, \"SYNTAX_ERROR\", \"function at top level\", \"nested function\")", "        return {}", "    dict fntok = expect_tok(st, \"name\", \"\", \"function name\")", "    if NOT (st[err] is NONE):", "        return {}", "    str fn_name = fntok[value]", "    str fn_key = decl_key(st, fn_name)", "    if NOT is_func_name_free(fn_name):", "        fail(st, fntok, \"NAME_ERROR\", \"free name\", cat([\"reserved '\", fn_name, \"'\"]))", "        return {}", "    if is_const_name(fn_name):", "        fail(st, fntok, \"CONST_ERROR\", \"function name\", cat([\"constant '\", fn_name, \"'\"]))", "        return {}", "    dict gvars = st[vars]", "    dict gfuncs = st[funcs]", "    if gfuncs.contains(fn_key) OR gvars.contains(fn_key):", "        fail(st, fntok, \"REDECLARE_ERROR\", \"unique name\", cat([\"name '\", fn_name, \"' is already declared\"]))", "        return {}", "    return {tok: funtok, name: fn_name, key: fn_key}", "", "func parse_func_params(dict st) -> list:", "    list params = []", "    expect_tok(st, \"op\", \"(\", \"'('\")", "    if NOT (st[err] is NONE):", "        return params", "    if NOT tok_is(tk(st), \"op\", \")\"):", "        while TRUE:", "            dict pty_tok = tk(st)", "            str pty = parse_type_name(st)", "            if NOT (st[err] is NONE):", "                return params", "            if pty == \"NONE\":", "                fail(st, pty_tok, \"TYPE_ERROR\", \"parameter type\", \"NONE\")", "                return params", "            dict pn = expect_tok(st, \"name\", \"\", \"parameter name\")", "            if NOT (st[err] is NONE):", "                return params", "            str pnm = pn[value]", "            if is_reserved(pnm):", "                fail(st, pn, \"NAME_ERROR\", \"free name\", cat([\"reserved '\", pnm, \"'\"]))", "                return params", "            dict pgv = st[vars]", "            if pgv.contains(pnm):", "                fail(st, pn, \"REDECLARE_ERROR\", \"parameter name\", cat([\"global '\", pnm, \"' is already declared\"]))", "                return params", "            flint di = 0", "            while di < len(params):", "                dict pp0 = params[di]", "                if pp0[name] == pnm:", "                    fail(st, pn, \"REDECLARE_ERROR\", \"unique parameter name\", cat([\"duplicate '\", pnm, \"'\"]))", "                    return params", "                di += 1", "            params.add({name: pnm, type: pty, line: pn[line], col: pn[col]})", "            if tok_is(tk(st), \"op\", \",\"):", "                advance(st)", "            else:", "                break", "    expect_tok(st, \"op\", \")\", \"')'\")", "    return params", "", "func enter_func_scope(dict st) -> dict:", "    dict sv = {vars: st[vars], nullable: st[nullable], maybe: st[maybe_unset], fors: st[for_names], gvars: st[gvars], gnullable: st[gnullable], gmaybe: st[gmaybe], loop: st[loop_depth], in_func: st[in_func], ret: st[func_ret], returns: st[func_returns]}", "    st.add(\"gvars\", st[vars])", "    st.add(\"gnullable\", st[nullable])", "    st.add(\"gmaybe\", st[maybe_unset])", "    st.add(\"vars\", {})", "    st.add(\"nullable\", {})", "    st.add(\"maybe_unset\", {})", "    st.add(\"for_names\", {})", "    st.add(\"loop_depth\", 0)", "    st.add(\"in_func\", TRUE)", "    st.add(\"func_ret\", \"NONE\")", "    st.add(\"func_returns\", [])", "    return sv", "", "func leave_func_scope(dict st, dict sv):", "    st.add(\"vars\", sv[vars])", "    st.add(\"nullable\", sv[nullable])", "    st.add(\"maybe_unset\", sv[maybe])", "    st.add(\"for_names\", sv[fors])", "    st.add(\"gvars\", sv[gvars])", "    st.add(\"gnullable\", sv[gnullable])", "    st.add(\"gmaybe\", sv[gmaybe])", "    st.add(\"loop_depth\", sv[loop])", "    st.add(\"in_func\", sv[in_func])", "    st.add(\"func_ret\", sv[ret])", "    st.add(\"func_returns\", sv[returns])", "", "func bind_func_params(dict st, list params):", "    flint pj = 0", "    while pj < len(params):", "        dict pj_p = params[pj]", "        pj_p.add(\"lua\", mangle_var(st, pj_p[name]))", "        dict nv = st[vars]", "        nv.add(pj_p[name], pj_p[type])", "        pj += 1", "", "func finish_func(dict st, dict funtok, str fn_name, dict fninfo, list params, str flua, str fret, bool fhas_ret, list fnbody, bool exported, list frets) -> dict:", "    bool fallthrough = TRUE", "    if len(fnbody) > 0:", "        dict last_stmt = fnbody[len(fnbody) - 1]", "        if last_stmt[k] == \"return\":", "            fallthrough = FALSE", "    bool fnullable = fallthrough", "    str seen = \"\"", "    flint ri = 0", "    while ri < len(frets):", "        dict rr = frets[ri]", "        if rr[empty] OR rr[type] == \"NONE\" OR e_nullable(rr):", "            fnullable = TRUE", "        elif fhas_ret:", "            if NOT rr[empty] AND rr[type] != \"NONE\" AND NOT coercion_ok(rr[expr], fret):", "                fail(st, rr, \"TYPE_ERROR\", cat([\"return type \", fret]), rr[type])", "                return {}", "        else:", "            if seen != \"\" AND seen != rr[type]:", "                fail(st, rr, \"TYPE_ERROR\", cat([\"all returns of '\", fn_name, \"' to have one type\"]), cat([seen, \" and \", rr[type]]))", "                return {}", "            seen = rr[type]", "        ri += 1", "    str final_ret = fret", "    if NOT fhas_ret:", "        final_ret = seen", "        if final_ret == \"\":", "            final_ret = \"NONE\"", "    fninfo.add(\"ret\", final_ret)", "    fninfo.add(\"ret_nullable\", fnullable)", "    fninfo.add(\"inferring\", FALSE)", "    dict fnode = {k: \"func\", name: fn_name, lua: flua, params: params, ret: final_ret, body: fnbody, block_stmt: TRUE, line: funtok[line], col: funtok[col]}", "    if exported:", "        fnode.add(\"exported\", TRUE)", "    return fnode", "", "func prepare_func(dict st, bool exported) -> dict:", "    dict fh = parse_func_head(st)", "    if NOT (st[err] is NONE):", "        return {}", "    dict funtok = fh[tok]", "    str fn_name = fh[name]", "    str fn_key = fh[key]", "    list params = parse_func_params(st)", "    if NOT (st[err] is NONE):", "        return {}", "    str fret = \"NONE\"", "    bool fhas_ret = FALSE", "    if tok_is(tk(st), \"op\", \"->\"):", "        advance(st)", "        dict rtok = tk(st)", "        fret = parse_type_name(st)", "        if NOT (st[err] is NONE):", "            return {}", "        if fret == \"NONE\":", "            fail(st, rtok, \"SYNTAX_ERROR\", \"return type (omit '->' for NONE)\", \"NONE\")", "            return {}", "        fhas_ret = TRUE", "    expect_tok(st, \"op\", \":\", \"':'\")", "    if NOT (st[err] is NONE):", "        return {}", "    dict fninfo = {params: params, ret: NONE, ret_nullable: FALSE, inferring: TRUE}", "    if fhas_ret:", "        fninfo.add(\"ret\", fret)", "    dict gfuncs = st[funcs]", "    gfuncs.add(fn_key, fninfo)", "    str flua = mangle_func(st, fn_key)", "    return {funtok: funtok, name: fn_name, key: fn_key, params: params, fret: fret, has: fhas_ret, info: fninfo, lua: flua}", "", "func begin_func_body(dict st, dict prep):", "    prep.add(\"prefix\", st[ns_prefix])", "    st.add(\"ns_prefix\", \"\")", "    dict fsv = enter_func_scope(st)", "    st.add(\"func_ret\", prep[fret])", "    bind_func_params(st, prep[params])", "    prep.add(\"scope\", fsv)", "", "func complete_func(dict st, dict prep, list fnbody, bool exported) -> dict:", "    list frets = st[func_returns]", "    st.add(\"ns_prefix\", prep[prefix])", "    leave_func_scope(st, prep[scope])", "    dict fnode = finish_func(st, prep[funtok], prep[key], prep[info], prep[params], prep[lua], prep[fret], prep[has], fnbody, exported, frets)", "    if NOT (st[err] is NONE):", "        return {}", "    if exported:", "        dict fexp = st[exports]", "        fexp.add(prep[key], \"func\")", "        st.add(\"exports\", fexp)", "    return fnode", "", "# ---------- модули: разбор импортов до основного парсера ----------", "", "func dict_copy(dict src) -> dict:", "    dict out = {}", "    for ck, cv in src:", "        out.add(ck, cv)", "    return out", "", "func is_import_kw(str w) -> bool:", "    return w == \"import_file\" OR w == \"from_file\" OR w == \"import_lib\" OR w == \"from_lib\"", "", "# Читает синтаксис импорта, не загружая файл. Возвращает start/tok/kind/path/names.", "func parse_import_syntax(dict st) -> dict:", "    flint start = st[pos]", "    dict kwtok = advance(st)", "    str kind = kwtok[value]", "    dict ptok = expect_tok(st, \"string\", \"\", \"module path\")", "    if NOT (st[err] is NONE):", "        return {}", "    str mpath = plain_string_of(st, ptok)", "    if NOT (st[err] is NONE):", "        return {}", "    list names = []", "    if kind == \"from_file\" OR kind == \"from_lib\":", "        if NOT tok_is(tk(st), \"name\", \"import\"):", "            fail(st, tk(st), \"SYNTAX_ERROR\", \"'import' after module path\", describe_tok(tk(st)))", "            return {}", "        advance(st)", "        dict nt = expect_tok(st, \"name\", \"\", \"imported name\")", "        if NOT (st[err] is NONE):", "            return {}", "        names.add(nt)", "        while tok_is(tk(st), \"op\", \",\"):", "            advance(st)", "            dict nt2 = expect_tok(st, \"name\", \"\", \"imported name\")", "            if NOT (st[err] is NONE):", "                return {}", "            names.add(nt2)", "    return {start: start, tok: kwtok, kind: kind, path: mpath, names: names}", "", "func module_full_path(dict st, str kind, str mpath, dict tok) -> str:", "    if kind == \"import_lib\" OR kind == \"from_lib\":", "        str short = mpath", "        if len(short) >= 4 AND short[..4] == \"std/\":", "            short = short[4..len(short)]", "        return cat([st[self_dir], \"/stdlib/\", short, \".kraft\"])", "    return cat([dirname(st[path]), \"/\", mpath])", "", "func module_short_name(str mpath) -> str:", "    flint i = len(mpath)", "    while i > 0:", "        if mpath[i - 1] == \"/\":", "            return mpath[i..len(mpath)]", "        i -= 1", "    return mpath", "", "func bind_export(dict st, dict md, dict nt):", "    str name = nt[value]", "    str target = name", "    if nt.contains(\"bind_as\"):", "        target = nt[bind_as]", "    dict ex = md[exports]", "    if NOT ex.contains(name):", "        fail(st, nt, \"NAME_ERROR\", \"exported name\", cat([\"module does not export '\", name, \"'\"]))", "        return:", "    dict bound = md[bound]", "    if bound.contains(name):", "        return:", "    dict tvars = st[vars]", "    dict tfuncs = st[funcs]", "    if tvars.contains(target) OR tfuncs.contains(target):", "        fail(st, nt, \"REDECLARE_ERROR\", \"unique import name\", cat([\"name '\", target, \"' is already declared\"]))", "        return:", "    str kind = ex.take(name)", "    if kind == \"func\":", "        dict pf = md[funcs]", "        dict pfn = md[fnames]", "        if NOT pf.contains(name):", "            fail(st, nt, \"NAME_ERROR\", \"exported function\", name)", "            return:", "        tfuncs.add(target, pf.take(name))", "        dict tfn = st[fnames]", "        tfn.add(target, pfn.take(name))", "    else:", "        dict pv = md[vars]", "        dict pn = md[names]", "        if NOT pv.contains(name):", "            fail(st, nt, \"NAME_ERROR\", \"exported variable\", name)", "            return:", "        tvars.add(target, pv.take(name))", "        dict tn = st[names]", "        tn.add(target, pn.take(name))", "        dict pnl = md[nullable]", "        if pnl.contains(name):", "            dict tnl = st[nullable]", "            tnl.add(target, TRUE)", "        dict pgv = md[gvars]", "        if pgv.contains(name):", "            dict tgv = st[gvars]", "            tgv.add(target, pgv.take(name))", "        dict pgn = md[gnullable]", "        if pgn.contains(name):", "            dict tgn = st[gnullable]", "            tgn.add(target, TRUE)", "        dict pgm = md[gmaybe]", "        if pgm.contains(name):", "            dict tgm = st[gmaybe]", "            tgm.add(target, TRUE)", "    bound.add(name, TRUE)", "    st.add(\"vcounter\", md[vcounter])", "    st.add(\"fcounter\", md[fcounter])", "", "func parse_block(dict st, bool top) -> list:", "    list stmts = []", "    if NOT top:", "        expect_tok(st, \"newline\", \"\", \"end of line after ':'\")", "        expect_tok(st, \"indent\", \"\", \"indented block\")", "        st.add(\"block_depth\", st[block_depth] + 1)", "    bool going = TRUE", "    while going:", "        dict t = tk(st)", "        if NOT (st[err] is NONE):", "            return stmts", "        bool skip = FALSE", "        if top:", "            if t[type] == \"eof\":", "                going = FALSE", "                skip = TRUE", "            elif t[type] == \"newline\" OR t[type] == \"dedent\":", "                advance(st)", "                skip = TRUE", "            elif t[type] == \"indent\":", "                fail(st, t, \"SYNTAX_ERROR\", \"statement\", \"unexpected indent\")", "                return stmts", "        else:", "            if t[type] == \"dedent\" OR t[type] == \"eof\":", "                going = FALSE", "                skip = TRUE", "            elif t[type] == \"newline\":", "                advance(st)", "                skip = TRUE", "        if going AND NOT skip:", "            dict node = {}", "            bool block_stmt = FALSE", "            bool decl_block = FALSE", "            bool exported = top", "            if stmt_is_decl_block(st):", "                dict dbtok = advance(st)", "                str dbty = dbtok[value]", "                advance(st)", "                expect_tok(st, \"newline\", \"\", \"end of line after ':'\")", "                expect_tok(st, \"indent\", \"\", \"indented block\")", "                if NOT (st[err] is NONE):", "                    return stmts", "                flint dcount = 0", "                bool dbgoing = TRUE", "                while dbgoing:", "                    dict dbt = tk(st)", "                    if NOT (st[err] is NONE):", "                        return stmts", "                    if dbt[type] == \"dedent\" OR dbt[type] == \"eof\":", "                        dbgoing = FALSE", "                    elif dbt[type] == \"newline\":", "                        advance(st)", "                    else:", "                        dict dbnt = expect_tok(st, \"name\", \"\", \"variable name\")", "                        if NOT (st[err] is NONE):", "                            return stmts", "                        dict dbdecl = parse_typed_decl(st, dbty, dbnt)", "                        if NOT (st[err] is NONE):", "                            return stmts", "                        stmts.add(dbdecl)", "                        dcount += 1", "                        dict dbnxt = tk(st)", "                        if dbnxt[type] == \"newline\":", "                            advance(st)", "                        elif dbnxt[type] != \"dedent\":", "                            fail(st, dbnxt, \"SYNTAX_ERROR\", \"end of line\", describe_tok(dbnxt))", "                            return stmts", "                if tk(st)[type] == \"dedent\":", "                    advance(st)", "                if dcount == 0:", "                    fail(st, dbtok, \"SYNTAX_ERROR\", \"declaration inside type block\", \"empty block\")", "                    return stmts", "                decl_block = TRUE", "            elif stmt_is_decl(st):", "                str dty = parse_type_name(st)", "                if NOT (st[err] is NONE):", "                    return stmts", "                dict dname_tok = expect_tok(st, \"name\", \"\", \"variable name\")", "                if NOT (st[err] is NONE):", "                    return stmts", "                node = parse_typed_decl(st, dty, dname_tok)", "                if NOT (st[err] is NONE):", "                    return stmts", "                if exported:", "                    node.add(\"exported\", TRUE)", "                    dict dexp = st[exports]", "                    dexp.add(node[name], \"var\")", "                    st.add(\"exports\", dexp)", "            elif t[type] == \"kw\" AND is_import_kw(t[value]):", "                if st[in_func] OR st[block_depth] > 0:", "                    fail(st, t, \"SYNTAX_ERROR\", \"import at top level\", \"nested import\")", "                    return stmts", "                dict req = parse_import_syntax(st)", "                if NOT (st[err] is NONE):", "                    return stmts", "                str bkey = cat([st[path], \":\", str(req[start])])", "                list impbody = []", "                dict ib = st[import_bodies]", "                if ib.contains(bkey):", "                    impbody = ib.take(bkey)", "                dict itok = req[tok]", "                node = {k: \"import\", body: impbody, line: itok[line], col: itok[col]}", "            elif t[type] == \"kw\" AND t[value] == \"namespace\":", "                if st[in_func] OR st[block_depth] > 0 OR st[ns_prefix] != \"\":", "                    fail(st, t, \"SCOPE_ERROR\", \"namespace at top level\", \"nested namespace\")", "                    return stmts", "                dict ntok = advance(st)", "                dict nnt = expect_tok(st, \"name\", \"\", \"namespace name\")", "                if NOT (st[err] is NONE):", "                    return stmts", "                str nsname = nnt[value]", "                if is_reserved(nsname) OR is_const_name(nsname):", "                    fail(st, nnt, \"NAME_ERROR\", \"free namespace name\", cat([\"reserved '\", nsname, \"'\"]))", "                    return stmts", "                expect_tok(st, \"op\", \":\", \"':'\")", "                if NOT (st[err] is NONE):", "                    return stmts", "                expect_tok(st, \"newline\", \"\", \"end of line after ':'\")", "                expect_tok(st, \"indent\", \"\", \"indented namespace block\")", "                if NOT (st[err] is NONE):", "                    return stmts", "                str oldpref = st[ns_prefix]", "                str oldread = st[ns_read_prefix]", "                st.add(\"ns_prefix\", cat([nsname, \".\"]))", "                st.add(\"ns_read_prefix\", cat([nsname, \".\"]))", "                list nsbody = []", "                bool nsgoing = TRUE", "                while nsgoing AND (st[err] is NONE):", "                    dict nt = tk(st)", "                    if nt[type] == \"dedent\" OR nt[type] == \"eof\":", "                        nsgoing = FALSE", "                    elif nt[type] == \"newline\":", "                        advance(st)", "                    else:", "                        bool nexp = TRUE", "                        dict nn = {}", "                        if stmt_is_decl(st):", "                            str ndty = parse_type_name(st)", "                            if NOT (st[err] is NONE):", "                                break", "                            dict dnnt = expect_tok(st, \"name\", \"\", \"variable name\")", "                            if NOT (st[err] is NONE):", "                                break", "                            nn = parse_typed_decl(st, ndty, dnnt)", "                            if nexp:", "                                nn.add(\"exported\", TRUE)", "                                dict nexp2 = st[exports]", "                                nexp2.add(nn[name], \"var\")", "                                st.add(\"exports\", nexp2)", "                            dict nnxt = tk(st)", "                            if nnxt[type] == \"newline\":", "                                advance(st)", "                            elif nnxt[type] != \"dedent\":", "                                fail(st, nnxt, \"SYNTAX_ERROR\", \"end of line\", describe_tok(nnxt))", "                                break", "                        elif tok_is(tk(st), \"kw\", \"func\"):", "                            dict nprep = prepare_func(st, nexp)", "                            if NOT (st[err] is NONE):", "                                break", "                            begin_func_body(st, nprep)", "                            list nfb = parse_block(st, FALSE)", "                            nn = complete_func(st, nprep, nfb, nexp)", "                        else:", "                            fail(st, tk(st), \"SYNTAX_ERROR\", \"func or declaration inside namespace\", describe_tok(tk(st)))", "                            break", "                        if NOT (st[err] is NONE):", "                            break", "                        nsbody.add(nn)", "                if tk(st)[type] == \"dedent\":", "                    advance(st)", "                st.add(\"ns_prefix\", oldpref)", "                st.add(\"ns_read_prefix\", oldread)", "                if NOT (st[err] is NONE):", "                    return stmts", "                node = {k: \"namespace\", name: nsname, body: nsbody, block_stmt: TRUE, line: ntok[line], col: ntok[col]}", "                block_stmt = TRUE", "            elif t[type] == \"kw\" AND t[value] == \"panic\":", "                node = parse_panic(st)", "                if NOT (st[err] is NONE):", "                    return stmts", "            elif t[type] == \"kw\" AND t[value] == \"if\":", "                dict iftok = advance(st)", "                list branches = []", "                dict cond = parse_expr(st, 0)", "                if NOT (st[err] is NONE):", "                    return stmts", "                check_condition(st, cond, {line: cond[line], col: cond[col]})", "                if NOT (st[err] is NONE):", "                    return stmts", "                expect_tok(st, \"op\", \":\", \"':'\")", "                st.add(\"cond_depth\", st[cond_depth] + 1)", "                list ibody = parse_block(st, FALSE)", "                st.add(\"cond_depth\", st[cond_depth] - 1)", "                branches.add({cond: cond, body: ibody})", "                while tok_is(tk(st), \"kw\", \"elif\"):", "                    advance(st)", "                    dict c2 = parse_expr(st, 0)", "                    if NOT (st[err] is NONE):", "                        return stmts", "                    check_condition(st, c2, {line: c2[line], col: c2[col]})", "                    if NOT (st[err] is NONE):", "                        return stmts", "                    expect_tok(st, \"op\", \":\", \"':'\"