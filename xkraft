#!/bin/sh
# xkraft — запуск компилятора на Kraft: ./xkraft file.kraft
# Новые возможности ядра доступны здесь; ./kraft остаётся эталоном v0.1.
set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Компилятор на Kraft собирается один раз и пересобирается только при изменении
# его исходника или рантайма. Без этого каждый запуск стоил ~100 мс.
cache="$root/xkraft.lua"
if [ ! -f "$cache" ] || [ "$root/xkraft.kraft" -nt "$cache" ] || [ "$root/src/krt.lua" -nt "$cache" ]; then
  "$root/kraft" -c "$root/xkraft.kraft" >/dev/null 2>&1 || exit $?
fi

if [ $# -eq 0 ]; then
  exec luajit "$cache"
fi

case "$1" in
  --version)
    luajit "$cache" --version
    exit $?
    ;;
  -c)
    shift
    luajit "$cache" -c "$@"
    code=$?
    if [ "$code" -eq 0 ] && [ $# -ge 1 ]; then
      case "$1" in
        *.kraft) chmod +x "${1%.kraft}.lua" 2>/dev/null || true ;;
      esac
    fi
    exit "$code"
    ;;
  --tokens|--emit-lua)
    exec luajit "$cache" "$@"
    ;;
esac

src=$1
shift
tmp=$(mktemp "${TMPDIR:-/tmp}/xkraft.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT

luajit "$cache" "$src" > "$tmp"
code=$?
if [ "$code" -ne 0 ]; then
  exit "$code"
fi
luajit "$tmp" "$@"
