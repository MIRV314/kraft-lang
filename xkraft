", "            i += 1", "", "    if len(buf) > 0:", "        parts.add({kind: \"text\", value: buf.join(\"\")})", "    if quoted:", "        return {parts: parts, close: i, err: {msg: \"unclosed string\", col: i + 1}}", "    return {parts: parts, close: i, err: {msg: \"unclosed show template: expected ')'\", col: i + 1}}", "", "# Разбирает одну строку (без отступа). Дописывает токены в tokens.", "func scan_line(str line, flint i, flint lineno, list tokens) -> dict:", "    flint n = len(line)", "    while i < n:", "        str c = line[i]", "", "        if c == \" \" OR c == \"\\t\":", "            i += 1", "        elif c == \"#\":", "            return {err: NONE}", "        elif c == \"\\\"\" OR c == \"'\":", "            dict r = scan_parts(line, i + 1, lineno, TRUE, c)", "            if NOT (r[err] is NONE):", "                dict e = r[err]", "                e.add(\"line\", lineno)", "                return {err: e}", "            tokens.add({type: \"string\", parts: r[parts], line: lineno, col: i + 1})", "            i = r[close] + 1", "        elif is_digit(c):", "            flint j = i", "            while j < n AND is_digit(line[j]):", "                j += 1", "            if char_at(line, j) == \".\" AND char_at(line, j + 1) != \".\":", "                j += 1", "                while j < n AND is_digit(line[j]):", "                    j += 1", "            str raw = line[i..j]", "            tokens.add({type: \"number\", value: flint(raw), raw: raw, line: lineno, col: i + 1})", "            i = j", "        elif is_name_start(c):", "            flint j2 = i + 1", "            while j2 < n AND is_name_char(line[j2]):", "                j2 += 1", "            str word = line[i..j2]", "            flint col = i + 1", "", "            if is_template_func(word):", "                flint k = j2", "                while k < n AND (line[k] == \" \" OR line[k] == \"\\t\"):", "                    k += 1", "                if char_at(line, k) == \"(\":", "                    tokens.add({type: \"name\", value: word, line: lineno, col: col})", "                    tokens.add({type: \"op\", value: \"(\", line: lineno, col: k + 1})", "                    dict r2 = scan_parts(line, k + 1, lineno, FALSE, \"\")", "                    if NOT (r2[err] is NONE):", "                        dict e2 = r2[err]", "                        e2.add(\"line\", lineno)", "                        return {err: e2}", "                    # show() — это шаблон: подстановки пишутся в {}.", "                    # show(f(1)) без скобок {}, судя по всему, забыли подстановку:", "                    # первый ')' закрывает вызов, второй — шаблон.", "                    str tpl_raw = line[k + 1..r2[close]]", "                    if tpl_raw.contains(\"(\") AND char_at(line, r2[close] + 1) == \")\":", "                        # scan_parts останавливается на первой ')' — вложенные", "                        # вызовы надо досчитать самим, чтобы подсказка была", "                        # готовым кодом, который можно просто скопировать.", "                        flint dep = 0", "                        flint q = k + 1", "                        while q < len(line):", "                            str ch = line[q]", "                            if ch == \"(\":", "                                dep += 1", "                            elif ch == \")\":", "                                if dep == 0:", "                                    break", "                                dep -= 1", "                            q += 1", "                        str expr_raw = line[k + 1..q]", "                        str expr = expr_raw.trim()", "                        return {err: {line: lineno, col: k + 2, msg: cat([\"wrap the expression in '\\{\\}': \", word, \"(\\{\", expr, \"\\})\"])}}", "                    tokens.add({type: \"template\", parts: r2[parts], line: lineno, col: k + 2})", "                    tokens.add({type: \"op\", value: \")\", line: lineno, col: r2[close] + 1})", "                    i = r2[close] + 1", "                else:", "                    tokens.add({type: \"name\", value: word, line: lineno, col: col})", "                    i = j2", "            elif is_keyword(word):", "                tokens.add({type: \"kw\", value: word, line: lineno, col: col})", "                i = j2", "            else:", "                tokens.add({type: \"name\", value: word, line: lineno, col: col})", "                i = j2", "        else:", "            str three = line[i..i + 3]", "            str two = line[i..i + 2]", "            if is_op3(three):", "                tokens.add({type: \"op\", value: three, line: lineno, col: i + 1})", "                i += 3", "            elif is_op2(two):", "                tokens.add({type: \"op\", value: two, line: lineno, col: i + 1})", "                i += 2", "            elif is_op1(c):", "                tokens.add({type: \"op\", value: c, line: lineno, col: i + 1})", "                i += 1", "            else:", "                return {err: {msg: cat([\"unexpected character '\", c, \"'\"]), line: lineno, col: i + 1}}", "    return {err: NONE}", "", "# Токенизирует весь файл. Возвращает {tokens, err}.", "func lex(str src, str path) -> dict:", "    list tokens = []", "    list indent_stack = [\"\"]", "    flint lineno = 0", "    bool in_block = FALSE", "    list lines = split_lines(src)", "", "    for raw_line in lines:", "        str line = raw_line", "        lineno += 1", "        str trimmed = line.trim()", "", "        bool skip = FALSE", "        if in_block:", "            if trimmed[..3] == \"---\":", "                in_block = FALSE", "            skip = TRUE", "        elif trimmed[..3] == \"---\":", "            in_block = TRUE", "            skip = TRUE", "        elif trimmed == \"\" OR trimmed[..1] == \"#\":", "            skip = TRUE", "        if NOT skip:", "            flint k = 0", "            flint ln = len(line)", "            while k < ln AND (line[k] == \" \" OR line[k] == \"\\t\"):", "                k += 1", "            str indent = line[..k]", "            if indent.contains(\" \") AND indent.contains(\"\\t\"):", "                return {tokens: tokens, err: {msg: \"mixed tabs and spaces in indentation\", line: lineno, col: 1}}", "", "            str top = indent_stack[len(indent_stack) - 1]", "            if indent != top:", "                if indent[..len(top)] == top:", "                    indent_stack.add(indent)", "                    tokens.add({type: \"indent\", line: lineno, col: 1})", "                else:", "                    while len(indent_stack) > 1 AND indent_stack[len(indent_stack) - 1] != indent:", "                        indent_stack.del(len(indent_stack) - 1)", "                        tokens.add({type: \"dedent\", line: lineno, col: 1})", "                    if indent_stack[len(indent_stack) - 1] != indent:", "                        return {tokens: tokens, err: {msg: \"inconsistent indentation\", line: lineno, col: 1}}", "", "            dict r = scan_line(line, len(indent), lineno, tokens)", "            if NOT (r[err] is NONE):", "                return {tokens: tokens, err: r[err]}", "            tokens.add({type: \"newline\", line: lineno, col: len(line) + 1})", "", "    while len(indent_stack) > 1:", "        indent_stack.del(len(indent_stack) - 1)", "        tokens.add({type: \"dedent\", line: lineno, col: 1})", "    tokens.add({type: \"eof\", line: lineno, col: 1})", "    return {tokens: tokens, err: NONE}", "", "# ---------- отладка: --tokens ----------", "", "func describe_tok(dict t) -> str:", "    list p = []", "    p.add(t[type])", "    p.add(\" \")", "    p.add(str(t[line]))", "    p.add(\":\")", "    p.add(str(t[col]))", "    if t.contains(\"value\"):", "        p.add(\" \")", "        p.add(str(t[value]))", "    if t.contains(\"raw\"):", "        p.add(\" raw=\")", "        p.add(t[raw])", "    if t.contains(\"parts\"):", "        p.add(\" parts=\")", "        p.add(str(t[parts]))", "    return p.join(\"\")", "", "func dump_tokens(list toks):", "    for t in toks:", "        show({describe_tok(t)})", "", "# ---------- парсер: состояние и токены ----------", "", "func token_at(dict st, flint i) -> dict:", "    list ts = st[toks]", "    if len(ts) == 0:", "        return {type: \"eof\", line: 1, col: 1}", "    if i < 0 OR i >= len(ts):", "        return ts[len(ts) - 1]", "    return ts[i]", "", "func tk(dict st) -> dict:", "    return token_at(st, st[pos])", "", "func advance(dict st) -> dict:", "    dict t = tk(st)", "    st.add(\"pos\", st[pos] + 1)", "    return t", "", "func tok_is(dict t, str ty, str val) -> bool:", "    if t[type] != ty:", "        return FALSE", "    if val == \"\":", "        return TRUE", "    return t[value] == val", "", "func peek_value(dict st) -> str:", "    dict n = token_at(st, st[pos] + 1)", "    if n[type] == \"op\":", "        return n[value]", "    return \"\"", "", "func fail(dict st, dict t, str ecat, str expected, str found):", "    if NOT (st[err] is NONE):", "        return:", "    dict e = {cat: ecat, line: 1, col: 1, expected: expected, found: found, path: st[path], source: st[source]}", "    if len(t) > 0:", "        e.add(\"line\", t[line])", "        e.add(\"col\", t[col])", "    st.add(\"err\", e)", "", "func expect_tok(dict st, str ty, str val, str what) -> dict:", "    dict t = tk(st)", "    if NOT tok_is(t, ty, val):", "        fail(st, t, \"SYNTAX_ERROR\", what, describe_tok(t))", "        return {type: \"eof\", value: \"\", line: 1, col: 1}", "    advance(st)", "    return t", "", "# ---------- парсер: типы и имена ----------", "", "func is_type_keyword(str w) -> bool:", "    if w == \"str\" OR w == \"flint\" OR w == \"bool\":", "        return TRUE", "    if w == \"list\" OR w == \"dict\" OR w == \"froz\":", "        return TRUE", "    return FALSE", "", "func is_base_type(str w) -> bool:", "    return w == \"str\" OR w == \"flint\" OR w == \"bool\"", "", "# Имя типа без параметров: \"list[flint,str]\" -> \"list\".", "func base_type(str t) -> str:", "    flint i = 0", "    while i < len(t):", "        if t[i] == \"[\":", "            return t[..i]", "        i += 1", "    return t", "", "func is_typed_spec(str t) -> bool:", "    return t.contains(\"[\")", "", "# Список аргументов без пробелов: \"dict[str,flint]\" -> [\"str\", \"flint\"].", "func type_args(str t) -> list:", "    list out = []", "    flint i = 0", "    while i < len(t):", "        if t[i] == \"[\":", "            str inner = t[i + 1..len(t) - 1]", "            flint start = 0", "            flint depth = 0", "            flint j = 0", "            while j <= len(inner):", "                if j < len(inner) AND inner[j] == \"[\":", "                    depth += 1", "                elif j < len(inner) AND inner[j] == \"]\":", "                    depth -= 1", "                if j == len(inner) OR (inner[j] == \",\" AND depth == 0):", "                    out.add(inner[start..j])", "                    start = j + 1", "                j += 1", "            break", "        i += 1", "    return out", "", "# str / flint / bool / any / list[T,...] / froz[T,...] / dict[K] / dict[K|V].", "func parse_type_spec(dict st) -> str:", "    dict t = tk(st)", "    if t[type] == \"name\" AND t[value] == \"any\":", "        advance(st)", "        return \"any\"", "    if t[type] != \"kw\":", "        fail(st, t, \"TYPE_ERROR\", \"type name\", describe_tok(t))", "        return \"\"", "    str base = t[value]", "    if NOT is_type_keyword(base) OR base == \"NONE\":", "        fail(st, t, \"TYPE_ERROR\", \"type name\", describe_tok(t))", "        return \"\"", "    advance(st)", "    if is_base_type(base) OR NOT tok_is(tk(st), \"op\", \"[\"):", "        return base", "    expect_tok(st, \"op\", \"[\", \"'['\")", "    if NOT (st[err] is NONE):", "        return \"\"", "    list targs = []", "    while TRUE:", "        dict at = tk(st)", "        if at[type] != \"kw\" AND NOT (at[type] == \"name\" AND at[value] == \"any\"):", "            fail(st, at, \"TYPE_ERROR\", \"type name\", describe_tok(at))", "            return \"\"", "        str av = parse_type_spec(st)", "        if NOT (st[err] is NONE):", "            return \"\"", "        targs.add(av)", "        if tok_is(tk(st), \"op\", \",\") OR (base == \"dict\" AND tok_is(tk(st), \"op\", \"|\")):", "            advance(st)", "        else:", "            break", "    expect_tok(st, \"op\", \"]\", \"']'\")", "    if NOT (st[err] is NONE):", "        return \"\"", "    if base == \"dict\":", "        if len(targs) < 1 OR len(targs) > 2:", "            fail(st, t, \"TYPE_ERROR\", \"dict[key] or dict[key|value]\", \"wrong number of type arguments\")", "            return \"\"", "        str dkey = targs[0]", "        if dkey != \"str\" AND dkey != \"flint\":", "            fail(st, t, \"TYPE_ERROR\", \"str or flint dict key\", dkey)", "            return \"\"", "    return cat([base, \"[\", targs.join(\",\"), \"]\"])", "", "func is_numeric(str t) -> bool:", "    return t == \"flint\" OR t == \"NONE\" OR t == \"any\"", "", "func assignable(str from, str to) -> bool:", "    if from == \"str\" AND to == \"flint\":", "        return TRUE", "    if to == \"any\":", "        return TRUE", "    return from == \"NONE\" OR from == \"any\" OR from == to", "", "# Числовая ли строка-литерал. Проверка на компиляции: \"x\" в flint не годится.", "func str_number_literal(str s) -> bool:", "    flint i = 0", "    bool dot = FALSE", "    bool digit = FALSE", "    if len(s) > 0:", "        if s[0] == \"-\":", "            i = 1", "    while i < len(s):", "        str c = s[i]", "        if c == \".\":", "            if dot:", "                return FALSE", "            dot = TRUE", "        elif \"0123456789\".contains(c):", "            digit = TRUE", "        else:", "            return FALSE", "        i += 1", "    return digit", "", "func str_literal_ok(dict e, str target) -> bool:", "    if target != \"flint\" OR e[t] != \"str\" OR e[k] != \"str\":", "        return TRUE", "    list parts = e[parts]", "    str s = \"\"", "    flint i = 0", "    while i < len(parts):", "        dict p = parts[i]", "        if p[kind] != \"text\":", "            return TRUE", "        s = cat([s, p[value]])", "        i += 1", "    return str_number_literal(s)", "", "func coercion_ok(dict e, str target) -> bool:", "    if NOT assignable(e[t], target):", "        return FALSE", "    return str_literal_ok(e, target)", "", "func is_compare(str op) -> bool:", "    return op == \"==\" OR op == \"!=\" OR op == \"<\" OR op == \"<=\" OR op == \">\" OR op == \">=\"", "", "func is_compound(str op) -> bool:", "    if op == \"+=\" OR op == \"-=\" OR op == \"*=\" OR op == \"/=\":", "        return TRUE", "    return op == \"%=\" OR op == \"//=\" OR op == \"**=\"", "", "func is_const_name(str n) -> bool:", "    if len(n) == 0:", "        return FALSE", "    flint i = 0", "    while i < len(n):", "        str c = n[i]", "        if NOT \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\".contains(c):", "            return FALSE", "        i += 1", "    return TRUE", "", "func builtin_arg_ok(str spec, str t) -> bool:", "    if spec == \"any\":", "        return TRUE", "    if t == \"NONE\" OR t == \"any\":", "        return TRUE", "    if t == spec:", "        return TRUE", "    str b = base_type(t)", "    if spec == \"strlistdict\":", "        return b == \"str\" OR b == \"list\" OR b == \"froz\" OR b == \"dict\"", "    if spec == \"listdict\":", "        return b == \"list\" OR b == \"froz\" OR b == \"dict\"", "    return b == spec", "", "func builtin_arg_desc(str spec) -> str:", "    if spec == \"any\":", "        return \"any value\"", "    if spec == \"strlistdict\":", "        return \"str, list, froz, dict\"", "    if spec == \"listdict\":", "        return \"list, froz, dict\"", "    return spec", "", "func builtin_info(str name) -> dict:", "    if name == \"len\":", "        return {ok: TRUE, n: 1, ret: 