азрешается как метод, а отдельная функция `add(...)` — как обычная.", "func is_func_name_free(str name) -> bool:", "    if is_builtin(name) OR name == \"show\" OR name == \"show_err\" OR name == \"input\" OR name == \"Error\":", "        return FALSE", "    if name == \"error\" OR name == \"ANY_ERROR\":", "        return FALSE", "    return TRUE", "", "# Встроенная модель Error: схема известна компилятору, объект создаёт рантайм.", "func error_schema() -> dict:", "    dict fields = {cat: \"str\", msg: \"str\", file: \"str\", line: \"flint\", col: \"flint\"}", "    dict consts = {}", "    consts.add(\"cat\", TRUE)", "    consts.add(\"msg\", TRUE)", "    consts.add(\"file\", TRUE)", "    consts.add(\"line\", TRUE)", "    consts.add(\"col\", TRUE)", "    dict meth = {}", "    meth.add(\"text\", {params: [], ret: \"str\", ret_nullable: FALSE, line: 1, col: 1})", "    return {name: \"Error\", model_fields: {}, field_types: fields, consts: consts, init_fields: {}, params: [], param_types: {}, methods: meth, method_order: [\"text\"], ctor: NONE, order: [], field_order: []}", "", "# Категории, которые рантайм может положить в error.cat.", "func is_error_category(str c) -> bool:", "    if c == \"ANY_ERROR\" OR c == \"ARGCOUNT_ERROR\" OR c == \"ASSERT_ERROR\":", "        return TRUE", "    if c == \"CONST_ERROR\" OR c == \"EXPECT_ERROR\" OR c == \"FILE_ERROR\":", "        return TRUE", "    if c == \"NAME_ERROR\" OR c == \"RUNTIME_ERROR\" OR c == \"TYPE_ERROR\":", "        return TRUE", "    if c == \"TYPE_MISMATCH_ERROR\" OR c == \"VALUE_ERROR\":", "        return TRUE", "    if c == \"PANIC_ERROR\":", "        return TRUE", "    return FALSE", "", "func is_scalar_type(str t) -> bool:", "    return t == \"str\" OR t == \"flint\" OR t == \"bool\"", "", "func is_model_type(dict st, str t) -> bool:", "    dict ms = st[models]", "    return ms.contains(t)", "", "func model_schema(dict st, str t) -> dict:", "    dict ms = st[models]", "    return ms.take(t)", "", "func check_field_name(dict st, dict tok, str nm):", "    if is_reserved(nm):", "        fail(st, tok, \"NAME_ERROR\", \"free field name\", cat([\"reserved '\", nm, \"'\"]))", "        return:", "", "# Регистрирует экземплярное поле в схеме. new=FALSE — поле уже было.", "func add_model_field(dict st, dict m, dict tok, str nm, str fty, bool computed):", "    dict mf = m[model_fields]", "    dict ft = m[field_types]", "    dict cs = m[consts]", "    dict initf = m[init_fields]", "    dict methods = m[methods]", "    if mf.contains(nm) OR ft.contains(nm) OR methods.contains(nm):", "        fail(st, tok, \"REDECLARE_ERROR\", \"unique field/method name\", cat([\"name '\", nm, \"' is already declared\"]))", "        return:", "    ft.add(nm, fty)", "    list fo = m[field_order]", "    fo.add(nm)", "    if is_const_name(nm):", "        cs.add(nm, TRUE)", "    if computed AND NOT is_const_name(nm):", "        initf.add(nm, TRUE)", "", "func parse_type_name(dict st) -> str:", "    dict t = tk(st)", "    if t[type] == \"name\" AND is_model_type(st, t[value]):", "        advance(st)", "        return t[value]", "    if tok_is(t, \"kw\", \"NONE\"):", "        advance(st)", "        return \"NONE\"", "    return parse_type_spec(st)", "", "# Обычная строка без интерполяции: для ключей dict и сообщения panic.", "func plain_string_of(dict st, dict t) -> str:", "    list parts = t[parts]", "    list buf = []", "    for p0 in parts:", "        dict p = p0", "        if p[kind] != \"text\":", "            fail(st, t, \"TYPE_ERROR\", \"plain string\", \"interpolated string\")", "            return \"\"", "        buf.add(p[value])", "    return buf.join(\"\")", "", "func dirname(str p) -> str:", "    flint i = len(p) - 1", "    while i >= 0:", "        if p[i] == \"/\":", "            if i == 0:", "                return \"/\"", "            return p[..i]", "        i -= 1", "    return \".\"", "", "# Соответствует ли литерал параметризованному типу.", "func literal_ok(dict st, dict e, str spec) -> bo