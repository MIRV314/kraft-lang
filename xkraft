#!/bin/sh
# xkraft — запуск компилятора на Kraft: ./xkraft file.kraft
# Новые возможности ядра доступны здесь; ./kraft остаётся эталоном v0.1.
set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ $# -eq 0 ]; then
  exec "$root/kraft" "$root/xkraft.kraft"
fi

case "$1" in
  -c)
    shift
    "$root/kraft" "$root/xkraft.kraft" -c "$@"
    code=$?
    if [ "$code" -eq 0 ] && [ $# -ge 1 ]; then
      case "$1" in
        *.kraft) chmod +x "${1%.kraft}.lua" 2>/dev/null || true ;;
      esac
    fi
    exit "$code"
    ;;
  --tokens|--emit-lua)
    exec "$root/kraft" "$root/xkraft.kraft" "$@"
    ;;
esac

src=$1
shift
tmp=$(mktemp "${TMPDIR:-/tmp}/xkraft.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT

"$root/kraft" "$root/xkraft.kraft" "$src" > "$tmp"
code=$?
if [ "$code" -ne 0 ]; then
  exit "$code"
fi
luajit "$tmp" "$@"
