n {ok: FALSE}", "", "func is_builtin(str name) -> bool:", "    return builtin_info(name)[ok]", "", "func method_info(str base, str name) -> dict:", "    if base == \"str\":", "        if name == \"part\":", "            return {ok: TRUE, min: 0, max: 2, a1: \"str\", a2: \"flint\", rt: \"str_part\", ret: \"list\", nullable: FALSE}", "        if name == \"find\":", "            return {ok: TRUE, min: 1, max: 1, a1: \"str\", a2: \"any\", rt: \"str_find\", ret: \"flint\", nullable: TRUE}", "        if name == \"contains\":", "            return {ok: TRUE, min: 1, max: 1, a1: \"str\", a2: \"any\", rt: \"str_contains\", ret: \"bool\", nullable: FALSE}", "        if name == \"preff\":", "            return {ok: TRUE, min: 1, max: 1, a1: \"str\", a2: \"any\", rt: \"str_preff\", ret: \"bool\", nullable: FALSE}", "        if name == \"suff\":", "            return {ok: TRUE, min: 1, max: 1, a1: \"str\", a2: \"any\", rt: \"str_suff\", ret: \"bool\", nullable: FALSE}", "        if name == \"trim\":", "            return {ok: TRUE, min: 0, max: 1, a1: \"str\", a2: \"any\", rt: \"str_trim\", ret: \"str\", nullable: FALSE}", "        if name == \"triml\":", "            return {ok: TRUE, min: 0, max: 1, a1: \"str\", a2: \"any\", rt: \"str_triml\", ret: \"str\", nullable: FALSE}", "        if name == \"trimr\":", "            return {ok: TRUE, min: 0, max: 1, a1: \"str\", a2: \"any\", rt: \"str_trimr\", ret: \"str\", nullable: FALSE}", "        if name == \"remove\":", "            return {ok: TRUE, min: 1, max: 2, a1: \"str\", a2: \"flint\", rt: \"str_remove\", ret: \"str\", nullable: FALSE}", "        if name == \"replace\":", "            return {ok: TRUE, min: 2, max: 2, a1: \"str\", a2: \"str\", rt: \"str_replace\", ret: \"str\", nullable: FALSE}", "        if name == \"count\":", "            return {ok: TRUE, min: 1, max: 1, a1: \"str\", a2: \"any\", rt: \"str_count\", ret: \"flint\", nullable: FALSE}", "    elif base == \"list\":", "        if name == \"add\":", "          