\"indent\", st[indent] - 1)", "            emit_line(st, \"end\")", "        elif sk == \"while\":", "            st.add(\"loop_id\", st[loop_id] + 1)", "            str lid = str(st[loop_id])", "            str cont = cat([\"__continue_\", lid])", "            str brk = cat([\"__break_\", lid])", "            dict wc2 = s[cond]", "            emit_line(st, cat([\"while krt.truthy(\", emit_expr(st, wc2), \") do\"]))", "            st.add(\"indent\", st[indent] + 1)", "            list ls = st[loop_stack]", "            ls.add({cont: cont, brk: brk})", "            emit_stmts(st, s[body])", "            emit_line(st, cat([\"::\", cont, \"::\"]))", "            ls.del(len(ls) - 1)", "            st.add(\"indent\", st[indent] - 1)", "            emit_line(st, \"end\")", "            emit_line(st, cat([\"::\", brk, \"::\"]))", "        elif sk == \"break\":", "            list lsb = st[loop_stack]", "            dict topb = lsb[len(lsb) - 1]", "            emit_line(st, cat([\"goto \", topb[brk]]))", "        elif sk == \"continue\":", "            list lsc = st[loop_stack]", "            dict topc = lsc[len(lsc) - 1]", "            emit_line(st, cat([\"goto \", topc[cont]]))", "        elif sk == \"for\":", "            st.add(\"loop_id\", st[loop_id] + 1)", "            str fid = str(st[loop_id])", "            str fcont = cat([\"__continue_\", fid])", "            str fbrk = cat([\"__break_\", fid])", "            str fv = s[lua]", "            str fto = cat([\"__to_\", fid])", "            emit_line(st, \"do\")", "            st.add(\"indent\", st[indent] + 1)", "            str form = s[form]", "            if form == \"upto\":", "                emit_line(st, cat([\"local \", fv, \" = 0\"]))", "                dict fte = s[to]", "                emit_line(st, cat([\"local \", fto, \" = \", wrap_flint(emit_expr(st, fte), fte[t], e_nullable(fte))]))", "                emit_line(st, cat([\"while \", fv, \" < \", fto, \" do\"]))", "            else:", "                dict ffe = s[from]", "                dict ftte = s[to]", "                str fstep = cat([\"__step_\", fid])", "                emit_line(st, cat([\"local \", fv, \" = \", wrap_flint(emit_expr(st, ffe), ffe[t], e_nullable(ffe))]))", "                emit_line(st, cat([\"local \", fto, \" = \", wrap_flint(emit_expr(st, ftte), ftte[t], e_nullable(ftte))]))", "                str sx = \"1\"", "                if s.contains(\"step\"):", "                    dict fse = s[step]", "                    sx = wrap_flint(emit_expr(st, fse), fse[t], e_nullable(fse))", "                emit_line(st, cat([\"local \", fstep, \" = \", sx]))", "                emit_line(st, cat([\"while ((\", fstep, \" > 0) and (\", fv, \" < \", fto, \")) or ((\", fstep, \" < 0) and (\", fv, \" > \", fto, \")) do\"]))", "            st.add(\"indent\", st[indent] + 1)", "            list fls = st[loop_stack]", "            fls.add({cont: fcont, brk: fbrk})", "            emit_stmts(st, s[body])", "            emit_line(st, cat([\"::\", fcont, \"::\"]))", "            if form == \"upto\":", "                emit_line(st, cat([fv, \" = \", fv, \" + 1\"]))", "            else:", "                emit_line(st, cat([fv, \" = \", fv, \" + __step_\", fid]))", "            fls.del(len(fls) - 1)", "            st.add(\"indent\", st[indent] - 1)", "            emit_line(st, \"end\")", "            st.add(\"indent\", st[indent] - 1)", "            emit_line(st, \"end\")", "            emit_line(st, cat([\"::\", fbrk, \"::\"]))", "        elif sk == \"for_in\":", "            st.add(\"loop_id\", st[loop_id] + 1)", "            str iid = str(st[loop_id])", "            str icont = cat([\"__continue_\", iid])", "            str ibrk = cat([\"__break_\", iid])", "            str icoll = cat([\"__coll_\", iid])", "            str iidx = cat([\"__i_\", iid])", "            dict ice = s[coll]", "            list inames = s[names]", "            list ilnames = s[lnames]", "            emit_line(st, \"do\")", "      