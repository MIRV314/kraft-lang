return {err: NONE}", "        elif c == \"\\\"\" OR c == \"'\":", "            dict r = scan_parts(line, i + 1, lineno, TRUE, c)", "            if r[err]:", "                dict e = r[err]", "                e.add(\"line\", lineno)", "                return {err: e}", "            tokens.add({type: \"string\", parts: r[parts], line: lineno, col: i + 1})", "            i = r[close] + 1", "        elif is_digit(c):", "            flint j = i", "            while j < n AND is_digit(line[j]):", "                j += 1", "            if char_at(line, j) == \".\" AND char_at(line, j + 1) != \".\":", "                j += 1", "                while j < n AND is_digit(line[j]):", "                    j += 1", "            str raw = line[i..j]", "            tokens.add({type: \"number\", value: flint(raw), raw: raw, line: lineno, col: i + 1})", "            i = j", "        elif is_name_start(c):", "            flint j2 = i + 1", "            while j2 < n AND is_name_char(line[j2]):", "                j2 += 1", "            str word = line[i..j2]", "            flint col = i + 1", "", "            if is_template_func(word):", "                flint k = j2", "                while k < n AND (line[k] == \" \" OR line[k] == \"\\t\"):", "                    k += 1", "                if char_at(line, k) == \"(\":", "                    tokens.add({type: \"name\", value: word, line: lineno, col: col})", "                    tokens.add({type: \"op\", value: \"(\", line: lineno, col: k + 1})", "                    dict r2 = scan_parts(line, k + 1, lineno, FALSE, \"\")", "                    if r2[err]:", "                        dict e2 = r2[err]", "                        e2.add(\"line\", lineno)", "                        return {err: e2}", "                    tokens.add({type: \"template\", parts: r2[parts], line: lineno, col: k + 2})", "                    tokens.add({type: \"op\", value: \")\", line: lineno, col: r2[close] + 1})", "                    i = r2[close] + 1", "                else:", "                    tokens.add({type: \"name\", value: word, line: lineno, col: col})", "                    i = j2", "            elif is_keyword(word):", "                tokens.add({type: \"kw\", value: word, line: lineno, col: col})", "                i = j2", "            else:", "                tokens.add({type: \"name\", value: word, line: lineno, col: col})", "                i = j2", "        else:", "            str three = line[i..i + 3]", "            str two = line[i..i + 2]", "            if is_op3(three):", "                tokens.add({type: \"op\", value: three, line: lineno, col: i + 1})", "                i += 3", "            elif is_op2(two):", "                tokens.add({type: \"op\", value: two, line: lineno, col: i + 1})", "                i += 2", "            elif is_op1(c):", "                tokens.add({type: \"op\", value: c, line: lineno, col: i + 1})", "                i += 1", "            else:", "                return {err: {msg: cat([\"unexpected character '\", c, \"'\"]), line: lineno, col: i + 1}}", "    return {err: NONE}", "", "# Токенизирует весь файл. Возвращает {tokens, err}.", "func lex(str src, str path) -> dict:", "    list tokens = []", "    list indent_stack = [\"\"]", "    flint lineno = 0", "    bool in_block = FALSE", "    list lines = split_lines(src)", "", "    for raw_line in lines:", "        str line = raw_line", "        lineno += 1", "        str trimmed = line.trim()", "", "        bool skip = FALSE", "        if in_block:", "            if trimmed[..3] == \"---\":", "                in_block = FALSE", "            skip = TRUE", "        elif trimmed[..3] == \"---\":", "            in_block = TRUE", "            skip = TRUE", "        elif trimmed == \"\" OR trimmed[..1] == \"#\":", "            skip = TRUE", "        if NOT skip:", "            flint k = 0", "            flint ln = len(line)", "            while k < ln AND (line[k] == \" \" OR line[k] == \"\\t\"):", "                k += 1", "            str indent = line[..k]", "            if indent.contains(\" \") AND indent.contains(\"\\t\"):", "                return {tokens: tokens, err: {msg: \"mixed tabs and spaces in indentation\", line: lineno, col: 1}}", "", "            str top = indent_stack[len(indent_stack) - 1]", "            if indent != top:", "                if indent[..len(top)] == top:", "                    indent_stack.add(indent)", "                    tokens.add({type: \"indent\", line: lineno, col: 1})", "                else:", "                    while len(indent_stack) > 1 AND indent_stack[len(indent_stack) - 1] != indent:", "                        indent_stack.del(len(indent_stack) - 1)", "                        tokens.add({type: \"dedent\", line: lineno, col: 1})", "                    if indent_stack[len(indent_stack) - 1] != indent:", "                        return {tokens: tokens, err: {msg: \"inconsistent indentation\", line: lineno, col: 1}}", "", "            dict r = scan_line(line, len(indent), lineno, tokens)", "            if r[err]:", "                return {tokens: tokens, err: r[err]}", "            tokens.add({type: \"newline\", line: lineno, col: len(line) + 1})", "", "    while len(indent_stack) > 1:", "        indent_stack.del(len(indent_stack) - 1)", "        tokens.add({type: \"dedent\", line: lineno, col: 1})", "    tokens.add({type: \"eof\", line: lineno, col: 1})", "    return {tokens: tokens, err: NONE}", "", "# ---------- отладка: --tokens ----------", "", "func describe_tok(dict t) -> str:", "    list p = []", "    p.add(t[type])", "    p.add(\" \")", "    p.add(str(t[line]))", "    p.add(\":\")", "    p.add(str(t[col]))", "    if t.contains(\"value\"):", "        p.add(\" \")", "        p.add(str(t[value]))", "    if t.contains(\"raw\"):", "        p.add(\" raw=\")", "        p.add(t[raw])", "    if t.contains(\"parts\"):", "        p.add(\" parts=\")", "        p.add(str(t[parts]))", "    return p.join(\"\")", "", "func dump_tokens(list toks):", "    for t in toks:", "        show({describe_tok(t)})", "", "# ---------- парсер: состояние и токены ----------", "", "func token_at(dict st, flint i) -> dict:", "    list ts = st[toks]", "    if len(ts) == 0:", "        return {type: \"eof\", line: 1, col: 1}", "    if i < 0 OR i >= len(ts):", "        return ts[len(ts) - 1]", "    return ts[i]", "", "func tk(dict st) -> dict:", "    return token_at(st, st[pos])", "", "func advance(dict st) -> dict:", "    dict t = tk(st)", "    st.add(\"pos\", st[pos] + 1)", "    return t", "", "func tok_is(dict t, str ty, str val) -> bool:", "    if t[type] != ty:", "        return FALSE", "    if val == \"\":", "        return TRUE", "    return t[value] == val", "", "func peek_value(dict st) -> str:", "    dict n = token_at(st, st[pos] + 1)", "    if n[type] == \"op\":", "        return n[value]", "    return \"\"", "", "func fail(dict st, dict t, str ecat, str expected, str found):", "    if st[err]:", "        return:", "    dict e = {cat: ecat, line: 1, col: 1, expected: expected, found: found, path: st[path]}", "    if len(t) > 0:", "        e.add(\"line\", t[line])", "        e.add(\"col\", t[col])", "    st.add(\"err\", e)", "", "func expect_tok(dict st, str ty, str val, str what) -> dict:", "    dict t = tk(st)", "    if NOT tok_is(t, ty, val):", "        fail(st, t, \"SYNTAX_ERROR\", what, describe_tok(t))", "        return {type: \"eof\", value: \"\", line: 1, col: 1}", "    advance(st)", "    return t", "", "# ---------- парсер: типы и имена ----------", "", "func is_type_keyword(str w) -> bool:", "    return w == \"str\" OR w == \"flint\" OR w == \"bool\" OR w == \"list\" OR w == \"dict\"", "", "func is_numeric(str t) -> bool:", "    return t == \"flint\" OR t == \"NONE\" OR t == \"any\"", "", "func assignable(str from, str to) -> bool:", "    return from == \"NONE\" OR from == \"any\" OR from == to", "", "func is_compare(str op) -> bool:", "    return op == \"==\" OR op == \"!=\" OR op == \"<\" OR op == \"<=\" OR op == \">\" OR op == \">=\"", "", "func is_compound(str op) -> bool:", "    if op == \"+=\" OR op == \"-=\" OR op == \"*=\" OR op == \"/=\":", "        return TRUE", "    return op == \"%=\" OR op == \"//=\" OR op == \"**=\"", "", "func is_const_name(str n) -> bool:", "    if len(n) == 0:", "        return FALSE", "    flint i = 0", "    while i < len(n):", "        str c = n[i]", "        if NOT \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\".contains(c):", "            return FALSE", "        i += 1", "    return TRUE", "", "func builtin_arg_ok(str spec, str t) -> bool:", "    if spec == \"any\":", "        return TRUE", "    if t == \"NONE\" OR t == \"any\":", "        return TRUE", "    if spec == \"strlistdict\":", "        return t == \"str\" OR t == \"list\" OR t == \"dict\"", "    if spec == \"listdict\":", "        return t == \"list\" OR t == \"dict\"", "    return t == spec", "", "func builtin_arg_desc(str spec) -> str:", "    if spec == \"any\":", "        return \"any value\"", "    if spec == \"strlistdict\":", "        return \"str, list, dict\"", "    if spec == \"listdict\":", "        return \"list, dict\"", "    return spec", "", "func builtin_info(str name) -> dict:", "    if name == \"len\":", "        return {ok: TRUE, n: 1, ret: \"flint\", a1: \"strlistdict\"}", "    if name == \"type\":", "        return {ok: TRUE, n: 1, ret: \"str\", a1: \"any\"}", "    if name == \"str\":", "        return {ok: TRUE, n: 1, ret: \"str\", a1: \"any\"}", "    if name == \"flint\":", "        return {ok: TRUE, n: 1, ret: \"flint\", a1: \"any\"}", "    if name == \"up\":", "        return {ok: TRUE, n: 1, ret: \"str\", a1: \"str\"}", "    if name == \"low\":", "        return {ok: TRUE, n: 1, ret: \"str\", a1: \"str\"}", "    if name == \"title\":", "        return {ok: TRUE, n: 1, ret: \"str\", a1: \"str\"}", "    if name == \"abs\":", "        return {ok: TRUE, n: 1, ret: \"flint\", a1: \"flint\"}", "    if name == \"round\":", "        return {ok: TRUE