 внутри функции.", "func top_write_forbidden(dict st, str n) -> bool:", "    dict allg = st[gvars]", "    if NOT allg.contains(n):", "        return FALSE", "    if st[cond_depth] > 0:", "        return TRUE", "    return NOT st[in_func] AND st[loop_depth] == 0", "", "func resolve_write(dict st, dict tok, str n) -> dict:", "    if n == \"error\":", "        fail(st, tok, \"CONST_ERROR\", \"variable\", cat([\"handler variable '\", n, \"' is read-only\"]))", "        return {}", "    dict vars = st[vars]", "    dict gv = st[gvars]", "    if vars.contains(n):", "        if is_const_name(n):", "            fail(st, tok, \"CONST_ERROR\", \"variable\", cat([\"constant '\", n, \"'\"]))", "            return {}", "        if top_write_forbidden(st, n):", "            fail(st, tok, \"TOPLEVEL_ERROR\", \"assignment inside a nested block\", cat([\"assignment to top-level variable '\", n, \"'\"]))", "            return {}", "        dict nm = st[names]", "        return {kind: \"local\", type: vars.take(n), lua: nm.take(n)}", "    if gv.contains(n):", "        if is_const_name(n):", "            fail(st, tok, \"CONST_ERROR\", \"variable\", cat([\"constant '\", n, \"'\"]))", "            return {}", "        if top_write_forbidden(st, n):", "            fail(st, tok, \"TOPLEVEL_ERROR\", \"assignment inside a nested block\", cat([\"assignment to top-level variable '\", n, \"'\"]))", "            return {}", "        dict nm2 = st[names]", "        return {kind: \"global\", type: gv.take(n), lua: nm2.take(n)}", "    fail(st, tok, \"NAME_ERROR\", \"declared variable\", cat([\"name '\", n, \"' is not declared\"]))", "    return {}", "", "# Объявление `имя = выражение` с заданным типом. Общее для обычного", "# объявления и для строки внутри блока типов.", "func parse_typed_decl(dict st, str dty, dict dname_tok) -> dict:", "    str dname = dname_tok[value]", "    if is_reserved(dname):", "        fail(st, dname_tok, \"NAME_ERROR\", \"free name\", cat([\"reserved '\", dname, \"'\"]))", "        return {}", "    dict dvars = st[vars]", "    dict dfuncs = st[funcs]", "    if dvars.contains(dname) OR dfuncs.contains(dname):", "        fail(st, dname_tok, \"REDECLARE_ERROR\", \"unique name\", cat([\"name '\", dname, \"' is already declared\"]))", "        return {}", "    if st[in_func]:", "        dict dg = st[gvars]", "        if dg.contains(dname):", "            fail(st, dname_tok, \"REDECLARE_ERROR\", \"local name\", cat([\"global '\", dname, \"' is already declared\"]))", "            return {}", "    dict dctx = st[model_ctx]", "    if NOT (dctx is NONE):", "        dict dms = dctx[schema]", "        dict dft = dms[field_types]", "        dict dmeth = dms[methods]", "        if dft.contains(dname) OR dmeth.contains(dname):", "            fail(st, dname_tok, \"REDECLARE_ERROR\", \"local name\", cat([\"model member '\", dname, \"'\"]))", "            return {}", "    expect_tok(st, \"op\", \"=\", \"'='\")", "    if st[err]:", "        return {}", "    dict dexpr = {}", "    if is_model_type(st, dty) AND tok_is(tk(st), \"kw\", \"init\"):", "        dict inittok = advance(st)", "        expect_tok(st, \"op\", \"(\", \"'('\")", "        dict ms = model_schema(st, dty)", "        dict cons = ms[ctor]", "        if cons is NONE:", "            fail(st, inittok, \"NAME_ERROR\", cat([\"declared construct of '\", dty, \"'\"]), \"model without construct\")", "            return {}", "        list iparams = cons[params]", "        dict iparm = {}", "        flint ii = 0", "        while ii < len(iparams):", "            dict ipp = iparams[ii]", "            iparm.add(ipp[name], TRUE)", "            ii += 1", "        list iargs = []", "        dict iseen = {}", "        if NOT tok_is(tk(st), \"op\", \")\"):", "            while TRUE:", "                dict iat = expect_tok(st, \"name\", \"\", \"init argument name\")", "                if st[err]:", "                    return {}", "                str ian = iat[value]", "                if iseen.contains(ian):", "                    fail(st, iat, \"REDECLARE_ERROR\", \"unique init argument\", cat([\"duplicate '\", ian, \"'\"]))", "                    return {}", "                iseen.add(ian, TRUE)", "                expect_tok(st, \"op\", \":\", \"':'\")", "                dict iav = parse_expr(st, 0)", "                if st[err]:", "                    return {}", "                bool iok = FALSE", "                str iwant = \"any\"", "                if iparm.contains(ian):", "                    flint ij = 0", "                    while ij < len(iparams):", "                        dict ipj = iparams[ij]", "                        if ipj[name] == ian:", "                            iwant = ipj[type]", "                            iok = TRUE", "                        ij += 1", "                else:", "                    dict iinit = ms[init_fields]", "                    dict ift = ms[field_types]", "                    dict imf = ms[model_fields]", "                    dict icons = ms[consts]", "                    if iinit.contains(ian):", "                        iwant = ift.take(ian)", "                        iok = TRUE", "                    elif imf.contains(ian) OR icons.contains(ian):", "                        fail(st, iat, \"CONST_ERROR\", \"init argument for a mutable field\", cat([\"read-only '\", ian, \"'\"]))", "                        return {}", "                    elif ift.contains(ian):", "                        fail(st, iat, \"CONST_ERROR\", \"init argument for a computed field\", cat([\"field '\", ian, \"' is set from construct parameters\"]))", "                        return {}", "                    else:", "                        fail(st, iat, \"NAME_ERROR\", cat([\"field or construct parameter of '\", dty, \"'\"]), cat([\"unknown '\", ian, \"'\"]))", "                        return {}", "                if NOT assignable(iav[t], iwant):", "                    fail(st, {line: iav[line], col: iav[col]}, \"TYPE_ERROR\", cat([\"init argument '\", ian, \"': type \", iwant]), iav[t])", "                    return {}", "                iargs.add({name: ian, expr: iav, type: iwant})", "                if tok_is(tk(st), \"op\", \",\"):", "                    advance(st)", "                else:", "                    break", "        expect_tok(st, \"op\", \")\", \"')'\")", "        if st[err]:", "            return {}", "        flint mi2 = 0", "        while mi2 < len(iparams):", "            dict ipm = iparams[mi2]", "            str need = ipm[name]", "            if NOT iseen.contains(need):", "                fail(st, inittok, \"ARGCOUNT_ERROR\", cat([\"argument '\", need, \"' in init\"]), \"missing\")", "                return {}", "            mi2 += 1", "        dexpr = {k: \"model_init\", mname: dty, args: iargs, t: dty, line: inittok[line], col: inittok[col]}", "    else:", "        dexpr = parse_expr(st, 0)", "        if st[err]:", "            return {}", "        if NOT assignable(dexpr[t], dty):", "            fail(st, {line: dexpr[line], col: dexpr[col]}, \"TYPE_ERROR\", cat([\"declaration of '\", dname, \"': type \", dty]), dexpr[t])", "            return {}", "    str dlua = mangle_var(st, dname)", "    dvars.add(dname, dty)", "    # Любое объявление вне функции — глобальная («верх файла»).", "    # Переприсвоить её можно только в функции или цикле, не в условии.", "    if NOT st[in_func]:", "        dict dtg = st[gvars]", "        dtg.add(dname, dty)", "    dict dnl = st[nullable]", "    if dexpr[t] == \"NONE\" OR e_nullable(dexpr):", "        dnl.add(dname, TRUE)", "    else:", "        dnl.remove(dname)", "    if st[block_depth] > 0:", "        dict dmu = st[maybe_unset]", "        dmu.add(dname, TRUE)", "    return {k: \"decl\", type: dty, name: dname, lua: dlua, expr: dexpr, line: dname_tok[line], col: dname_tok[col]}", "", "func snapshot_parser(dict st) -> dict:", "    return {vars: st[vars], nullable: st[nullable], maybe_unset: st[maybe_unset], for_names: st[for_names], gvars: st[gvars], gnullable: st[gnullable], gmaybe: st[gmaybe], loop_depth: st[loop_depth], cond_depth: st[cond_depth], try_depth: st[try_depth], try_loop_base: st[try_loop_base], in_func: st[in_func], func_ret: st[func_ret], func_returns: st[func_returns], model_ctx: st[model_ctx]}", "", "func restore_parser(dict st, dict sv):", "    st.add(\"vars\", sv[vars])", "    st.add(\"nullable\", sv[nullable])", "    st.add(\"maybe_unset\", sv[maybe_unset])", "    st.add(\"for_names\", sv[for_names])", "    st.add(\"gvars\", sv[gvars])", "    st.add(\"gnullable\", sv[gnullable])", "    st.add(\"gmaybe\", sv[gmaybe])", "    st.add(\"loop_depth\", sv[loop_depth])", "    st.add(\"cond_depth\", sv[cond_depth])", "    st.add(\"try_depth\", sv[try_depth])", "    st.add(\"try_loop_base\", sv[try_loop_base])", "    st.add(\"in_func\", sv[in_func])", "    st.add(\"func_ret\", sv[func_ret])", "    st.add(\"func_returns\", sv[func_returns])", "    st.add(\"model_ctx\", sv[model_ctx])", "", "# Заголовок модели: поле до construct. Тело не разбирает.", "func parse_model_field_decl(dict st, dict m) -> dict:", "    str mfty = advance(st)[value]", "    dict mfnt = expect_tok(st, \"name\", \"\", \"field name\")", "    if st[err]:", "        return {}", "    str mfname = mfnt[value]", "    check_field_name(st, mfnt, mfname)", "    if st[err]:", "        return {}", "    dict mf = m[model_fields]", "    dict ft = m[field_types]", "    dict meth = m[methods]", "    if mf.contains(mfname) OR ft.contains(mfname) OR meth.contains(mfname):", "        fail(st, mfnt, \"REDECLARE_ERROR\", \"unique field name\", cat([\"name '\", mfname, \"' is already declared\"]))", "        return {}", "    expect_tok(st, \"op\", \"=\", \"'='\")", "    dict sv = st[model_ctx]", "    st.add(\"model_ctx\", NONE)", "    dict mfexpr = parse_expr(st, 0)", "    st.add(\"model_ctx\", sv)", "    if st[err]:", "        return {}", "    if NOT assignable(mfexpr[t], mfty):", "        fail(st, {line: mfexpr[line], col: mfexpr[col]}, \"TYPE_ERROR\", cat([\"field '\", mfname, \"': type \", mfty]), mfexpr[t])", "        return {}", "    mf.add(mfname, mfty)", "    ft.add(mfname, mfty)", "    list mo = m[order]", "    mo.add(mfname)", "    list fo = m[field_order]", "    fo.add(mfname)", "    return {name: mfname, type: mfty, expr: mfexpr, line: mfnt[line], col: mfnt[col]}", "", "# Параметры construct (construct=TRUE) или метода. Скобки уже открыты.", "func parse_model_params(dict st, dict m, bool is_cons) -> list:", "    list out = []", "    if NOT tok_is(tk(st), \"op\", \")\"):", "        while TRUE:", "            dict pty_tok = tk(st)", "            str pty = parse_type_name(st)", "            if st[err]:", "                return out", "            if pty == \"NONE\":", "                fail(st, pty_tok, \"TYPE_ERROR\", \"parameter type\", \"NONE\")", "                return out", "            dict pnt = expect_tok(st, \"name\", \"\", \"parameter name\")", "            if st[err]:", "                return out", "            str pnm = pnt[value]", "            if is_reserved(pnm) OR is_const_name(pnm):", "                fail(st, pnt, \"NAME_ERROR\", \"free parameter name\", cat([\"reserved '\", pnm, \"'\"]))", "                return out", "            dict mf = m[model_fields]", "            dict ft = m[field_types]", "            dict meth = m[methods]", "            if mf.contains(pnm) OR meth.contains(pnm) OR (NOT is_cons AND ft.contains(pnm)):", "                fail(st, pnt, \"REDECLARE_ERROR\", \"parameter name\", cat([\"model member '\", pnm, \"'\"]))", "                return out", "            flint pi = 0", "            while pi < len(out):", "                dict po = out[pi]", "                if po[name] == pnm:", "                    fail(st, pnt, \"REDECLARE_ERROR\", \"unique parameter name\", cat([\"duplicate '\", pnm, \"'\"]))", "                    return out", "                pi += 1", "            out.add({name: pnm, type: pty, line: pnt[line], col: pnt[col]})", "            if tok_is(tk(st), \"op\", \",\"):", "                advance(st)", "            else:", "                break", "    expect_tok(st, \"op\", \")\", \"')'\")", "    return out", "", "func parse_construct_header(dict st, dict m) -> dict:", "    advance(st)", "    expect_tok(st, \"op\", \"(\", \"'('\")", "    list params = parse_model_params(st, m, TRUE)", "    if st[err]:", "        return {}", "    expect_tok(st, \"op\", \":\", \"':'\")", "    if st[err]:", "        return {}", "    m.add(\"ctor\", {params: params, body: []})", "    list mparams = m[params]", "    dict mptypes = m[param_types]", "    for p0 in params:", "        dict p = p0", "        mparams.add(p[name])", "        mptypes.add(p[name], p[type])", "    dict mctx = {model_name: m[name], schema: m, in_construct: TRUE, level: st[block_depth] + 1, self_seen: FALSE, self_done: FALSE, param_set: {}}", "    dict ps = mctx[param_set]", "    for p1 in params:", "        dict p1d = p1", "        ps.add(p1d[name], TRUE)", "    return {params: params, mctx: mctx}", "", "func parse_method_header(dict st, dict m) -> dict:", "    advance(st)", "    dict mtok = expect_tok(st, \"name\", \"\", \"method name\")", "    if st[err]:", "        return {}", "    str mn = mtok[value]", "    if is_reserved(mn) OR is_const_name(mn):", "        fail(st, mtok, \"NAME_ERROR\", \"free method name\", cat([\"reserved '\", mn, \"'\"]))", "        return {}", "    dict mf = m[model_fields]", "    dict ft = m[field_types]", "    dict meth = m[methods]", "    if ft.contains(mn) OR mf.contains(mn) OR meth.contains(mn):", "        fail(st, mtok, \"REDECLARE_ERROR\", \"unique method name\", cat([\"name '\", mn, \"' is already declared\"]))", "        return {}", "    expect_tok(st, \"op\", \"(\", \"'('\")", "    list params = parse_model_params(st, m, FALSE)", "    if st[err]:", "        return {}", "    str mret = \"NONE\"", "    bool mhas = FALSE", "    if tok_is(tk(st), \"op\", \"->\"):", "        advance(st)", "        dict mrt = tk(st)", "        mret = parse_type_name(st)", "        if st[err]:", "            return {}", "        if mret == \"NONE\":", "            fail(st, mrt, \"SYNTAX_ERROR\", \"return type (omit '->' for NONE)\", \"NONE\")", "            return {}", "        mhas = TRUE", "    expect_tok(st, \"op\", \":\", \"':'\")", "    if st[err]:", "        return {}", "    dict info = {params: params, ret: NONE, ret_nullable: FALSE, inferring: TRUE}", "    if mhas:", "        info.add(\"ret\", mret)", "    meth.add(mn, info)", "    list mo = m[method_order]", "    mo.add(mn)", "    return {name: mn, info: info, params: params, ret: mret, has_ret: mhas, line: mtok[line], col: mtok[col]}", "", "func finish_method(dict st, dict info, list body, str declared, bool has_ret, list rets):", "    bool fall = TRUE", "    if len(body) > 0:", "        dict last = body[len(body) - 1]", "        if last[k] == \"return\":", "            fall = FALSE", "    bool nullable = fall", "    str seen = \"\"", "    flint ri = 0", "    while ri < len(rets):", "        dict rr = rets[ri]", "        if rr[empty] OR rr[type] == \"NONE\" OR e_nullable(rr):", "            nullable = TRUE", "        elif has_ret:", "            if rr[type] != declared AND rr[type] != \"any\":", "                fail(st, rr, \"TYPE_ERROR\", cat([\"return type \", declared]), rr[type])", "                return:", "        else:", "            if seen != \"\" AND seen != rr[type]:", "                fail(st, rr, \"TYPE_ERROR\", \"all returns of a method to have one type\", cat([seen, \" and \", rr[type]]))", "                return:", "            seen = rr[type]", "        ri += 1", "    str final = declared", "    if NOT has_ret:", "        final = seen", "        if final == \"\":", "            final = \"NONE\"", "    info.add(\"ret\", final)", "    info.add(\"ret_nullable\", nullable)", "    info.add(\"inferring\", FALSE)", "    info.add(\"body\", body)", "", "# Разбирает блок. top=TRUE — весь файл до eof; top=FALSE — после ':'.", "# Рекурсивна: тела if/while/for/func разбираются ею же.", "func enter_try_zone(dict st, flint old_base):", "    st.add(\"try_depth\", st[try_depth] + 1)", "    flint base = old_base", "    if st[loop_depth] > base:", "        base = st[loop_depth]", "    st.add(\"try_loop_base\", base)", "", "func leave_try_zone(dict st, flint old_base):", "    st.add(\"try_depth\", st[try_depth] - 1)", "    st.add(\"try_loop_base\", old_base)", "", "func try_crosses_loop(dict st) -> bool:", "    return st[try_depth] > 0 AND st[loop_depth] <= st[try_loop_base]", "", "func add_handler_error(dict st) -> dict:", "    dict old_names = st[names]", "    dict old_vars = st[vars]", "    dict old_null = st[nullable]", "    dict old_maybe = st[maybe_unset]", "    bool had_name = old_names.contains(\"error\")", "    bool had_var = old_vars.contains(\"error\")", "    bool had_null = old_null.contains(\"error\")", "    bool had_maybe = old_maybe.contains(\"error\")", "    str prev_name = \"\"", "    str prev_var = \"\"", "    bool prev_null = FALSE", "    bool prev_maybe = FALSE", "    if had_name:", "        prev_name = old_names.take(\"error\")", "    if had_var:", "        prev_var = old_vars.take(\"error\")", "    if had_null:", "        prev_null = old_null.take(\"error\")", "    if had_maybe:", "        prev_maybe = old_maybe.take(\"error\")", "    old_names.add(\"error\", \"error\")", "    old_vars.add(\"error\", \"Error\")", "    return {name: had_name, var: had_var, null: had_null, maybe: had_maybe, prev_name: prev_name, prev_var: prev_var, prev_null: prev_null, prev_maybe: prev_maybe}", "", "func remove_handler_error(dict st, dict sv):", "    dict cur_names = st[names]", "    dict cur_vars = st[vars]", "    dict cur_null = st[nullable]", "    dict cur_maybe = st[maybe_unset]", "    cur_names.remove(\"error\")", "    cur_vars.remove(\"error\")", "    cur_null.remove(\"error\")", "    cur_maybe.remove(\"error\")", "    if sv[name]:", "        cur_names.add(\"error\", sv[prev_name])", "    if sv[var]:", "        cur_vars.add(\"error\", sv[prev_var])", "    if sv[null]:", "        cur_null.add(\"error\", sv[prev_null])", "    if sv[maybe]:", "        cur_maybe.add(\"error\", sv[prev_maybe])", "", "func parse_block(dict st, bool top) -> list:", "    list stmts = []", "    if NOT top:", "        expect_tok(st, \"newline\", \"\", \"end of line after ':'\")", "        expect_tok(st, \"indent\", \"\", \"indented block\")", "        st.add(\"block_depth\", st[block_depth] + 1)", "    bool going = TRUE", "    while going:", "        dict t = tk(st)", "        if st[err]:", "            return stmts", "        bool skip = FALSE", "        if top:", "            if t[type] == \"eof\":", "                going = FALSE", "                skip = TRUE", "            elif t[type] == \"newline\" OR t[type] == \"dedent\":", "                advance(st)", "                skip = TRUE", "            elif t[type] == \"indent\":", "                fail(st, t, \"SYNTAX_ERROR\", \"statement\", \"unexpected indent\")", "                return stmts", "        else:", "            if t[type] == \"dedent\" OR t[type] == \"eof\":", "                going = FALSE", "                skip = TRUE", "            elif t[type] == \"newline\":", "                advance(st)", "                skip = TRUE", "        if going AND NOT skip:", "            dict node = {}", "            bool block_stmt = FALSE", "            bool decl_block = FALSE", "            if stmt_is_decl_block(st):", "                dict dbtok = advance(st)", "                str dbty = dbtok[value]", "                advance(st)", "                expect_tok(st, \"newline\", \"\", \"end of line after ':'\")", "                expect_tok(st, \"indent\", \"\", \"indented block\")", "                if st[err]:", "                    return stmts", "                flint dcount = 0", "                bool dbgoing = TRUE", "                while dbgoing:", "                    dict dbt = tk(st)", "     